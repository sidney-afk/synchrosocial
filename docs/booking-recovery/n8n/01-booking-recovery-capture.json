    {
      "name": "Normalize Lead",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [224, 0],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Body shape from IClosedCapture.astro:\n//   { stage:'started'|'booked'|'disqualified', lead:{...}, attribution:{...},\n//     page:{url,calendar}, client_ts, raw }\n// The browser is an untrusted caller: everything is length-capped and\n// re-derived here, never trusted as-is.\nconst inp = $input.first().json;\nlet body = inp.body;\nif (typeof body === 'string') { try { body = JSON.parse(body); } catch (e) { body = null; } }\nif (!body || typeof body !== 'object') throw new Error('invalid body');\n\nconst stage = String(body.stage || '').trim().toLowerCase();\nif (!['started', 'booked', 'disqualified'].includes(stage)) throw new Error('invalid stage');\n\nconst lead = (body.lead && typeof body.lead === 'object') ? body.lead : {};\nconst attr = (body.attribution && typeof body.attribution === 'object') ? body.attribution : {};\nconst page = (body.page && typeof body.page === 'object') ? body.page : {};\n\nconst cap = (v, n) => String(v == null ? '' : v).trim().slice(0, n);\n\n// Email: lowercase, must look like an address or it is dropped.\nlet email = cap(lead.email, 200).toLowerCase();\nif (!/^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$/.test(email)) email = '';\n\n// Phone -> E.164, assuming NANP when no country code is present. A number we\n// cannot normalise is dropped rather than stored in a shape SMS would reject.\nlet phone = '';\nconst digits = cap(lead.phone, 40).replace(/[^0-9+]/g, '');\nif (digits) {\n  let d = digits.replace(/\\+/g, '');\n  if (digits.startsWith('+')) phone = '+' + d;\n  else if (d.length === 10) phone = '+1' + d;\n  else if (d.length === 11 && d.startsWith('1')) phone = '+' + d;\n}\nif (phone && !/^\\+[1-9][0-9]{7,14}$/.test(phone)) phone = '';\n\n// Names. Split a full name only when first/last were not sent separately.\nlet first = cap(lead.first_name, 80);\nlet last = cap(lead.last_name, 80);\nconst full = cap(lead.full_name, 160);\nif (!first && full) {\n  const parts = full.split(/\\s+/);\n  first = parts.shift() || '';\n  if (!last) last = parts.join(' ');\n}\n\n// Guard against junk in the greeting: 1 char, digits, or an address.\nconst nameOk = first.length >= 2 && !/[0-9@]/.test(first);\nif (!nameOk) first = '';\n// Title-case only the all-lower / all-upper cases; leave McKay and O'Brien.\nif (first && (first === first.toLowerCase() || first === first.toUpperCase())) {\n  first = first.charAt(0).toUpperCase() + first.slice(1).toLowerCase();\n}\n\nif (!email && !phone) throw new Error('no reachable contact info');\n\n// Lead key: email wins so the same person across devices is one row.\nconst leadKey = email || phone;\n\nconst now = new Date();\nconst FOLLOW_UP_DELAY_MIN = 30;\nconst dueAt = new Date(now.getTime() + FOLLOW_UP_DELAY_MIN * 60000);\n\nreturn [{ json: {\n  lead_key: leadKey,\n  stage,\n  email,\n  phone,\n  first_name: first,\n  last_name: last,\n  timezone: cap(lead.timezone, 60),\n  calendar: cap(page.calendar, 80),\n  landing_page: cap(attr.landing_page, 300),\n  utm_source: cap(attr.utm_source, 120),\n  utm_medium: cap(attr.utm_medium, 120),\n  utm_campaign: cap(attr.utm_campaign, 200),\n  utm_content: cap(attr.utm_content, 200),\n  fbclid: cap(attr.fbclid, 300),\n  referrer: cap(attr.referrer, 300),\n  status: stage === 'started' ? 'pending' : 'suppressed',\n  suppressed_reason: stage === 'started' ? '' : stage,\n  follow_up_due_at: stage === 'started' ? dueAt.toISOString() : '',\n  email_sent_at: '',\n  sms_sent_at: '',\n  created_at: now.toISOString(),\n  updated_at: now.toISOString()\n} }];"
      }
    },
