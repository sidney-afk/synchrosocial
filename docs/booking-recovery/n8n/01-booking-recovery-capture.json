        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// iClosed 'Contact by status' / 'New contact created' receiver.\n//\n// AUTH: iClosed does not sign webhooks — HMAC-SHA256 is on their roadmap, not\n// shipped. Without a signature this URL is an unauthenticated PII write to\n// anyone who learns it, so a shared secret is required. Same posture as the\n// existing booking webhooks.\nconst SHARED_SECRET = 'REPLACE_WITH_SHARED_SECRET';\nconst FOLLOW_UP_DELAY_MIN = 30;\n\nconst inp = $input.first().json;\nconst q = inp.query || {};\nconst headers = inp.headers || {};\nconst provided = String(q.secret || headers['x-webhook-secret'] || '');\nif (provided !== SHARED_SECRET) throw new Error('unauthorized');\n\nlet body = inp.body;\nif (typeof body === 'string') { try { body = JSON.parse(body); } catch (e) { body = null; } }\nif (!body || typeof body !== 'object') throw new Error('invalid body');\n\n// The exact field names are UNVERIFIED. iClosed documents the event list but\n// not a payload schema we could confirm remotely, so read defensively across\n// the plausible shapes and keep the raw body — the first real delivery tells\n// us which branch is right, and `raw` is how we find out without guessing\n// twice.\nconst c = body.contact || body.data || body;\nconst cap = (v, n) => String(v == null ? '' : v).trim().slice(0, n);\nconst pick = (...vals) => { for (const v of vals) { const s = cap(v, 300); if (s) return s; } return ''; };\n\nconst contactId = pick(c.id, c.contactId, c.contact_id, c.previewId, body.previewId);\n\nlet email = pick(c.email, c.emailAddress, c.email_address).toLowerCase();\nif (!/^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$/.test(email)) email = '';\n\n// Phone -> E.164, NANP assumed when no country code. Unparseable is dropped\n// rather than stored in a shape Twilio would reject at send time.\nlet phone = '';\nconst rawPhone = pick(c.phone, c.phoneNumber, c.phone_number, c.mobile).replace(/[^0-9+]/g, '');\nif (rawPhone) {\n  const d = rawPhone.replace(/\\+/g, '');\n  if (rawPhone.startsWith('+')) phone = '+' + d;\n  else if (d.length === 10) phone = '+1' + d;\n  else if (d.length === 11 && d.startsWith('1')) phone = '+' + d;\n}\nif (phone && !/^\\+[1-9][0-9]{7,14}$/.test(phone)) phone = '';\n\nlet first = pick(c.firstName, c.first_name, c.givenName);\nlet last = pick(c.lastName, c.last_name, c.familyName);\nconst full = pick(c.name, c.fullName, c.full_name);\nif (!first && full) { const p = full.split(/\\s+/); first = p.shift() || ''; if (!last) last = p.join(' '); }\n\n// Junk-name guard: never render \"Hi 1,\" or \"Hi a@b.com,\".\nif (!(first.length >= 2 && !/[0-9@]/.test(first))) first = '';\nif (first && (first === first.toLowerCase() || first === first.toUpperCase())) {\n  first = first.charAt(0).toUpperCase() + first.slice(1).toLowerCase();\n}\n\nconst status = pick(c.status, body.status, c.contactStatus).toLowerCase();\n\n// A contact with a call attached has booked. iClosed documents latestCall as\n// null until one exists.\nconst latestCall = c.latestCall || c.latest_call || body.latestCall || null;\nconst hasCall = !!(latestCall && typeof latestCall === 'object' && Object.keys(latestCall).length);\n\n// UTMs: these are here because IClosedCapture.astro appends them to the\n// booking URL, so iClosed stores them on the contact and hands them back.\n// That is the whole join between \"which ad\" and \"which lead\".\nconst utm = c.tracking || c.utm || c.utmParams || c.attribution || c || {};\n\nconst isAbandoned = !hasCall && (status === 'potential' || status === 'qualified' || status === '');\nconst reason = hasCall ? 'booked' : (status === 'disqualified' ? 'disqualified' : '');\n\nif (!email && !phone) throw new Error('no reachable contact info');\n\nconst now = new Date();\nconst dueAt = new Date(now.getTime() + FOLLOW_UP_DELAY_MIN * 60000);\n\n// Key on iClosed's contact id when present so repeat visits are one lead.\n// iClosed fires Potential twice when the form takes both phone and email, and\n// retries can redeliver — the upsert downstream makes both harmless.\nconst leadKey = contactId || email || phone;\n\nreturn [{ json: {\n  lead_key: leadKey,\n  iclosed_contact_id: contactId,\n  email,\n  phone,\n  first_name: first,\n  last_name: last,\n  timezone: pick(c.timezone, c.timeZone, c.tz),\n  calendar: pick(c.eventSlug, c.event_slug, c.calendar, body.eventSlug),\n  iclosed_status: status,\n  utm_source: cap(utm.utm_source || utm.utmSource, 120),\n  utm_medium: cap(utm.utm_medium || utm.utmMedium, 120),\n  utm_campaign: cap(utm.utm_campaign || utm.utmCampaign, 200),\n  utm_content: cap(utm.utm_content || utm.utmContent, 200),\n  fbclid: cap(utm.fbclid, 300),\n  referrer: cap(utm.ss_referrer || c.referrer, 300),\n  is_abandoned: isAbandoned,\n  status: isAbandoned ? 'pending' : 'suppressed',\n  suppressed_reason: isAbandoned ? '' : (reason || 'not_abandoned'),\n  follow_up_due_at: isAbandoned ? dueAt.toISOString() : '',\n  email_sent_at: '',\n  sms_sent_at: '',\n  raw: JSON.stringify(body).slice(0, 4000),\n  created_at: now.toISOString(),\n  updated_at: now.toISOString()\n} }];"
