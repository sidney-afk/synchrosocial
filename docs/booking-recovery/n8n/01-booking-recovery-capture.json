    {
      "name": "Arm or Touch?",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        -256
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// A lead is armed ONCE. After that, repeat abandonment events only refresh\n// their details — they never reset the clock and never re-send.\n//\n// This matters more than it looks: iClosed fires Potential twice per lead when\n// the form takes both phone and email, retries redeliver the same event, and a\n// real person can come back and abandon again next week. Arming on every\n// delivery would send E1 several times to the same person, which reads as\n// broken software rather than a helpful nudge.\n//\n// Output 0 = arm (genuinely new). Output 1 = touch only (already known).\nconst fresh = $('Authenticate + Normalize').first().json;\nconst existing = $input.all().map(i => i.json).filter(j => j && j.lead_key);\n\nif (!existing.length) return [[fresh], []];\n\nconst row = existing[0];\nconst alreadySent = !!String(row.email_sent_at || '').trim()\n                 || !!String(row.sms_sent_at || '').trim();\nconst alreadyClosed = String(row.status || '') === 'suppressed'\n                   || String(row.status || '') === 'completed';\n\nif (alreadySent || alreadyClosed) {\n  return [[], [{ json: { ...fresh, status: row.status, suppressed_reason: row.suppressed_reason || '' } }]];\n}\n\n// Known but still pending: leave follow_up_due_at exactly as it was so the\n// original wait window keeps running.\nreturn [[], [{ json: { ...fresh, status: 'pending', follow_up_due_at: row.follow_up_due_at } }]];"
      }
    },
