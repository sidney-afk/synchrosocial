---
// Meta Pixel — loaded in <head> by Layout.astro on every page.
//
// The pixel ID is the Events Manager dataset "Synchro Social Data"
// (business portfolio "Synchro Social", ID 895720379894...). Base code fires
// PageView automatically on every page load.
//
// Pages can fire ONE additional funnel event by passing `event` through
// Layout (e.g. /thank-you fires the booked-call conversion). Every event is
// sent with a random eventID so the same event can later be re-sent through
// the Conversions API and deduplicated by Meta (event name + eventID pair).
// The eventID is also kept in sessionStorage so a future CAPI relay could
// pick it up from the browser if we ever forward events client-side.
//
// See docs/meta-ads/ for the full tracking architecture.
export const META_PIXEL_ID = "4309835332571875";

interface Props {
  /** Optional standard event to fire after PageView, e.g. "Schedule". */
  event?: string;
  /** Optional params for the event (content_name etc.). */
  params?: Record<string, string | number>;
}
const { event = null, params = {} } = Astro.props;
---

<script
  is:inline
  define:vars={{ pixelId: META_PIXEL_ID, evt: event, evtParams: params }}
>
  /* TEST TRAFFIC NEVER REACHES META. A visit is a test when utm_source is the
     word "test" (test, test1, my-test ...) or it was flagged earlier in this
     browser session. The flag is kept in sessionStorage so a test visit stays
     a test on the next page it reaches (the iClosed redirect, for one).
     For a test we install a do-nothing fbq and never load Meta's script, so
     no PageView, Lead or any other event leaves the browser. The /doctors form
     also calls window.__metaIsTestEmail() on submit to cover the second signal,
     a sidney.laruel+anything@gmail.com address. Keep the two patterns in step
     with the "Sales - Booked Call to Meta CAPI" n8n workflow. */
  var TEST_SOURCE = /(^|[^a-z0-9])test([^a-z0-9]|$)/i;
  var TEST_EMAIL = /^sidney\.laruel\+[^@\s]+@gmail\.com$/i;
  var isTestVisit = false;
  try {
    isTestVisit = TEST_SOURCE.test(new URLSearchParams(location.search).get("utm_source") || "");
  } catch (e) {}
  try {
    if (isTestVisit) sessionStorage.setItem("mp_test_visit", "1");
    else if (sessionStorage.getItem("mp_test_visit") === "1") isTestVisit = true;
  } catch (e) {}
  window.__metaIsTest = function () { return isTestVisit; };
  window.__metaIsTestEmail = function (email) { return TEST_EMAIL.test(String(email || "").trim()); };

  /* Meta Pixel base code (official snippet). */
  if (isTestVisit) {
    window.fbq = function () {};
  } else {
  (function (f, b, e, v, n, t, s) {
    if (f.fbq) return;
    n = f.fbq = function () {
      n.callMethod ? n.callMethod.apply(n, arguments) : n.queue.push(arguments);
    };
    if (!f._fbq) f._fbq = n;
    n.push = n;
    n.loaded = !0;
    n.version = "2.0";
    n.queue = [];
    t = b.createElement(e);
    t.async = !0;
    t.src = v;
    s = b.getElementsByTagName(e)[0];
    s.parentNode.insertBefore(t, s);
  })(window, document, "script", "https://connect.facebook.net/en_US/fbevents.js");
  }

  fbq("init", pixelId);
  fbq("track", "PageView");

  if (evt && !isTestVisit) {
    // Random UUID as eventID → lets a server-side Conversions API resend the
    // same event without double counting (Meta dedupes on event name + ID).
    var eventID =
      window.crypto && crypto.randomUUID
        ? crypto.randomUUID()
        : String(Date.now()) + "-" + Math.random().toString(36).slice(2);
    fbq("track", evt, evtParams, { eventID: eventID });
    try {
      sessionStorage.setItem("mp_last_event", JSON.stringify({ evt, eventID }));
    } catch (e) {}
  }
</script>

<noscript>
  <img
    height="1"
    width="1"
    style="display:none"
    src={`https://www.facebook.com/tr?id=${META_PIXEL_ID}&ev=PageView&noscript=1`}
    alt=""
  />
</noscript>
