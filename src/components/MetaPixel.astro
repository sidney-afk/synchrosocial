---
// Meta Pixel — loaded in <head> by Layout.astro on every page.
//
// The pixel ID is the Events Manager dataset "Synchro Social Data"
// (business portfolio "Synchro Social", ID 895720379894...).
//
// What this component does (see docs/meta-ads/README.md §4 for the event map):
//   1. Skips Meta entirely for visits that must never count (test traffic,
//      utm_source=referral, utm_source=outbound_dm).
//   2. Makes sure the click id (fbc) and browser id (fbp) exist BEFORE the
//      first event, so PageView and ViewContent carry them too. fbc is built
//      from ?fbclid= when the _fbc cookie is missing (Meta's format
//      fb.1.<ms>.<fbclid>) and kept for the visit.
//   3. Sends PageView, and the page's one optional funnel event, through
//      window.__metaTrack: the browser event gets an eventID, and the same
//      event (same eventID, full page URL, fbc, fbp) is mirrored to our
//      server relay for the Conversions API, so Meta deduplicates the pair.
//      The relay is switched off while CAPI_RELAY_URL is empty.
//
// Pages can fire ONE additional funnel event by passing `event` through
// Layout (e.g. /apply fires ViewContent).
export const META_PIXEL_ID = "4309835332571875";

// Server mirror (Conversions API) for page views and early events. Empty = off:
// browser events still fire exactly the same. To switch on, deploy
// docs/edge-functions/meta-capi-relay/ and paste its URL here (steps in that
// folder's README). Never put a token here: the token lives only in the
// edge function's secrets. (The PUBLIC_META_CAPI_RELAY_URL build variable
// overrides it; the scripted browser check uses that with a fake address.)
// To switch on: paste the relay URL between the last pair of quotes.
export const CAPI_RELAY_URL = import.meta.env.PUBLIC_META_CAPI_RELAY_URL || "";

interface Props {
  /** Optional standard event to fire after PageView, e.g. "ViewContent". */
  event?: string;
  /** Optional params for the event (content_name etc.). */
  params?: Record<string, string | number>;
}
const { event = null, params = {} } = Astro.props;
---

<script
  is:inline
  define:vars={{ pixelId: META_PIXEL_ID, relayUrl: CAPI_RELAY_URL, evt: event, evtParams: params }}
>
  /* VISITS THAT NEVER REACH META. A visit is skipped when utm_source is
     - the word "test" (test, test1, my-test ..., but not "latest"), or
     - exactly "referral" or "outbound_dm" (our own referral and DM links:
       not ad traffic, and they would teach Meta the wrong people), or
     it was flagged earlier in this browser session. The flag is kept in
     sessionStorage so a skipped visit stays skipped on the next page it
     reaches (the iClosed redirect, for one). For these visits we install a
     do-nothing fbq and never load Meta's script, so no event of any kind
     leaves the browser. The /doctors form also calls window.__metaIsTestEmail()
     to cover a sidney.laruel+anything@gmail.com address. Keep these patterns
     in step with the "Sales - Booked Call to Meta CAPI" n8n workflow. */
  var TEST_SOURCE = /(^|[^a-z0-9])test([^a-z0-9]|$)/i;
  var EXCLUDED_SOURCE = /^(referral|outbound_dm)$/i;
  var TEST_EMAIL = /^sidney\.laruel\+[^@\s]+@gmail\.com$/i;
  var qs;
  try { qs = new URLSearchParams(location.search); } catch (e) { qs = { get: function () { return null; } }; }
  var isTestVisit = false;
  var utmSource = String(qs.get("utm_source") || "").trim();
  isTestVisit = TEST_SOURCE.test(utmSource) || EXCLUDED_SOURCE.test(utmSource);
  try {
    if (isTestVisit) sessionStorage.setItem("mp_test_visit", "1");
    else if (sessionStorage.getItem("mp_test_visit") === "1") isTestVisit = true;
  } catch (e) {}
  window.__metaIsTest = function () { return isTestVisit; };
  window.__metaIsTestEmail = function (email) { return TEST_EMAIL.test(String(email || "").trim()); };

  /* CLICK ID (fbc) AND BROWSER ID (fbp), set before the first event.
     Meta's script writes these cookies itself, but only after it has loaded,
     and it can miss the click id when the landing URL is changed by a
     redirect. Writing them first means the very first PageView already has
     both, and the server mirror sends the exact same values. */
  function readCookie(name) {
    var m = document.cookie.match(new RegExp("(?:^|; )" + name + "=([^;]*)"));
    return m ? decodeURIComponent(m[1]) : "";
  }
  function writeCookie(name, value) {
    var host = location.hostname.replace(/^www\./, "");
    var domain = /\./.test(host) && !/^[\d.]+$/.test(host) ? ";domain=." + host : "";
    document.cookie = name + "=" + value + ";max-age=" + 90 * 86400 + ";path=/" + domain +
      ";SameSite=Lax" + (location.protocol === "https:" ? ";Secure" : "");
  }
  var fbc = "", fbp = "";
  if (!isTestVisit) {
    try {
      var fbclid = String(qs.get("fbclid") || "").trim();
      fbc = readCookie("_fbc");
      // A new ad click (fbclid differs from the stored one) replaces the old click id.
      if (fbclid && fbc.split(".").slice(3).join(".") !== fbclid) {
        fbc = "fb.1." + Date.now() + "." + fbclid;
        writeCookie("_fbc", fbc);
      }
      if (!fbc) { try { fbc = sessionStorage.getItem("mp_fbc") || ""; } catch (e) {} }
      if (fbc) { try { sessionStorage.setItem("mp_fbc", fbc); } catch (e) {} }
      fbp = readCookie("_fbp");
      if (!fbp) {
        fbp = "fb.1." + Date.now() + "." + Math.floor(1e9 + Math.random() * 9e9);
        writeCookie("_fbp", fbp);
      }
    } catch (e) {}
  }
  window.__metaIds = function () { return { fbc: fbc, fbp: fbp }; };

  /* Meta Pixel base code (official snippet). */
  if (isTestVisit) {
    window.fbq = function () {};
  } else {
  (function (f, b, e, v, n, t, s) {
    if (f.fbq) return;
    n = f.fbq = function () {
      n.callMethod ? n.callMethod.apply(n, arguments) : n.queue.push(arguments);
    };
    if (!f._fbq) f._fbq = n;
    n.push = n;
    n.loaded = !0;
    n.version = "2.0";
    n.queue = [];
    t = b.createElement(e);
    t.async = !0;
    t.src = v;
    s = b.getElementsByTagName(e)[0];
    s.parentNode.insertBefore(t, s);
  })(window, document, "script", "https://connect.facebook.net/en_US/fbevents.js");
  }

  /* The page URL as sent to the server: full path and query, minus anything
     that could be a person's details (iClosed appends them on some redirects). */
  function pageUrl() {
    try {
      var u = new URL(location.href);
      ["iclosedEmail", "iclosedPhone", "iclosedName", "email", "phone", "name"].forEach(function (k) {
        u.searchParams.delete(k);
      });
      u.hash = "";
      return u.toString();
    } catch (e) { return location.href.split("#")[0]; }
  }
  function newEventId() {
    return window.crypto && crypto.randomUUID
      ? crypto.randomUUID()
      : String(Date.now()) + "-" + Math.random().toString(36).slice(2);
  }

  /* ONE WAY TO SEND AN EVENT: window.__metaTrack(name, params, opts)
       opts.custom  true for a custom event (trackCustom)
       opts.eventID reuse an id (dedup with an earlier fire); else a fresh one
       opts.server  false to keep it browser-only
     Returns the eventID, or null for a skipped visit. The browser event and
     its server copy share the eventID, so Meta counts it once. */
  window.__metaTrack = function (name, params, opts) {
    opts = opts || {};
    if (isTestVisit) return null;
    var eventID = opts.eventID || newEventId();
    fbq(opts.custom ? "trackCustom" : "track", name, params || {}, { eventID: eventID });
    if (relayUrl && opts.server !== false) {
      try {
        var body = {
          event_name: name,
          event_id: eventID,
          event_time: Math.floor(Date.now() / 1000),
          event_source_url: pageUrl(),
          custom_data: params || {},
        };
        if (fbc) body.fbc = fbc;
        if (fbp) body.fbp = fbp;
        fetch(relayUrl, {
          method: "POST",
          keepalive: true,
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(body),
        }).catch(function () {});
      } catch (e) {}
    }
    return eventID;
  };

  fbq("init", pixelId);
  window.__metaTrack("PageView");

  if (evt && !isTestVisit) {
    var eventID = window.__metaTrack(evt, evtParams);
    try {
      sessionStorage.setItem("mp_last_event", JSON.stringify({ evt, eventID }));
    } catch (e) {}
  }
</script>

<noscript>
  <img
    height="1"
    width="1"
    style="display:none"
    src={`https://www.facebook.com/tr?id=${META_PIXEL_ID}&ev=PageView&noscript=1`}
    alt=""
  />
</noscript>
