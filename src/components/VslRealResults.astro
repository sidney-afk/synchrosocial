---
/* ===========================================================================
   VslRealResults — the reference funnel's case-study card grid, in purple.

   Card geometry transcribed verbatim: #121212 fill, 16px radius, 26/26/24
   padding, 16px flex gap, title clamp(19px,2.2vw,22px)/700, stat
   clamp(24px,2.6vw,28px)/700 in the accent gradient, 13px/600 tag, 14.5px
   story at 80% ink, then the 12px-radius video with the 62px white play
   button. Two columns at 1200px, one below 900px.

   Two deliberate departures from the reference:
     - the "View Instagram" / "Watch on YouTube" link row is dropped (the
       owner asked for the cards without it), so .card-links has no analogue.
     - videos are our own Wistia embeds behind a poster facade rather than
       YouTube thumbnails; the facade swaps in the iframe on click exactly
       like CampaignProofGrid, so nothing third-party loads until asked.
=========================================================================== */
interface Card {
  name: string;
  stat: string;
  tag: string;
  story: string;
  wistia: string;
  poster: string;
}
interface Props {
  eyebrow?: string;
  heading: string;
  intro?: string;
  cards: Card[];
  disclaimer?: string;
  /** 1 (default) stacks the cards one after another, which is how the reference
   *  funnel actually renders. 2 opts into the two-up grid — used by
   *  /success-stories, where nine cards stacked would be an enormous scroll. */
  columns?: 1 | 2;
}
const {
  eyebrow = "Real Results",
  heading,
  intro,
  cards,
  disclaimer = "These are real outcomes from clients who followed our process as built. Growth depends on execution and platform algorithms, results will vary by effort and market.",
  columns = 1,
} = Astro.props;
---

<section class="vslrr" id="results">
  <div class="vslrr__head">
    <div class="vslrr__eyebrow">{eyebrow}</div>
    <h2>{heading}</h2>
    {intro && <p>{intro}</p>}
  </div>

  <div class:list={["vslrr__grid", { "vslrr__grid--two": columns === 2 }]}>
    {
      cards.map((c) => (
        <div class="vslrr__card">
          <div class="vslrr__card-title">{c.name}</div>
          <div class="vslrr__stat-row">
            <div class="vslrr__stat">{c.stat}</div>
          </div>
          <div class="vslrr__tag">{c.tag}</div>
          <p class="vslrr__story">{c.story}</p>
          <div class="vslrr__vsl-wrap">
            <div class="vslrr__vsl">
              <button
                type="button"
                class="vslrr__facade"
                data-player-src={`https://fast.wistia.net/embed/iframe/${c.wistia}?seo=false&videoFoam=false&autoPlay=true`}
                aria-label={`Play ${c.name} case study video`}
              >
                <img
                  class="vslrr__thumb"
                  src={c.poster}
                  alt={`${c.name} case study video thumbnail`}
                  loading="lazy"
                  width="640"
                  height="360"
                />
                <span class="vslrr__play" aria-hidden="true">
                  <svg viewBox="0 0 24 24"><path d="M7 5v14l12-7z" /></svg>
                </span>
              </button>
            </div>
          </div>
        </div>
      ))
    }
  </div>

  {disclaimer && <p class="vslrr__disclaimer">{disclaimer}</p>}
</section>

<script>
  document.querySelectorAll<HTMLButtonElement>(".vslrr__facade").forEach((el) => {
    if (el.dataset.bound === "true") return;
    el.dataset.bound = "true";
    el.addEventListener("click", () => {
      const src = el.dataset.playerSrc;
      if (!src || el.classList.contains("is-loaded")) return;
      const iframe = document.createElement("iframe");
      iframe.src = src;
      iframe.title = el.getAttribute("aria-label") || "Case study video";
      iframe.loading = "lazy";
      iframe.allow = "autoplay; fullscreen; picture-in-picture";
      iframe.setAttribute("allowfullscreen", "");
      el.appendChild(iframe);
      el.classList.add("is-loaded");
    });
  });
</script>

<style>
  .vslrr {
    position: relative;
    width: 100%;
    /* Reference is 72px on top. Trimmed to 56px because the proof tiles the
       owner added sit directly above this section — 72 + the hero's own bottom
       padding read as dead space. Sides/bottom stay reference-exact. */
    padding: 56px 20px 90px;
    background: var(--vsl-black);
  }

  .vslrr__head {
    max-width: 720px;
    margin: 0 auto 48px;
    text-align: center;
  }

  .vslrr__eyebrow {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--vsl-p);
    margin-bottom: 16px;
  }

  .vslrr__head h2 {
    font-size: clamp(26px, 4vw, 38px);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.16;
    margin-bottom: 16px;
    color: var(--vsl-ink);
  }

  .vslrr__head p {
    font-size: 16px;
    color: var(--vsl-ink-dim);
    line-height: 1.6;
    /* Reference is 52ch, which set this intro in 4 lines with a one-word widow
       ("personally."). Widened to 68ch so it breaks to 3 balanced lines. */
    max-width: 68ch;
    margin: 0 auto;
  }

  /* The reference's stylesheet declares a two-column grid, but that rule is
     dead code on the real page: Perspective caps the funnel's content column at
     896px, just under the rule's own 900px breakpoint, so the single-column
     branch always wins and the cards render one after another at 856px wide.
     Measured on the live reference at both 1440 and 1920 — it never goes
     two-up. We match what it RENDERS, not what it declares. */
  .vslrr__grid {
    max-width: 856px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: 18px;
  }

  /* columns={2} — the denser roster layout, used only by /success-stories. */
  .vslrr__grid--two {
    max-width: 1200px;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
  }

  /* An odd card count leaves the last one alone in its row, hugging the left
     column. Span it across both tracks and centre it at one column's width so
     it reads as deliberate. calc(50% - 12px) is one track (half the grid minus
     half the 24px gap) at any container width. */
  .vslrr__grid--two > :last-child:nth-child(odd) {
    grid-column: 1 / -1;
    justify-self: center;
    width: calc(50% - 12px);
  }

  .vslrr__disclaimer {
    max-width: 620px;
    margin: 40px auto 0;
    text-align: center;
    font-size: 13px;
    line-height: 1.6;
    color: rgba(244, 241, 250, 0.58);
  }

  .vslrr__card {
    background: var(--vsl-card);
    border: 1px solid var(--vsl-card-border);
    border-radius: 16px;
    padding: 26px 26px 24px;
    text-align: left;
    display: flex;
    flex-direction: column;
    gap: 16px;
    transition: border-color 0.22s ease, background 0.22s ease;
  }

  .vslrr__card:hover {
    border-color: rgba(154, 93, 255, 0.36);
    background: #16131b;
  }

  .vslrr__card-title {
    font-size: clamp(19px, 2.2vw, 22px);
    font-weight: 700;
    letter-spacing: -0.015em;
    line-height: 1.28;
    color: var(--vsl-ink);
  }

  .vslrr__stat-row {
    display: flex;
    align-items: baseline;
    gap: 10px;
    flex-wrap: wrap;
  }

  .vslrr__stat {
    font-size: clamp(24px, 2.6vw, 28px);
    font-weight: 700;
    letter-spacing: -0.015em;
    background: var(--vsl-accent-grad);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    line-height: 1.15;
  }

  .vslrr__tag {
    font-size: 13px;
    font-weight: 600;
    color: var(--vsl-p);
  }

  .vslrr__story {
    font-size: 14.5px;
    color: rgba(244, 241, 250, 0.8);
    line-height: 1.6;
    margin: 0;
  }

  /* ---------- Video facade with white play button ---------- */
  .vslrr__vsl-wrap {
    position: relative;
    width: 100%;
  }

  .vslrr__vsl {
    position: relative;
    width: 100%;
    border-radius: 12px;
    overflow: hidden;
    background: #000;
    border: 1px solid var(--vsl-card-border);
  }

  .vslrr__facade {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    border: none;
    padding: 0;
    margin: 0;
    cursor: pointer;
    background: #000;
    overflow: hidden;
    font-family: inherit;
  }

  @supports not (aspect-ratio: 16 / 9) {
    .vslrr__facade {
      height: 0;
      padding-top: 56.25%;
    }
  }

  .vslrr__thumb {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease, filter 0.3s ease;
  }

  .vslrr__facade:hover .vslrr__thumb {
    transform: scale(1.035);
    filter: brightness(1.06);
  }

  .vslrr__play {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 62px;
    height: 62px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.96);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.2s ease, background 0.2s ease, box-shadow 0.25s ease;
    box-shadow: 0 10px 26px rgba(0, 0, 0, 0.5);
  }

  .vslrr__play svg {
    width: 24px;
    height: 24px;
    fill: #0a0a0a;
    margin-left: 3px;
  }

  .vslrr__facade:hover .vslrr__play {
    transform: translate(-50%, -50%) scale(1.07);
    background: #fff;
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.6), 0 0 0 6px rgba(154, 93, 255, 0.15);
  }

  .vslrr__facade:focus-visible {
    outline: 2px solid var(--vsl-p-light);
    outline-offset: 3px;
  }

  .vslrr__facade.is-loaded {
    cursor: default;
  }

  .vslrr__facade.is-loaded .vslrr__thumb,
  .vslrr__facade.is-loaded .vslrr__play {
    display: none;
  }

  .vslrr__facade :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }

  @media (max-width: 900px) {
    .vslrr__grid--two {
      grid-template-columns: 1fr;
      gap: 18px;
    }

    /* Single column below 900px — the lone-card centring above would otherwise
       shrink the last card to half width. */
    .vslrr__grid--two > :last-child:nth-child(odd) {
      grid-column: auto;
      width: 100%;
    }
  }

  @media (max-width: 600px) {
    .vslrr {
      padding: 32px 14px 52px;
    }
    .vslrr__head {
      margin-bottom: 32px;
    }
    .vslrr__head h2 {
      font-size: clamp(22px, 6.5vw, 28px);
    }
    .vslrr__head p {
      font-size: 14.5px;
    }
    .vslrr__card {
      padding: 20px 18px 20px;
      border-radius: 14px;
    }
    .vslrr__stat {
      font-size: 22px;
    }
    .vslrr__story {
      font-size: 13.5px;
    }
    .vslrr__play {
      width: 52px;
      height: 52px;
    }
    .vslrr__play svg {
      width: 20px;
      height: 20px;
    }
  }
</style>
