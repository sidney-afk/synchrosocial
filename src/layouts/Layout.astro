---
import "../styles/global.css";
import MetaPixel from "../components/MetaPixel.astro";
import { GLASSDOOR_URL } from "../data/org.js";
import { LINKEDIN, INSTAGRAM } from "../data/studio.js";

interface Props {
  title?: string;
  description?: string;
  /** Background color class for the page body wrapper. */
  bodyClass?: string;
  /** Extra Meta Pixel event to fire on this page (besides PageView),
      e.g. { name: "Schedule" } on /thank-you. See docs/meta-ads/. */
  metaEvent?: { name: string; params?: Record<string, string | number> };
  /** Skip the render-blocking Google Fonts stylesheet (Poppins + Outfit) and the
      Caveat preload. For pages that only use the self-hosted Inter, e.g. /doctors. */
  lightFonts?: boolean;
  /** Hide the page from search engines (test pages such as /doctors-who-teach). */
  noindex?: boolean;
  tabIcon?: string;
}

const {
  title = "Synchro Social — Social media growth for coaches & thought leaders",
  description = "We help impact-driven coaches and thought leaders share their journey on social media. Grow exceptionally, but with intention.",
  bodyClass = "bg-white",
  metaEvent = null,
  lightFonts = false,
  noindex = false,
  tabIcon = "/images/logo.png",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href={tabIcon} />
    <meta name="generator" content={Astro.generator} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="facebook-domain-verification" content="dblhsbm0xnlcnxb395nwdz9q4gvabc" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <link rel="preload" href="/fonts/inter-tight-700.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-700.woff2" as="font" type="font/woff2" crossorigin />
    {!lightFonts && <link rel="preload" href="/fonts/caveat-700.woff2" as="font" type="font/woff2" crossorigin />}

    <!-- Open Graph / social preview -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Synchro Social" />
    <meta property="og:image" content="https://synchrosocial.com/images/synchro-social-share.png" />
    <meta name="twitter:image" content="https://synchrosocial.com/images/synchro-social-share.png" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {Astro.site && <meta property="og:url" content={Astro.site} />}
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Inter / Inter Tight / Caveat are self-hosted (see global.css @font-face,
         exact woff2 from the reference). Poppins + Outfit stay on Google Fonts
         for the classic / AI funnel pages. -->
    {!lightFonts && (
      <>
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
          href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700&family=Poppins:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400;1,600&display=swap"
          rel="stylesheet"
        />
      </>
    )}

    <!-- Organization structured data: tells search engines which external
         profiles belong to us. Add new profiles to sameAs. -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": ["Organization", "ProfessionalService"],
      "@id": "https://synchrosocial.com/#organization",
      name: "Synchro Social",
      alternateName: ["Synchro Social LLC", "Synchro Social agency"],
      legalName: "Synchro Social LLC",
      url: "https://synchrosocial.com",
      logo: "https://synchrosocial.com/images/logo.png",
      image: "https://synchrosocial.com/images/synchro-social-share.png",
      foundingDate: "2022",
      founder: { "@type": "Person", name: "Kasper Hytonen", jobTitle: "Founder and CEO" },
      description: "Synchro Social is a Miami-based, done-for-you social media and content strategy agency for experts with something to teach: authors, doctors, coaches and thought leaders.",
      disambiguatingDescription: "A social media marketing agency. Not a synchronized swimming club and not the Synchro app.",
      award: "Shortlisted, Social Media Agency of the Year, European Agency Awards 2026",
      email: "hello@synchrosocial.com",
      address: { "@type": "PostalAddress", addressLocality: "Miami", addressRegion: "FL", addressCountry: "US" },
      sameAs: [INSTAGRAM, LINKEDIN, GLASSDOOR_URL],
    })} />

    <MetaPixel event={metaEvent?.name} params={metaEvent?.params} />
  </head>
  <body class={bodyClass}>
    <slot />
  </body>
</html>
