---
import "../styles/studio.css";
import MetaPixel from "../components/MetaPixel.astro";
import { GLASSDOOR_EN, LINKEDIN, INSTAGRAM, APPLY, SITE_LIVE } from "../data/studio.js";
import { GLASSDOOR_URL } from "../data/org.js";
interface Props { title: string; description: string; page: string; open?: boolean }
const { title, description, page, open = false } = Astro.props;
// The Results page lives at /case-studies: /results is the doctor page that ads and emails point to.
const slug = page === "home" ? "" : page === "results" ? "case-studies" : page;
const path = `/${slug}`;
const canonical = new URL(path, "https://synchrosocial.com").href;
const SHARE_IMAGE = "https://synchrosocial.com/images/synchro-social-share.png";
const AWARD = "Shortlisted, Social Media Agency of the Year, European Agency Awards 2026";
const org = {
  "@context": "https://schema.org",
  "@type": ["Organization", "ProfessionalService"],
  "@id": "https://synchrosocial.com/#organization",
  name: "Synchro Social",
  alternateName: ["Synchro Social LLC", "Synchro Social agency"],
  legalName: "Synchro Social LLC",
  url: "https://synchrosocial.com/",
  logo: "https://synchrosocial.com/images/logo.png",
  image: SHARE_IMAGE,
  foundingDate: "2022",
  founder: { "@type": "Person", name: "Kasper Hytonen", jobTitle: "Founder and CEO", url: "https://synchrosocial.com/about" },
  description: "Synchro Social is a Miami-based, done-for-you social media and content strategy agency for experts with something to teach: authors, doctors, coaches and thought leaders. Strategy, scripts, filming plans, editing and posting.",
  disambiguatingDescription: "A social media marketing agency. Not a synchronized swimming club and not the Synchro app.",
  slogan: "Someone with half your credentials is getting your audience.",
  knowsAbout: ["social media management", "short-form video", "content strategy", "video editing", "Instagram growth", "personal brand"],
  award: AWARD,
  email: "hello@synchrosocial.com",
  address: { "@type": "PostalAddress", addressLocality: "Miami", addressRegion: "FL", addressCountry: "US" },
  areaServed: "US",
  sameAs: [INSTAGRAM, LINKEDIN, GLASSDOOR_URL],
};
const site = { "@context": "https://schema.org", "@type": "WebSite", "@id": "https://synchrosocial.com/#website", name: "Synchro Social", alternateName: "Synchro Social agency", url: "https://synchrosocial.com/", publisher: { "@id": "https://synchrosocial.com/#organization" } };
const kinds = { about: "AboutPage", "case-studies": "CollectionPage", clients: "WebPage", careers: "WebPage" };
const label = { clients: "Work with us", "case-studies": "Results", about: "About", careers: "Careers" };
const pageNode = page === "home" ? null : { "@context": "https://schema.org", "@type": kinds[slug] || "WebPage", name: title, description, url: canonical, isPartOf: { "@id": "https://synchrosocial.com/#website" }, about: { "@id": "https://synchrosocial.com/#organization" } };
const crumbs = page === "home" ? null : { "@context": "https://schema.org", "@type": "BreadcrumbList", itemListElement: [{ "@type": "ListItem", position: 1, name: "Home", item: "https://synchrosocial.com/" }, { "@type": "ListItem", position: 2, name: label[slug] || title, item: canonical }] };
const graph = page === "home" ? [org, site] : [org, pageNode, crumbs];
const links = [["", "Home"], ["clients", "Clients"], ["case-studies", "Results"], ["about", "About"], ["careers", "Careers"]];
---
<!doctype html>
<html lang="en" data-theme="light">
<head>
<meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
{(SITE_LIVE || open) ? <><link rel="canonical" href={canonical} /><meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" /></> : <meta name="robots" content="noindex, nofollow" />}
<meta property="og:type" content="website" /><meta property="og:site_name" content="Synchro Social" /><meta property="og:locale" content="en_US" />
<meta property="og:title" content={title} /><meta property="og:description" content={description} />
<meta property="og:url" content={canonical} /><meta property="og:image" content={SHARE_IMAGE} /><meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" /><meta property="og:image:alt" content="Synchro Social, a social media agency for experts with something to teach" />
<meta name="twitter:card" content="summary_large_image" /><meta name="twitter:title" content={title} /><meta name="twitter:description" content={description} /><meta name="twitter:image" content={SHARE_IMAGE} />
<meta name="theme-color" content="#8331e8" />
<script type="application/ld+json" set:html={JSON.stringify(graph)} />
<MetaPixel />
<title>{title}</title><meta name="description" content={description} />
<link rel="icon" type="image/png" href="/images/synchro-social-icon.png" /><link rel="apple-touch-icon" href="/images/synchro-social-icon-180.png" />
<link rel="preconnect" href="https://fast.wistia.net" crossorigin /><link rel="preconnect" href="https://embed-ssl.wistia.com" crossorigin /><link rel="dns-prefetch" href="https://distillery.wistia.com" /><link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,700;12..96,800&display=swap" rel="stylesheet" />
<script is:inline>try{var t=localStorage.getItem('ss-theme');if(t)document.documentElement.dataset.theme=t}catch(e){}</script>
<script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-Z5WGT6LN6C"></script>
<script is:inline>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','G-Z5WGT6LN6C');document.addEventListener('click',function(e){var a=e.target.closest&&e.target.closest('a[href^="/apply"]');if(a)gtag('event','apply_click',{link_text:(a.textContent||'').trim().slice(0,60),page_path:location.pathname})});</script>
</head>
<body>
<header class="nav">
  <a class="brand" href="/" aria-label="Synchro Social home"><img class="lt" src="/images/logo-lockup.png" alt="Synchro Social" /><img class="dk" src="/images/logo-lockup-white.png" alt="" /></a>
  <nav id="mnav" aria-label="Main">{links.map(([h, l]) => <a href={`/${h}`} aria-current={(slug === h) ? "page" : undefined}>{l}</a>)}</nav>
  <div class="right">
    <button class="mb" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="mnav"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"><path class="o" d="M4 7h16M4 12h16M4 17h16"/><path class="x" d="M6 6l12 12M18 6L6 18"/></svg></button>
    <button class="tg" type="button" aria-label="Switch between light and dark">
      <svg class="i-moon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"/></svg>
      <svg class="i-sun" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
    </button>
    <a class="btn sm" href={APPLY}><span class="d">Apply to work with us</span><span class="m">Apply</span></a>
  </div>
</header>
<main><slot /></main>
<footer class="foot">
  <div class="fl"><b>Synchro Social</b><p>Synchro Social LLC, Miami, Florida</p><p><a href="mailto:hello@synchrosocial.com">hello@synchrosocial.com</a></p></div>
  <nav aria-label="Footer">
    <div><span>Company</span><a href="/about">About</a><a href="/careers">Careers</a></div>
    <div><span>Work</span><a href="/clients">Clients</a><a href="/case-studies">Results</a></div>
    <div><span>Follow</span><a href={INSTAGRAM} target="_blank" rel="noopener">Instagram</a><a href={LINKEDIN} target="_blank" rel="noopener">LinkedIn</a><a href={GLASSDOOR_EN} target="_blank" rel="noopener">Glassdoor</a></div>
    <div><span>Legal</span><a href="/privacypolicy">Privacy policy</a><a href="/terms-conditions">Terms and conditions</a></div>
  </nav>
</footer>
<script is:inline>(function(){var h=document.querySelector('.nav'),b=document.querySelector('.mb');b.addEventListener('click',function(){var o=h.classList.toggle('open');b.setAttribute('aria-expanded',o);b.setAttribute('aria-label',o?'Close menu':'Open menu')});document.addEventListener('keydown',function(e){if(e.key==='Escape'&&h.classList.contains('open')){h.classList.remove('open');b.setAttribute('aria-expanded','false');b.focus()}})})();document.querySelector('.tg').addEventListener('click',function(){var h=document.documentElement;h.dataset.theme=h.dataset.theme==='dark'?'light':'dark';try{localStorage.setItem('ss-theme',h.dataset.theme)}catch(e){}});
function wurl(b){return 'https://fast.wistia.net/embed/iframe/'+b.dataset.wistia+'?seo=false&videoFoam=true&autoPlay=true&playerColor=8331e8&stillUrl='+encodeURIComponent(location.origin+(b.querySelector('img')||{}).getAttribute('src'))}
function warm(b){if(b._w)return;b._w=1;var l=document.createElement('link');l.rel='prefetch';l.href=wurl(b);document.head.appendChild(l)}
document.querySelectorAll('[data-wistia]').forEach(function(b){['pointerenter','touchstart','focus'].forEach(function(e){b.addEventListener(e,function(){warm(b)},{passive:true,once:true})});b.addEventListener('click',function(){var w=document.createElement('div');w.className=b.className+' loading';b.replaceWith(w);b.className='vposter';b.style.cssText='position:absolute;inset:0;width:100%;height:100%;border:0;padding:0;background:none;cursor:progress';w.appendChild(b);var f=document.createElement('iframe');f.src=wurl(b);f.allow='autoplay; fullscreen';f.title=b.getAttribute('aria-label')||'Video';f.className='vframe';var shown=0;function show(){if(shown)return;shown=1;f.classList.add('on');w.classList.remove('loading')}setTimeout(show,5000);f.addEventListener('load',function(){setTimeout(show,1100)});w.appendChild(f)})});</script>
<script is:inline>(function(){var mq=window.matchMedia('(max-width:820px)');var sel='.rg,.sec:not(.cs) .vg,.pg,.ba figure>div,.about-bl,.bl.sw';var items=[];
function build(el){if(el._sw)return;var n=el.children.length;if(n<2)return;var w=document.createElement('div');w.className='swh';w.setAttribute('aria-hidden','true');var d=document.createElement('div');d.className='swd';var nd=Math.min(n,6);for(var i=0;i<nd;i++){var b=document.createElement('i');d.appendChild(b)}w.appendChild(d);el.insertAdjacentElement('afterend',w);el._sw=w;
function up(){var m=el.scrollWidth-el.clientWidth;if(m<8){w.hidden=true;return}w.hidden=false;var r=Math.max(0,Math.min(1,el.scrollLeft/m));var a=Math.round(r*(nd-1));var k=d.children;for(var i=0;i<k.length;i++)k[i].className=i===a?'on':'';w.classList.toggle('moved',el.scrollLeft>8)}
el.addEventListener('scroll',function(){requestAnimationFrame(up)},{passive:true});
function go(x,instant){var r=d.getBoundingClientRect();var f=Math.max(0,Math.min(1,(x-r.left)/r.width));var k=Math.min(Math.floor(f*nd),nd-1);var m=el.scrollWidth-el.clientWidth;var prev=el.style.scrollBehavior,snap=el.style.scrollSnapType;if(instant){el.style.scrollBehavior='auto';el.style.scrollSnapType='none'}el.scrollTo({left:nd===1?0:k/(nd-1)*m,behavior:instant?'auto':'smooth'});if(instant){el.style.scrollBehavior=prev;el._snap=snap}}
var drag=false;d.addEventListener('pointerdown',function(e){drag=true;try{d.setPointerCapture(e.pointerId)}catch(x){}go(e.clientX,false);e.preventDefault()});
d.addEventListener('pointermove',function(e){if(drag)go(e.clientX,true)});
function end(){if(!drag)return;drag=false;el.style.scrollSnapType=''}
d.addEventListener('pointerup',end);d.addEventListener('pointercancel',end);
window.addEventListener('resize',up);up();setTimeout(up,400)}
function init(){if(!mq.matches)return;document.querySelectorAll('main *').forEach(function(e){if(e._sw||e.children.length<2)return;var o=getComputedStyle(e).overflowX;if((o==='auto'||o==='scroll')&&e.scrollWidth-e.clientWidth>8)build(e)})}
init();mq.addEventListener&&mq.addEventListener('change',init);window.addEventListener('load',init)})();</script>
</body>
</html>
