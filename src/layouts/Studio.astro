---
import "../styles/studio.css";
import { GLASSDOOR_EN, LINKEDIN, INSTAGRAM, APPLY, SITE_LIVE } from "../data/studio.js";
import { GLASSDOOR_URL } from "../data/org.js";
interface Props { title: string; description: string; page: string }
const { title, description, page } = Astro.props;
const path = page === "home" ? "/" : `/${page}`;
const canonical = new URL(path, "https://synchrosocial.com").href;
const org = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "Synchro Social",
  legalName: "Synchro Social LLC",
  url: "https://synchrosocial.com/",
  logo: "https://synchrosocial.com/images/logo.png",
  foundingDate: "2022",
  description: "A social media studio for experts, founders and educators: strategy, scripts, editing and posting.",
  email: "hello@synchrosocial.com",
  address: { "@type": "PostalAddress", addressLocality: "Miami", addressRegion: "FL", addressCountry: "US" },
  sameAs: [INSTAGRAM, LINKEDIN, GLASSDOOR_URL],
};
const site = { "@context": "https://schema.org", "@type": "WebSite", name: "Synchro Social", url: "https://synchrosocial.com/" };
const links = [["clients", "Clients"], ["results", "Results"], ["about", "About"], ["careers", "Careers"]];
---
<!doctype html>
<html lang="en" data-theme="light">
<head>
<meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
{SITE_LIVE ? <link rel="canonical" href={canonical} /> : <meta name="robots" content="noindex, nofollow" />}
<meta property="og:type" content="website" /><meta property="og:site_name" content="Synchro Social" />
<meta property="og:title" content={title} /><meta property="og:description" content={description} />
<meta property="og:url" content={canonical} /><meta property="og:image" content="https://synchrosocial.com/images/apply4/kasper-founder.webp" />
<meta name="twitter:card" content="summary_large_image" />
<script type="application/ld+json" set:html={JSON.stringify(page === "home" ? [org, site] : org)} />
<title>{title}</title><meta name="description" content={description} />
<link rel="icon" type="image/png" href="/images/logo.png" />
<link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,700;12..96,800&display=swap" rel="stylesheet" />
<script is:inline>try{var t=localStorage.getItem('ss-theme');if(t)document.documentElement.dataset.theme=t}catch(e){}</script>
</head>
<body>
<header class="nav">
  <a class="brand" href="/new/"><img src="/images/logo.png" alt="" /><span>Synchro Social</span></a>
  <nav aria-label="Main">{links.map(([h, l]) => <a href={`/new/${h}`} aria-current={page === h ? "page" : undefined}>{l}</a>)}</nav>
  <div class="right">
    <button class="tg" type="button" aria-label="Switch between light and dark">
      <svg class="i-moon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"/></svg>
      <svg class="i-sun" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
    </button>
    <a class="btn sm" href={APPLY} target="_blank" rel="noopener">Talk to us</a>
  </div>
</header>
<main><slot /></main>
<footer class="foot">
  <div class="fl"><b>Synchro Social</b><p>Synchro Social LLC, Miami, Florida</p><p><a href="mailto:hello@synchrosocial.com">hello@synchrosocial.com</a></p></div>
  <nav aria-label="Footer">
    <div><span>Company</span><a href="/new/about">About</a><a href="/new/careers">Careers</a></div>
    <div><span>Work</span><a href="/new/clients">Clients</a><a href="/new/results">Results</a></div>
    <div><span>Follow</span><a href={INSTAGRAM} target="_blank" rel="noopener">Instagram</a><a href={LINKEDIN} target="_blank" rel="noopener">LinkedIn</a><a href={GLASSDOOR_EN} target="_blank" rel="noopener">Glassdoor</a></div>
    <div><span>Legal</span><a href="/privacypolicy">Privacy policy</a><a href="/terms-conditions">Terms and conditions</a></div>
  </nav>
</footer>
<script is:inline>document.querySelector('.tg').addEventListener('click',function(){var h=document.documentElement;h.dataset.theme=h.dataset.theme==='dark'?'light':'dark';try{localStorage.setItem('ss-theme',h.dataset.theme)}catch(e){}});
document.querySelectorAll('[data-wistia]').forEach(function(b){b.addEventListener('click',function(){var f=document.createElement('iframe');f.src='https://fast.wistia.net/embed/iframe/'+b.dataset.wistia+'?seo=false&videoFoam=true&autoPlay=true';f.allow='autoplay; fullscreen';f.title=b.getAttribute('aria-label')||'Video';f.className=b.className+' playing';b.replaceWith(f)})});</script>
</body>
</html>
