---
import Layout from "../layouts/Layout.astro";
import SiteNav from "../components/SiteNav.astro";
import IClosedLiftWidget from "../components/IClosedLiftWidget.astro";
import IClosedEmbed from "../components/IClosedEmbed.astro";
import CaseStudyVideo from "../components/CaseStudyVideo.astro";
import VideoEmbed from "../components/VideoEmbed.astro";
import ApplyButton from "../components/ApplyButton.astro";
import PlatformIcon from "../components/PlatformIcon.astro";
import AudienceSkyrocket from "../components/AudienceSkyrocket.astro";
import ApplyHeroProofBar from "../components/ApplyHeroProofBar.astro";
import CampaignProofGrid from "../components/CampaignProofGrid.astro";
import ApplyTestimonials from "../components/ApplyTestimonials.astro";
import ApplyFaq from "../components/ApplyFaq.astro";
import ApplyLegalFooter from "../components/ApplyLegalFooter.astro";
import { caseStudies, slug } from "../data/caseStudies.js";

/* ===========================================================================
   APPLY PAGE — what happens when someone clicks "Apply Now".
   Matched 1:1 to the reference funnel's measured spec, in Synchro purple:
   100svh hero with bottom purple fade + half-highlight headline + booking,
   campaign proof, customer testimonials, case studies, FAQ, and legal footer.

   Booking uses Kasper's iClosed "Social Media Consultation" calendar
   (synchrosocial/social-media-consultation), which redirects to /thank-you. /call uses a
   sibling calendar (synchrosocial/ai-intro-call) — same questions, but an
   internal confirmation so the coral AI funnel doesn't jump to purple.
=========================================================================== */

// Case-study data + the name→slug helper are shared with /thank-you so the two
// pages never drift. Edit src/data/caseStudies.js to update both.

const ctaCaption = "Get Started In Less Than 60 Seconds • Cancel Anytime";
const ctaLabel = "Book A Consultation Call";
---

<Layout
  title="Apply — Synchro Social"
  description="Apply to work with Synchro Social. Grow your social media exceptionally, but with intention."
  bodyClass="v2"
  metaEvent={{ name: "ViewContent", params: { content_name: "apply" } }}
>
  <SiteNav minimal logoClickable={false} />
  <IClosedLiftWidget />

  <!-- ===================== HERO + BOOKING ===================== -->
  <section class="relative min-h-[100svh] pb-[56px] pt-20 max-lg:pt-10 max-md:pb-[36px] max-md:pt-[40px]">
    <!-- Backdrop: transparent fading down to solid brand purple -->
    <div class="apply-page-hero-backdrop bg-hero-fade pointer-events-none absolute inset-0" aria-hidden="true"></div>

    <div class="relative z-[3] mx-auto flex w-full flex-col items-center gap-10 max-md:gap-7">
      <div class="flex w-full flex-col items-center gap-5 text-center max-md:gap-4">
        <p class="font-tight text-sm font-semibold uppercase leading-none tracking-[0.2em] text-[#d8c4ff] max-md:mx-auto max-md:w-[calc(100%-32px)] max-md:max-w-[385px] max-md:text-[11px] max-md:tracking-[0.16em]">
          For Impact-Driven Coaches &amp; Experts
        </p>
        <h1 class="hidden font-tight text-[clamp(3rem,2.05rem+2.45vw,4.5rem)] font-bold leading-[1.06] text-white md:block">
          <span class="inline-block whitespace-nowrap">Grow Your Following and Turn</span>
          <br />
          <span class="inline-block whitespace-nowrap">Views Into <span class="apply-highlight">Qualified Leads</span></span>
        </h1>
        <h1 class="font-tight mx-auto w-[calc(100%-24px)] max-w-[400px] text-[clamp(31px,calc(8vw-1px),36px)] font-bold leading-[1.06] text-white md:hidden">
          <span class="inline-block whitespace-nowrap">Grow Your Following</span>
          <br />
          <span class="inline-block whitespace-nowrap">and Turn Views Into</span>
          <br />
          <span class="inline-block whitespace-nowrap apply-highlight">Qualified Leads</span>
        </h1>
        <div class="max-w-[900px] max-md:mx-auto max-md:w-[calc(100%-36px)] max-md:max-w-[358px]">
          <p class="apply-hero-subtitle text-xl leading-[157%] max-md:text-[12px] max-md:leading-[1.38]">
            We turn your expertise into strategic short-form videos, handling the ideation, scripting,
            editing, thumbnails, publishing, and performance tracking for you.
          </p>
        </div>
      </div>

      <ApplyHeroProofBar />

      <div class="flex w-full max-w-[540px] flex-col max-md:w-[calc(100%-32px)] max-md:max-w-none">
        <ApplyButton href="#book" label={ctaLabel} arrowDir="down" class="w-full" />
      </div>

      <div class="w-full max-w-[900px] max-md:w-[calc(100%-32px)]">
        <VideoEmbed provider="wistia" id="n9pdmpfj9x" title="How It Works" tone="brand" />
      </div>

      <!-- Booking — Kasper's iClosed "Social Media Consultation" calendar.
           Match Growthtopia/iClosed's official inline embed: a transparent
           full-width iframe host, no extra white wrapper, no custom loader gate. -->
      <div id="book" class="w-full min-h-[500px] scroll-mt-[128px] max-md:min-h-[560px] max-md:scroll-mt-[96px]">
        <div class="mx-auto w-full min-h-[500px] max-md:min-h-[560px] max-md:w-[calc(100%-32px)]">
          <IClosedEmbed
            linkPrefix="synchrosocial/social-media-consultation"
            title="Social Media Consultation"
            height="500px"
            card={false}
            resize={false}
          />
        </div>

        <!-- A2P 10DLC consent disclosure. Carriers require the four elements below
             (message type, frequency, rates, opt-out) to appear adjacent to the
             control where the phone number is given. The booking widget is a
             third-party iframe whose own checkbox links to iClosed's policies, not
             ours, so this line carries our disclosure and links to our policies as
             close to the phone field as we can place it. Do not remove without
             checking docs/booking-recovery/TWILIO_RUNBOOK.md. -->
        <p class="mx-auto mt-5 max-w-[680px] text-center text-[12px] leading-[1.55] text-white/45 max-md:w-[calc(100%-32px)]">
          By booking a call you agree to receive text messages from Synchro Social about your
          call. Message frequency varies, typically one message per booking. Message and data
          rates may apply. Reply STOP to opt out, HELP for help. See our
          <a href="/privacypolicy" target="_blank" rel="noopener noreferrer" class="underline underline-offset-2 transition-colors hover:text-white/75">Privacy Policy</a>
          and
          <a href="/terms-conditions" target="_blank" rel="noopener noreferrer" class="underline underline-offset-2 transition-colors hover:text-white/75">Terms</a>.
        </p>
      </div>

    </div>
  </section>

  <CampaignProofGrid />

  <ApplyTestimonials ctaLabel={ctaLabel} />

  <!-- ===================== CASE STUDIES ===================== -->
  <section class="w-full bg-white pb-14 pt-20 text-black max-lg:pb-12 max-lg:pt-6 max-md:pt-8">
    <div class="mx-auto flex w-[95%] max-w-[1040px] flex-col items-center gap-[60px] max-lg:gap-[30px]">
      <div class="flex w-full flex-col items-center gap-4 text-center">
        <h2 class="font-tight text-5xl font-bold capitalize leading-none text-black max-md:mx-auto max-md:w-[calc(100vw-32px)] max-md:max-w-[398px] max-md:text-[28px]">
          <strong>Check Out (Just Some) Of Our Case Studies</strong>
        </h2>
      </div>

      <div class="mt-0 flex w-full flex-col gap-12">
        {
          caseStudies.map((cs) => (
            <div class="flex w-full flex-col">
              <!-- Header -->
              <div class="mx-auto mb-4 flex w-full max-w-[61rem] flex-col items-center border-b border-black pb-4">
                <div class="text-lg font-light leading-[1.3]">SYNCHRO SOCIAL CASE STUDY</div>
                <h3 class="text-center text-[2.5rem] font-black uppercase leading-[1.3] max-md:text-[2rem]">
                  {cs.name}
                </h3>
                <div class="mt-8 self-start text-left text-2xl font-normal leading-[1.3] max-md:hidden">
                  RESULTS IN {cs.period.toUpperCase()}:
                </div>
              </div>

              <!-- Stats + photo + platforms -->
              <div class="mx-auto grid w-full max-w-[61rem] grid-cols-3 items-center gap-4 max-md:flex max-md:flex-col max-md:items-center max-md:gap-7 max-md:text-center">
                {cs.stats.map((s) => (
                  <div class="max-md:order-3 max-md:w-full">
                    <div class="text-[3.5rem] font-black leading-[1.3] max-lg:text-[3rem]">
                      {s.value}
                    </div>
                    <div class="text-xl font-normal leading-[1.3] max-md:text-base">{s.label}</div>
                  </div>
                ))}
                <div class="relative overflow-hidden rounded-[5px] max-md:order-1 max-md:mx-auto max-md:w-[80vw] max-md:max-w-none">
                  <div class="flex aspect-square w-full items-center justify-center bg-gradient-to-br from-brand-300 to-brand-600 text-4xl font-bold text-white/90">
                    {cs.name.split(" ").map((w) => w[0]).join("")}
                  </div>
                  <img
                    src={`/images/clients/${slug(cs.name)}.jpg`}
                    alt={cs.name}
                    class="absolute inset-0 h-full w-full object-cover"
                    onerror="this.style.display='none'"
                  />
                </div>
                <div class="hidden max-md:order-2 max-md:block max-md:w-full max-md:border-b max-md:border-black max-md:pb-6 max-md:text-center max-md:text-[18px] max-md:font-normal max-md:leading-[23.4px]">
                  RESULTS IN {cs.period.toUpperCase()}:
                </div>
                <div class="col-span-3 flex items-center gap-4 text-2xl max-md:order-4 max-md:col-span-1 max-md:mt-4 max-md:flex-col max-md:justify-center">
                  <span>Platforms:</span>
                  <div class="flex gap-2">
                    {cs.platforms.map((p) => (
                      <PlatformIcon name={p} class="h-8 w-8" />
                    ))}
                  </div>
                </div>
              </div>

              <!-- Video examples -->
              <div class="mx-auto mt-8 flex w-full max-w-[61rem] flex-col gap-4">
                <div class="text-[2rem] font-black leading-[1.3] max-md:text-center max-md:text-2xl">Video examples:</div>
                <div class="grid w-full grid-cols-3 gap-16 max-lg:gap-8 max-md:grid-cols-1 max-md:gap-8">
                  {cs.videos.map((v) => (
                    <div class="flex w-full flex-col items-center justify-center gap-1">
                      <CaseStudyVideo
                        wistia={v.wistia}
                        poster={v.poster}
                        mp4={v.mp4}
                        mp4Poster={v.mp4Poster}
                        title={`${cs.name} reel — ${v.views} views`}
                      />
                      <div class="text-base font-bold leading-[1.3]">{v.views} views</div>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          ))
        }
      </div>

      <div class="mt-10 flex w-full max-w-[420px] flex-col items-center gap-4 text-center">
        <ApplyButton href="#book" label={ctaLabel} class="w-full" />
        <p class="text-base leading-[157%] text-black">{ctaCaption}</p>
      </div>
    </div>
  </section>

  <AudienceSkyrocket ctaHref="#book" ctaLabel={ctaLabel} />

  <ApplyFaq />
  <ApplyLegalFooter />
</Layout>

<style>
  /* Highlighter-pen block behind "Qualified Leads" in the hero headline —
     matches /quiz's corrected "3 Minutes" treatment (2026-08-26): the owner
     rejected the first rounded-gradient-chip version (this file's original
     one), wanting a flat block that does NOT cover full cap-height (letter
     tops poke out above it), extends below the baseline, and is wider than
     the text left/right — an absolutely-positioned ::before behind the
     text, not padding, since padding can't offset the box asymmetrically. */
  .apply-highlight {
    position: relative;
    z-index: 0;
    display: inline-block;
  }

  .apply-highlight::before {
    content: "";
    position: absolute;
    z-index: -1;
    left: -0.14em;
    right: -0.14em;
    top: 0.5em;
    bottom: -0.05em;
    background: var(--g-purple);
  }
</style>
