---
/* ===========================================================================
   /apply4-thank-you — confirm-your-call page for the doctor offer (/apply4).

   A clone of /thank-you (same 4 steps, same videos, same copy) re-skinned in
   the white and blue design of /apply4. /thank-you itself is untouched: it
   still serves the purple funnels.

   To use it, set the iClosed "Doctor Strategy Call" event's redirect after
   booking to https://synchrosocial.com/apply4-thank-you (iClosed settings,
   not code).

   Tracking: this page fires NO pixel event. /doctors fires `Lead` at form
   submit (except "Not right now" on the $3,000 question), and the server-side CAPI workflow (n8n
   "Sales - Booked Call to Meta CAPI") sends `Schedule` for the doctor
   strategy call, so a browser `Schedule` here would double-count. See
   docs/meta-ads/README.md.
=========================================================================== */
import Layout from "../layouts/Layout.astro";
import VideoEmbed from "../components/VideoEmbed.astro";

const checklist = [
  {
    n: "1",
    title: "Communication",
    body: "Check your email for a calendar invite confirming your scheduled date and time. Be sure to accept the invite so it's added to your calendar.",
  },
  {
    n: "2",
    title: "Punctuality",
    body: "Your call will take place over Zoom or phone. The link or number is included in your calendar invite. Please join from a quiet, private space with minimal distractions; we'll do the same. Important: due to high demand, missed calls can't be rescheduled, so if you need to make changes please let us know at least 24 hours in advance.",
  },
  {
    n: "3",
    title: "Preparation",
    body: "To make the most of our time together, please watch the Q&A videos below and review the emails we'll be sending over the next few days. These give a detailed overview of our service so you can come prepared with any questions.",
  },
];

const qaVideos = [
  { id: "uqnl8bn89r", title: "What Exactly Do We Do?" },
  { id: "qzz4nt1ceg", title: "Will This Work For My Niche Or Industry?" },
  { id: "hfcfosmhb8", title: "How Fast Will I Get Results?" },
  { id: "8j0lpgua9g", title: "How Much Time Will This Take?" },
  { id: "m5wz3w5kji", title: "Do I Have To Be On Camera?" },
];

const proof = [
  { img: "lily-baker-before-after-wide.webp", alt: "Dr. Lily Baker's before and after growth", who: "Dr. Lily Baker" },
  { img: "sonia-chopra-before-after.webp", alt: "Dr. Sonia Chopra's before and after growth", who: "Dr. Sonia Chopra" },
  { img: "rocco-piazza-featured.webp", alt: "Dr. Rocco Piazza featured on the Plastic Surgery Channel", who: "Dr. Rocco Piazza" },
];

const year = new Date().getFullYear();
---

<Layout
  title="You're Almost There | Synchro Social"
  description="Two quick steps to confirm your call with Synchro Social."
  bodyClass="ty-body"
>

  <div class="ty">
    <header class="hero">
      <div class="wrap">
        <img class="logo" src="/images/apply4/logo-dark.png" alt="Synchro Social" width="170" height="36" />
        <h1>Let's Lock In Your Call</h1>
        <p class="lead">Make sure to do these 4 steps so you can confirm your call with us</p>

        <div class="bar">
          <span class="dot"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M6 13l6 6 6-6" /></svg></span>
          STEP 1: Watch This Short Video On How To Prepare For The Call
        </div>

        <div class="video">
          <VideoEmbed provider="wistia" id="feucj6axzn" title="Watch This First: What Happens Next" frame={false} />
        </div>
        <p class="note">You'll get a confirmation text from us.</p>
      </div>
    </header>

    <section class="step alt">
      <div class="wrap">
        <span class="pill"><span class="dot"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M6 13l6 6 6-6" /></svg></span>STEP 2</span>
        <h2>Press The "I Know The Sender" Button In Your Event Email &amp; Accept The Calendar Invite We Just Sent You</h2>
        <img class="shot" src="/images/thank-you/i-know-the-sender.webp" alt={'Gmail "I know the sender" button highlighted on the calendar invite'} loading="lazy" />
        <p class="body">Otherwise the event you just scheduled with us will not show up in your calendar and you will likely miss the call.</p>
      </div>
    </section>

    <section class="step">
      <div class="wrap">
        <span class="pill"><span class="dot"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M6 13l6 6 6-6" /></svg></span>STEP 3</span>
        <h2>Pre-Call Checklist: Please Review Before Your Call</h2>
        <ol class="list">
          {
            checklist.map((c) => (
              <li>
                <b>{c.n}. {c.title}</b> : {c.body}
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section class="step alt">
      <div class="wrap">
        <span class="pill"><span class="dot"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M6 13l6 6 6-6" /></svg></span>STEP 4</span>
        <h2>Watch These Q&amp;A Videos Answering Most Common Questions To Save Time In Your Decision-Making Process.</h2>
        <div class="qa">
          {
            qaVideos.map((v) => (
              <div class="qa-item">
                <VideoEmbed provider="wistia" id={v.id} title={v.title} frame={false} />
                <h3>{v.title}</h3>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section class="step">
      <div class="wrap">
        <h2>Real Doctors. Real Growth.</h2>
        <div class="proof">
          {
            proof.map((p) => (
              <figure>
                <img src={`/images/apply4/${p.img}`} alt={p.alt} loading="lazy" />
                <figcaption>{p.who}</figcaption>
              </figure>
            ))
          }
        </div>
      </div>
    </section>

    <footer>© {year} Synchro Social LLC. All rights reserved.</footer>
  </div>
</Layout>

<style is:global>
  body.ty-body { margin: 0; background: #fff; }
  .ty {
    --ink: #0a0a1a;
    --ink-2: #3d4557;
    --p: #178af6;
    --p-deep: #0070e0;
    --p-soft: #e8f2fe;
    --surface: #f7f8fa;
    --card-border: #e5e8ee;
    color: var(--ink);
    font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    line-height: 1.6;
    letter-spacing: -0.011em;
    text-align: center;
    -webkit-font-smoothing: antialiased;
  }
  .ty * { box-sizing: border-box; }
  .ty .wrap { max-width: 1040px; margin: 0 auto; padding-inline: 20px; }
  .ty h1, .ty h2, .ty h3 { margin: 0; text-wrap: balance; font-weight: 700; }
  .ty h1 { font-size: clamp(30px, 5vw, 52px); line-height: 1.08; letter-spacing: -0.03em; margin-top: 28px; }
  .ty h2 { font-size: clamp(22px, 3.2vw, 34px); line-height: 1.2; letter-spacing: -0.02em; margin-top: 28px; }
  .ty h3 { font-size: 18px; }
  .ty .hero {
    padding-block: 32px 64px;
    background: radial-gradient(1100px 520px at 50% 0, rgba(23, 138, 246, 0.12), rgba(255, 255, 255, 0)), linear-gradient(180deg, #fff, #f3f8ff);
  }
  .ty .logo { width: 170px; height: auto; }
  .ty .lead { font-size: 19px; color: var(--ink-2); margin: 14px auto 0; max-width: 620px; }
  .ty .bar, .ty .pill {
    display: inline-flex; align-items: center; justify-content: center; gap: 12px;
    background: var(--p); color: #fff; border-radius: 6px; font-weight: 600;
  }
  .ty .bar { margin-top: 28px; padding: 12px 24px; font-size: 18px; width: 100%; max-width: 880px; text-align: left; }
  .ty .pill { padding: 6px 18px 6px 8px; font-size: 16px; letter-spacing: 0.08em; }
  .ty .dot { display: grid; place-items: center; width: 26px; height: 26px; flex: none; border-radius: 50%; background: #fff; color: var(--p); }
  .ty .dot svg { width: 14px; height: 14px; }
  .ty .video { margin: 28px auto 0; max-width: 880px; border-radius: 8px; overflow: hidden; border: 1px solid var(--card-border); box-shadow: 0 10px 30px rgba(10, 14, 31, 0.08); }
  .ty .note { margin: 24px 0 0; font-size: 18px; color: var(--ink-2); }
  .ty .step { padding-block: 72px; }
  .ty .step.alt { background: var(--surface); }
  .ty .shot { display: block; width: 100%; max-width: 880px; margin: 28px auto 0; border-radius: 6px; border: 1px solid var(--card-border); }
  .ty .body { font-size: 19px; color: var(--ink-2); max-width: 760px; margin: 24px auto 0; }
  .ty .list { list-style: none; padding: 0; margin: 32px 0 0; display: grid; gap: 22px; text-align: left; font-size: 18px; color: var(--ink-2); }
  .ty .list b { color: var(--p-deep); }
  .ty .qa { display: grid; grid-template-columns: 1fr 1fr; gap: 40px 32px; margin-top: 40px; }
  .ty .qa-item { display: grid; gap: 12px; align-content: start; }
  .ty .qa-item .video, .ty .qa-item > div { border-radius: 6px; overflow: hidden; }
  .ty .qa-item:last-child:nth-child(odd) { grid-column: 1 / -1; justify-self: center; width: calc(50% - 16px); }
  .ty .proof { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-top: 36px; }
  .ty .proof figure { margin: 0; background: #fff; border: 1px solid var(--card-border); border-radius: 8px; overflow: hidden; }
  .ty .proof img { display: block; width: 100%; aspect-ratio: 16 / 10; object-fit: contain; }
  .ty .proof figcaption { padding: 10px; font-weight: 600; font-size: 15px; border-top: 1px solid var(--card-border); }
  .ty footer { padding: 32px 20px; font-size: 14px; color: var(--ink-2); border-top: 1px solid var(--card-border); }
  @media (max-width: 767px) {
    .ty .qa, .ty .proof { grid-template-columns: 1fr; }
    .ty .qa-item:last-child:nth-child(odd) { grid-column: auto; width: 100%; }
    .ty .step { padding-block: 40px; }
    .ty .bar { font-size: 15px; padding: 10px 14px; }
    .ty .lead, .ty .note, .ty .body, .ty .list { font-size: 16px; }
  }
</style>
