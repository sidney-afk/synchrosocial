---
/* ===========================================================================
   /apply4 — doctor offer page for cold Meta ads.

   Owner decision 2026-09-28: the page matches the brief's MOCKUP ("Doctor
   Offer Page", the artifact Kasper sent) as closely as possible: colors,
   fonts, layout, buttons and copy are ported from it 1:1. Earlier versions
   matched /apply3 instead; that was superseded.

   Differences from the mockup, all deliberate:
     - The form works in two steps, like viralcoach.com/cpy/book2: our own
       form (mockup fields; Specialty is a choice so it matches iClosed), then
       the iClosed "Doctor Strategy Call" calendar with every answer passed as
       URL parameters (iclosedName/Email/Phone + question identifiers) and
       iClosed's "Pre-qualified form skipping" on, so the doctor only picks a
       time. "Under $2,000" is turned away on our page. Meta `Lead` fires on
       submit (brief), not on booking.
     - Real assets replace placeholders where we have them: Lily's profile
       image, her growth image in the results tile, Sonia's Wistia video.
     - The yellow "mockup" bar and demo submit handler are dropped; the SMS
       consent text from the other apply pages sits under the form.
     - The FAQ price answer stays off the page (owner).

   Every class lives under .dm so none of this leaks into shared styles.
=========================================================================== */
import Layout from "../layouts/Layout.astro";

// iClosed "Doctor Strategy Call" event (disqualifies "Under $2,000" a month).
const ICLOSED_URL = "https://app.iclosed.io/e/synchrosocial/doctor-strategy-call";

// Answer text must match the iClosed event's options EXACTLY: they are passed
// to iClosed as URL parameters and matched as strings.
const specialties = ["Physician", "Dentist", "Chiropractor", "Surgeon", "Other"];
const investments = ["Under $2,000", "$2,000 to $3,000", "$3,000 to $5,000", "$5,000+"];
const starts = ["Now", "Within 30 days", "Within 90 days", "Next quarter"];

const guaranteeLead = "If we don't hit the monthly follower target we set for you in your first 3 months,";
const guaranteeBold = "we keep working for free until we do.";

const faqs = [
  {
    q: "What do you do?",
    a: "We run your short-form content from start to finish: strategy, filming plans, scripts, editing, posting on all your platforms, and weekly reports.",
  },
  { q: "What do I need to do?", a: "Film about once a month. We tell you exactly what to say." },
  {
    q: "How does the guarantee work?",
    a: "On your strategy call we set your monthly follower target based on your account. If we don't hit it in your first 3 months, we keep working for free until we do.",
  },
  {
    q: "Does this work for my specialty?",
    a: "Yes. The same system works across specialties. No skits or trends you're not comfortable with.",
  },
  {
    q: "What about patient privacy?",
    a: "We follow platform health-content guidelines and never show patients or patient information. You approve every post before it goes live.",
  },
  {
    q: "When will I see results?",
    a: "Your first post goes live 2 to 3 weeks after you start. Month one tests a wide range of angles. From month two, we double down on what's working.",
  },
  {
    // Owner: no price on the page. The mockup left this answer open.
    q: "What does it cost?",
    a: "We go over pricing on your strategy call, once we've set your target.",
  },
];
---

<Layout
  title="For Doctors: 3,000 to 5,000 New Followers a Month, Guaranteed | Synchro Social"
  description="We film you for 2-3 hours a month, edit and post, and bring you followers who want what you offer. Guaranteed."
  bodyClass="dm-body"
  metaEvent={{ name: "ViewContent", params: { content_name: "doctor_offer" } }}
>
  <div class="dm">
    <div class="brand"><img src="/images/logo-updated.png" alt="Synchro Social" width="170" height="36" /></div>

    <!-- 1. TOP -->
    <section class="hero">
      <div class="wrap">
        <p class="kicker">For doctors, dentists, chiropractors, and surgeons</p>
        <h1>
          <span class="line">We'll get you <span class="hl">3,000 to 5,000</span></span>
          <span class="line">new followers a month.</span>
          <span class="line"><em>Guaranteed.</em></span>
        </h1>
        <p class="sub">
          We film you for 2-3 hours a month with scripts we create and you approve. We edit and
          post, and bring you followers who want what you offer.
        </p>
        <div class="cta">
          <a class="btn" href="#apply">See If You Qualify</a>
          <p class="guarantee">{guaranteeLead} <b>{guaranteeBold}</b></p>
        </div>
      </div>
    </section>

    <!-- 2-4. PROOF CARD, FORM, STATS -->
    <section class="apply">
      <div class="wrap">
        <div class="proof-card">
          <img
            class="shot-img" data-zoom
            src="/images/apply4/lily-baker-before-after.webp"
            alt="Dr. Lily Baker's Instagram profile before (63.9K followers) and after (151K followers)"
            width="900"
            height="950"
            decoding="async"
          />
          <div class="shot" role="img" aria-label="Placeholder for viral reel insights screenshot">
            <span>Reel insights screenshot</span><small>17,000+ followers from one reel</small>
          </div>
          <div class="proof-text">
            <div class="who">Dr. Lily Baker · Chiropractor</div>
            <div class="big">60K New Followers in Under 90 Days</div>
            <p>
              Grew from 90K to 150K followers with 12M views. One reel brought in over 17,000 new
              followers alone.
            </p>
          </div>
        </div>

        <div id="apply" class="form-card">
          <h2>See If You Qualify</h2>
          <!-- Step 1: our own form (mockup). Step 2: iClosed calendar with the
               answers prefilled, so the doctor only picks a time. -->
          <form class="apply-form" data-step="1" novalidate>
            <div class="grid">
              <div class="field"><label for="f-name">Name</label><input id="f-name" name="name" type="text" autocomplete="name" required /></div>
              <div class="field"><label for="f-email">Email</label><input id="f-email" name="email" type="email" autocomplete="email" required /></div>
              <div class="field"><label for="f-phone">Phone</label><input id="f-phone" name="phone" type="tel" autocomplete="tel" placeholder="+1 555 123 4567" required /></div>
              <div class="field"><label for="f-ig">Instagram handle</label><div class="handle"><span>@</span><input id="f-ig" name="instagram" type="text" placeholder="yourhandle" required /></div></div>
              <div class="field full"><span class="q">Specialty</span>
                <div class="chips">{specialties.map((v) => <label><input type="radio" name="specialty" value={v} required />{v}</label>)}</div>
              </div>
              <div class="field full"><span class="q">How much are you ready to invest monthly in growing your audience?</span>
                <div class="chips">{investments.map((v) => <label><input type="radio" name="investment" value={v} required />{v}</label>)}</div>
              </div>
              <div class="field full"><span class="q">When can you start?</span>
                <div class="chips">{starts.map((v) => <label><input type="radio" name="start" value={v} required />{v}</label>)}</div>
              </div>
            </div>
            <p class="form-error" role="alert" hidden></p>
            <div class="submit">
              <button class="btn" type="submit">Submit application</button>
            </div>
          </form>
          <div class="step-dq" hidden>
            <p class="dq-title">Thanks for applying!</p>
            <p>We've received your application and our team will review it.</p>
          </div>
          <div class="step-cal" hidden>
            <p class="note">Last step: pick a time for your strategy call.</p>
            <div class="form-embed"></div>
          </div>
          <!-- A2P 10DLC consent disclosure, carried over from /apply2 and /apply3.
               See docs/booking-recovery/TWILIO_RUNBOOK.md before changing. -->
          <p class="legal">
            By booking a call you agree to receive text messages from Synchro Social about your
            call. Message frequency varies, typically one message per booking. Message and data
            rates may apply. Reply STOP to opt out, HELP for help. See our
            <a href="/privacypolicy" target="_blank" rel="noopener noreferrer">Privacy Policy</a>
            and
            <a href="/terms-conditions" target="_blank" rel="noopener noreferrer">Terms</a>.
          </p>
        </div>

        <div class="proof-grid">
          <div class="pg"><div class="pg-label">Reach</div><div class="pg-num">1.2<span class="u">B+</span></div><p>Views generated for our clients</p></div>
          <div class="pg"><div class="pg-label">Growth</div><div class="pg-num">8<span class="u">M+</span></div><p>Followers grown across platforms</p></div>
          <div class="pg"><div class="pg-label">Leads</div><div class="pg-num">150<span class="u">K+</span></div><p>Over 150,000 leads generated for clients</p></div>
        </div>
      </div>
    </section>

    <!-- 5. HOW IT WORKS -->
    <section class="glow how">
      <div class="wrap">
        <p class="kicker">How it works</p>
        <h2>From your first call to your first post</h2>
        <div class="steps">
          <div class="step"><div class="n">1</div><h3>We set your target</h3><p>On a strategy call we review your account and set your monthly follower target.</p></div>
          <div class="step"><div class="n">2</div><h3>We film you</h3><p>2-3 hours a month, with the strategy and scripts we create and you approve.</p></div>
          <div class="step"><div class="n">3</div><h3>We edit and post</h3><p>Your first post goes live 2 to 3 weeks after you start, with weekly reports on every video.</p></div>
        </div>
      </div>
    </section>

    <!-- 6. RESULTS -->
    <section style="padding-top:0">
      <div class="wrap">
        <p class="kicker">Doctor results</p>
        <h2>Doctors we've grown</h2>
        <div class="tiles">
          <article class="tile">
            <img
              class="thumb-img" data-zoom
              src="/images/apply4/lily-baker-before-after-wide.webp"
              alt="Dr. Lily Baker's Instagram profile before (63.9K followers) and after (151K followers)"
              width="1280"
              height="800"
              loading="lazy"
              decoding="async"
            />
            <div class="tile-body">
              <div class="who">Dr. Lily Baker · Chiropractor</div>
              <div class="big">60K New Followers in Under 90 Days</div>
              <p>Grew from 90K to 150K followers with 12M views. One reel brought in over 17,000 new followers alone.</p>
            </div>
          </article>
          <article class="tile">
            <img
              class="thumb-img" data-zoom
              src="/images/apply4/sonia-chopra-before-after.webp"
              alt="Dr. Sonia Chopra's Instagram profile before (19K followers) and after (31.1K followers)"
              width="1280"
              height="800"
              loading="lazy"
              decoding="async"
            />
            <div class="tile-body">
              <div class="who">Dr. Sonia Chopra · Endodontist</div>
              <div class="big">Following up about 50% in under 6 months</div>
              <p>One post pulled 1,500 comments, and the account now brings in thousands of qualified leads.</p>
            </div>
          </article>
          <article class="tile">
            <img
              class="thumb-img" data-zoom
              src="/images/apply4/rocco-piazza-featured.webp"
              alt="Dr. Rocco Piazza as a guest on one @theplasticsurgerychannel video: 615.8K views, 32.7K likes"
              width="1280"
              height="800"
              loading="lazy"
              decoding="async"
            />
            <div class="tile-body">
              <div class="who">Dr. Rocco Piazza · Plastic Surgeon</div>
              <div class="big">Featured on The Plastic Surgery Channel</div>
              <p>His guest appearance on one video reached 615K+ views, putting his breast-preservation approach in front of women actively researching surgery.</p>
            </div>
          </article>
        </div>
        <div class="quotes">
        <figure class="quote">
          <!-- Verbatim from Lily in her Slack channel, 2026-07-12. -->
          <blockquote>
            <p>“The first reel went so good!!!! Amazing job you guys. 500,000 views 🎉🎉”</p>
          </blockquote>
          <figcaption class="by">
            <img class="ph-img" src="/images/apply4/lily-baker-avatar.webp" alt="" width="36" height="36" loading="lazy" />
            Dr. Lily Baker · Chiropractor
          </figcaption>
        </figure>
        <figure class="quote">
          <!-- Verbatim from Lily in her Slack channel, 2026-07-15. -->
          <blockquote>
            <p>“Overall I am SO IMPRESSED by you guys. All the videos are amazing and you make me look so good! And your captions sound exactly like me.”</p>
          </blockquote>
          <figcaption class="by">
            <img class="ph-img" src="/images/apply4/lily-baker-avatar.webp" alt="" width="36" height="36" loading="lazy" />
            Dr. Lily Baker · Chiropractor
          </figcaption>
        </figure>
        </div>
        <p class="disclaimer">
          These are outcomes from clients who followed our process as built. Growth depends on
          execution and platform algorithms, and results vary by effort and market.
        </p>
      </div>
    </section>

    <!-- 7. FAQ -->
    <section style="padding-top:24px">
      <div class="wrap narrow">
        <p class="kicker">Questions</p>
        <h2>What doctors ask us</h2>
        <div class="faq">
          {
            faqs.map((f, i) => (
              <details open={i === 0}>
                <summary>{f.q}</summary>
                <p>{f.a}</p>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <!-- 8. REPEAT -->
    <section class="final glow">
      <div class="wrap">
        <h2>Doctors: <span class="hl">3,000 to 5,000 new followers a month</span>, <em>guaranteed.</em></h2>
        <div class="cta">
          <a class="btn" href="#apply">See If You Qualify</a>
          <p class="guarantee">{guaranteeLead} <b>{guaranteeBold}</b></p>
        </div>
      </div>
    </section>

    <dialog class="lightbox" aria-label="Image preview">
      <button class="lb-close" type="button" aria-label="Close">×</button>
      <img alt="" />
    </dialog>

    <footer>© Synchro Social</footer>
  </div>
</Layout>

<script is:inline define:vars={{ ICLOSED_URL }}>
  (function () {
    var form = document.querySelector(".dm .apply-form");
    if (!form) return;
    var card = form.closest(".form-card");
    var err = form.querySelector(".form-error");

    // iClosed skips its own form only when email/phone are valid, so send
    // phone in international format. Bare 10-digit numbers are assumed US.
    function normPhone(v) {
      var d = v.replace(/[^\d+]/g, "");
      if (d.charAt(0) === "+") return d;
      if (d.length === 10) return "+1" + d;
      if (d.length === 11 && d.charAt(0) === "1") return "+" + d;
      return d.length >= 8 ? "+" + d : "";
    }

    form.addEventListener("submit", function (e) {
      e.preventDefault();
      var f = new FormData(form);
      var v = {};
      ["name", "email", "phone", "instagram", "specialty", "investment", "start"].forEach(function (k) {
        v[k] = String(f.get(k) || "").trim();
      });
      v.instagram = v.instagram.replace(/^@+/, "");
      v.phone = normPhone(v.phone);
      var missing = Object.keys(v).filter(function (k) { return !v[k]; });
      var emailOk = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v.email);
      if (missing.length || !emailOk) {
        err.textContent = !emailOk && v.email
          ? "Please enter a valid email."
          : missing.indexOf("phone") > -1 && f.get("phone")
            ? "Please enter your phone number with country code, e.g. +1 555 123 4567."
            : "Please fill in every field.";
        err.hidden = false;
        return;
      }
      err.hidden = true;

      // Brief: fire the Meta pixel Lead event when the form is submitted.
      if (typeof window.fbq === "function") {
        fbq("track", "Lead", { content_name: "doctor_offer" });
      }

      // Under $2,000: a neutral thank-you, no calendar, never reaches iClosed.
      if (v.investment === "Under $2,000") {
        form.hidden = true;
        card.querySelector("h2").hidden = true;
        card.querySelector(".step-dq").hidden = false;
        return;
      }

      // iClosed expects %20 for spaces (encodeURIComponent), not "+".
      var q = [
        ["iclosedName", v.name],
        ["iclosedEmail", v.email],
        ["iclosedPhone", v.phone],
        // The iClosed questions' own Identifiers (auto-generated; shared with
        // the "For The Apply Page" event, so do not rename them in iClosed).
        ["specialty", v.specialty],
        ["instagram-handle-eg-yourhandle", v.instagram],
        ["how-much-are-you-ready-to-invest-per-month", v.investment],
        ["when-do-you-want-to-start", v.start],
      ];
      // Carry ad attribution through, as IClosedCapture does on other pages.
      new URLSearchParams(location.search).forEach(function (val, key) {
        if (/^utm_|^fbclid$|^test-pixel$/.test(key)) q.push([key, val]);
      });
      var url = ICLOSED_URL + "?" + q.map(function (kv) {
        return encodeURIComponent(kv[0]) + "=" + encodeURIComponent(kv[1]);
      }).join("&");

      var slot = card.querySelector(".form-embed");
      var w = document.createElement("div");
      w.className = "iclosed-widget";
      w.setAttribute("data-url", url);
      w.setAttribute("title", "Doctor Strategy Call");
      w.style.cssText = "width:100%;height:680px;";
      slot.appendChild(w);
      var sc = document.createElement("script");
      sc.src = "https://app.iclosed.io/assets/widget.js";
      sc.async = true;
      slot.appendChild(sc);

      form.hidden = true;
      card.querySelector("h2").textContent = "Pick a Time";
      card.querySelector(".step-cal").hidden = false;
      card.scrollIntoView({ behavior: "smooth", block: "start" });
    });
  })();

  // Proof images: hover hint + click/tap to view full screen.
  (function () {
    var lb = document.querySelector(".dm .lightbox");
    if (!lb || typeof lb.showModal !== "function") return;
    var big = lb.querySelector("img");
    document.querySelectorAll(".dm img[data-zoom]").forEach(function (img) {
      var wrap = document.createElement("button");
      wrap.type = "button";
      wrap.className = "zoom";
      wrap.setAttribute("aria-label", "View full screen: " + (img.alt || "image"));
      img.parentNode.insertBefore(wrap, img);
      wrap.appendChild(img);
      var icon = document.createElement("span");
      icon.className = "zoom-icon";
      icon.setAttribute("aria-hidden", "true");
      icon.innerHTML = '<svg viewBox="0 0 24 24"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/></svg>';
      wrap.appendChild(icon);
      wrap.addEventListener("click", function () {
        big.src = img.currentSrc || img.src;
        big.alt = img.alt;
        lb.showModal();
      });
    });
    lb.addEventListener("click", function () { lb.close(); });
  })();

  document.querySelectorAll(".dm .video-btn").forEach(function (btn) {
    btn.addEventListener("click", function () {
      var f = document.createElement("iframe");
      f.src = "https://fast.wistia.net/embed/iframe/" + btn.dataset.wistia + "?autoPlay=true&seo=false";
      f.allow = "autoplay; fullscreen";
      f.allowFullscreen = true;
      f.title = btn.getAttribute("aria-label");
      f.className = "thumb video-frame";
      btn.replaceWith(f);
    });
  });
</script>

<style is:global>
  /* Ported 1:1 from the mockup's stylesheet, scoped under .dm. */
  body.dm-body {
    margin: 0;
    background-color: #000;
    background-image:
      radial-gradient(1100px 560px at 50% 0, rgba(131, 49, 232, 0.16), rgba(0, 0, 0, 0)),
      linear-gradient(180deg, #070312 0px, #0e0620 520px, #1b0b38 950px, #0e0620 1400px, #000 1900px);
    background-repeat: no-repeat;
  }
  .dm {
    color-scheme: dark;
    --black: #000000;
    --card: #121212;
    --card-border: rgba(154, 93, 255, 0.14);
    --border: rgba(154, 93, 255, 0.16);
    --ink: #f4f1fa;
    --ink-dim: rgba(244, 241, 250, 0.62);
    --ink-faint: rgba(244, 241, 250, 0.38);
    --p: #9a5dff;
    --p-light: #d8c4ff;
    --p-deep: #5f1fae;
    --p-mid: #8331e8;
    --grad: linear-gradient(180deg, #d8c4ff, #8331e8 55%, #5f1fae);
    --grad-soft: linear-gradient(180deg, #f0e8ff, #c9a6ff 55%, #9a5dff);
    --glow: radial-gradient(900px 480px at 50% -10%, rgba(131, 49, 232, 0.14), rgba(0, 0, 0, 0));
    --need: #ffcf6b;
    --font: -apple-system, BlinkMacSystemFont, "SF Pro Text", "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    color: var(--ink);
    font-family: var(--font);
    font-size: 16px;
    line-height: 1.6;
    letter-spacing: -0.011em;
    text-align: center;
    -webkit-font-smoothing: antialiased;
  }
  .dm * { box-sizing: border-box; }
  .dm .wrap { max-width: 980px; margin: 0 auto; padding-inline: 20px; }
  .dm .narrow { max-width: 720px; }

  .dm .brand { padding-block: 28px 0; display: flex; justify-content: center; }
  .dm .brand img { width: 170px; height: auto; }

  .dm section { padding-block: 72px; }
  .dm .glow { background: var(--glow); }
  .dm .kicker { font-size: 12px; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: var(--p); margin: 0 0 18px; }
  .dm .hero .kicker { color: var(--ink); letter-spacing: 0.04em; font-size: 16px; }
  .dm h1, .dm h2, .dm h3 { margin: 0; text-wrap: balance; font-weight: 700; }
  .dm h1 { font-size: clamp(30px, 6vw, 72px); line-height: 1.05; letter-spacing: -0.03em; font-weight: 800; }
  .dm h1 .line { display: block; white-space: nowrap; }
  @media (max-width: 700px) { .dm h1 .line { white-space: normal; } }
  .dm .hero .wrap { max-width: 1200px; }
  .dm .hl {
    background: var(--grad-soft);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    text-decoration: underline 3px var(--p-light);
    -webkit-text-decoration: underline 3px var(--p-light);
    text-underline-offset: 6px;
  }
  .dm h2 { font-size: clamp(26px, 4vw, 38px); line-height: 1.15; letter-spacing: -0.02em; }
  .dm h3 { font-size: 18px; }
  .dm .sub { font-size: 18px; color: rgba(244, 241, 250, 0.9); max-width: 640px; margin: 28px auto 0; }

  .dm .hero { padding-block: 48px 36px; }
  .dm .cta { display: flex; flex-direction: column; align-items: center; gap: 14px; margin-top: 32px; }
  .dm .btn {
    display: inline-block;
    background: var(--grad);
    color: #fff;
    font-family: inherit;
    font-weight: 700;
    font-size: 16px;
    padding: 16px 36px;
    border-radius: 999px;
    text-decoration: none;
    border: 0;
    cursor: pointer;
    box-shadow: 0 10px 30px rgba(131, 49, 232, 0.35);
  }
  .dm .btn:focus-visible { outline: 3px solid var(--p-light); outline-offset: 3px; }
  .dm .guarantee { font-size: 15px; color: rgba(244, 241, 250, 0.9); max-width: 46ch; margin: 0; }
  .dm .guarantee b { color: var(--ink); font-weight: 600; }
  .dm .need { display: inline-block; border: 1px dashed var(--need); color: var(--need); font-size: 12px; font-weight: 600; padding: 3px 9px; border-radius: 6px; background: rgba(255, 207, 107, 0.07); }

  .dm .apply { padding-top: 8px; }

  /* form */
  .dm .form-card {
    scroll-margin-top: 16px;
    background: var(--card);
    border: 1px solid var(--card-border);
    border-radius: 16px;
    padding: 34px;
    max-width: 640px;
    margin: 0 auto;
    text-align: left;
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.5), 0 2px 8px rgba(0, 0, 0, 0.3);
  }
  .dm .form-card h2 { font-size: 24px; text-align: center; margin-bottom: 24px; }
  .dm .form-embed { border-radius: 12px; overflow: hidden; }
