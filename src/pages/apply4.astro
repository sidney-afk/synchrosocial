---
/* ===========================================================================
   /apply4 — doctor offer page for cold Meta ads.

   Built from the owner's brief ("Doctor Offer Page: Brief for Sidney",
   2026-09-27): doctor-only offer, follower guarantee, short page, no VSL and
   no founder video. Look and feel reuse the /apply2 + /apply3 design system
   (src/styles/vsl.css): black, Synchro purple, system font, pill buttons.

   Section order (from the brief, top to bottom):
     1 top section  2 Lily proof card  3 application form (iClosed)
     4 stats bar    5 how it works     6 doctor results
     7 FAQ          8 headline + button repeated

   Form: an iClosed event with its own questions and a disqualifier for
   "Under $2,000" a month. Set ICLOSED_PREFIX once that event exists; until
   then IClosedEmbed shows its placeholder. The booking fires `Lead` through
   the IClosedEmbed pixel bridge, same as every other apply page.

   Items marked with .a4-todo are content still owed by Kasper (see the
   brief's last section). Replace them before ad traffic goes live.
=========================================================================== */
import Layout from "../layouts/Layout.astro";
import VslButton from "../components/VslButton.astro";
import IClosedEmbed from "../components/IClosedEmbed.astro";
import VslProofBar from "../components/VslProofBar.astro";
import VslRealResults from "../components/VslRealResults.astro";
import VslHowItWorks from "../components/VslHowItWorks.astro";
import "../styles/vsl.css";

// iClosed "Doctor Strategy Call" event (disqualifies "Under $2,000" a month).
const ICLOSED_PREFIX: string | null = "synchrosocial/doctor-strategy-call";

const ctaLabel = "See If You Qualify";
const eyebrow = "For doctors, dentists, chiropractors, and surgeons";
const sub =
  "We film you for 2-3 hours a month with scripts we create and you approve. We edit and post, and bring you followers who want what you offer.";
const guarantee =
  "If we don't hit the monthly follower target we set for you in your first 3 months, we keep working for free until we do.";

const stats = [
  { label: "Reach", metric: "1.2B+", copy: "Views generated for our clients" },
  { label: "Growth", metric: "8M+", copy: "Followers grown across platforms" },
  { label: "Leads", metric: "150K+", copy: "Over 150,000 leads generated for clients" },
];

const steps = [
  {
    features: [
      {
        title: "We set your target",
        body: "On a strategy call we review your account and set your monthly follower target.",
      },
      {
        title: "We film you",
        body: "2-3 hours a month, with the strategy and scripts we create and you approve.",
      },
      {
        title: "We edit and post",
        body: "Your first post goes live 2 to 3 weeks after you start, with weekly reports on every video.",
        final: true,
      },
    ],
  },
];

// Copy verbatim from the brief's mockup.
const lily = {
  name: "Dr. Lily Baker · Chiropractor",
  stat: "60K New Followers in Under 90 Days",
  story: "Grew from 90K to 150K followers with 12M views. One reel brought in over 17,000 new followers alone.",
};
const doctors = [
  { ...lily, placeholder: "Video testimonial or Instagram screenshot" },
  {
    name: "Dr. Sonia Chopra · Endodontist",
    stat: "Following up about 50% in under 6 months",
    story: "One post pulled 1,500 comments, and the account now brings in thousands of qualified leads.",
    wistia: "vr83s40k0b",
    poster: "/images/campaign-proof/11-dr-sonia-chopra.webp",
  },
  {
    name: "Dr. Rocco Piazza or Dr. John Baker",
    stat: "Results needed",
    story: "Pick one doctor.",
    placeholder: "Video testimonial or Instagram screenshot",
  },
];

const faqs = [
  {
    q: "What do you do?",
    a: "We run your short-form content from start to finish: strategy, filming plans, scripts, editing, posting on all your platforms, and weekly reports.",
  },
  {
    q: "What do I need to do?",
    a: "Film about once a month. We tell you exactly what to say.",
  },
  {
    q: "How does the guarantee work?",
    a: "On your strategy call we set your monthly follower target based on your account. If we don't hit it in your first 3 months, we keep working for free until we do.",
  },
  {
    q: "Does this work for my specialty?",
    a: "Yes. The same system works across specialties. No skits or trends you're not comfortable with.",
  },
  {
    q: "What about patient privacy?",
    a: "We follow platform health-content guidelines and never show patients or patient information. You approve every post before it goes live.",
  },
  {
    q: "When will I see results?",
    a: "Your first post goes live 2 to 3 weeks after you start. Month one tests a wide range of angles. From month two, we double down on what's working.",
  },
  {
    // Owner: no price on the page. Mockup left this answer open.
    q: "What does it cost?",
    a: "We go over pricing on your strategy call, once we've set your target.",
  },
];
---

<Layout
  title="For Doctors: 3,000 to 5,000 New Followers a Month, Guaranteed | Synchro Social"
  description="We film you for 2-3 hours a month, edit and post, and bring you followers who want what you offer. Guaranteed."
  bodyClass="vsl"
  metaEvent={{ name: "ViewContent", params: { content_name: "doctor_offer" } }}
>
  <!-- 1. Top section: VslHero geometry -->
  <header class="a4h">
    <div class="a4h__wrap">
      <img class="a4h__logo" src="/images/logo-updated.png" alt="Synchro Social" width="170" height="36" />
      <p class="a4h__eyebrow">{eyebrow}</p>
      <h1 class="a4h__headline">
        We'll get you 3,000 to 5,000 new followers a month.{" "}
        <span class="a4h__accent">Guaranteed.</span>
      </h1>
      <p class="a4h__sub">{sub}</p>
      <VslButton label={ctaLabel} href="#apply" variant="pill" />
      <p class="a4h__guarantee">{guarantee}</p>
    </div>
  </header>

  <!-- 2. Lily proof card: VslRealResults card shell -->
  <section class="a4-lily" aria-label="Client result">
    <div class="a4-card">
      <div class="a4-lily__shots">
        <div class="a4-shot"><span class="a4-todo">Instagram profile screenshot<br />150K followers visible</span></div>
        <div class="a4-shot"><span class="a4-todo">Reel insights screenshot<br />17,000+ followers from one reel</span></div>
      </div>
      <div class="a4-lily__title">{lily.name}</div>
      <div class="a4-lily__stat">{lily.stat}</div>
      <p class="a4-lily__story">{lily.story}</p>
    </div>
  </section>

  <!-- 3. Application form -->
  <section id="apply" class="a4-form">
    <div class="a4-head">
      <h2>See If You Qualify</h2>
    </div>
    <div class="a4-form__embed">
      <IClosedEmbed
        linkPrefix={ICLOSED_PREFIX}
        title="Doctor Strategy Call"
        height="620px"
        card={false}
        resize={false}
      />
    </div>
    <!-- A2P 10DLC consent disclosure, carried over from /apply2 and /apply3.
         See docs/booking-recovery/TWILIO_RUNBOOK.md before changing. -->
    <p class="a4-legal">
      By booking a call you agree to receive text messages from Synchro Social about your
      call. Message frequency varies, typically one message per booking. Message and data
      rates may apply. Reply STOP to opt out, HELP for help. See our
      <a href="/privacypolicy" target="_blank" rel="noopener noreferrer">Privacy Policy</a>
      and
      <a href="/terms-conditions" target="_blank" rel="noopener noreferrer">Terms</a>.
    </p>
  </section>

  <!-- 4. Stats bar -->
  <div class="a4-stats">
    <VslProofBar items={stats} />
  </div>

  <!-- 5. How it works -->
  <div class="a4-how">
  <VslHowItWorks
    eyebrow="How it works"
    titleLead="From your first call to your first post"
    titleAccent=""
    sub=""
    pillars={steps}
    ctaLabel=""
  />
  </div>

  <!-- 6. Doctor results -->
  <VslRealResults
    eyebrow="Doctor results"
    heading="Doctors we've grown"
    cards={doctors}
    disclaimer="These are outcomes from clients who followed our process as built. Growth depends on execution and platform algorithms, and results vary by effort and market."
  >
    <figure class="a4-quote a4-card">
      <span class="a4-todo">Written quote from a doctor client<br />Name · Specialty · photo</span>
    </figure>
  </VslRealResults>

  <!-- 7. FAQ -->
  <section class="a4-faq">
    <div class="a4-head">
      <div class="a4-eyebrow">Questions</div>
      <h2>What doctors ask us</h2>
    </div>
    <div class="a4-faq__list">
      {
        faqs.map((f) => (
          <details class="a4-card a4-faq__item">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))
      }
    </div>
  </section>

  <!-- 8. Repeat -->
  <section class="a4h a4h--end">
    <div class="a4h__wrap">
      <h2 class="a4h__headline">
        Doctors: 3,000 to 5,000 new followers a month, <span class="a4h__accent">guaranteed.</span>
      </h2>
      <VslButton label={ctaLabel} href="#apply" variant="pill" />
      <p class="a4h__guarantee">{guarantee}</p>
    </div>
  </section>
</Layout>

<script is:inline>
  document.body.dataset.vslPage = "doctor_offer";
</script>

<style>
  /* Every value below is lifted from the /apply3 components (VslHero,
     VslRealResults, VslProofBar) so the two pages read as one system. */

  /* ---------- Hero (VslHero) ---------- */
  .a4h {
    width: 100%;
    background: var(--vsl-black);
  }
  .a4h__wrap {
    max-width: 900px;
    margin: 0 auto;
    padding: 56px 24px 48px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .a4h__logo {
    width: 170px;
    height: auto;
    display: block;
    margin-bottom: 40px;
  }
  .a4h__eyebrow {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--vsl-p);
    margin: 0 auto 18px;
    padding: 0 12px;
  }
  .a4h__headline {
    font-size: clamp(28px, 5vw, 46px);
    font-weight: 600;
    line-height: 1.14;
    letter-spacing: -0.022em;
    margin: 0 auto 30px;
    max-width: 34ch;
    color: var(--vsl-ink);
  }
  .a4h__accent {
    background: var(--vsl-accent-grad-soft);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    text-decoration: underline;
    text-decoration-color: var(--vsl-p-light);
    text-decoration-thickness: 3px;
    text-underline-offset: 6px;
  }
  .a4h__sub {
    font-size: clamp(15.5px, 1.9vw, 19px);
    line-height: 1.55;
    color: var(--vsl-ink-dim);
    max-width: 82ch;
    margin: 0 auto 32px;
  }
  .a4h__guarantee {
    font-size: 13px;
    line-height: 1.6;
    color: var(--vsl-ink-dim);
    max-width: 480px;
    margin: 18px auto 0;
  }
  .a4h--end .a4h__wrap {
    padding-top: 24px;
    padding-bottom: 90px;
  }
  .a4h--end .a4h__headline {
    font-size: clamp(26px, 4vw, 38px);
    line-height: 1.16;
  }


  @media (prefers-reduced-motion: no-preference) {
    .a4h:not(.a4h--end) .a4h__wrap > * {
      transform: translateY(8px);
      animation: a4Rise 0.45s cubic-bezier(0.22, 0.61, 0.36, 1) forwards;
    }
    .a4h__wrap > :nth-child(2) { animation-delay: 0.03s; }
    .a4h__wrap > :nth-child(3) { animation-delay: 0.06s; }
    .a4h__wrap > :nth-child(4) { animation-delay: 0.09s; }
    .a4h__wrap > :nth-child(5) { animation-delay: 0.11s; }
    .a4h__wrap > :nth-child(6) { animation-delay: 0.14s; }
  }
  @keyframes a4Rise {
    to { transform: translateY(0); }
  }

  /* ---------- Shared card + section head (VslRealResults) ---------- */
  .a4-card {
    background: var(--vsl-card);
    border: 1px solid var(--vsl-card-border);
    border-radius: 16px;
    transition: border-color 0.22s ease, background 0.22s ease;
  }
  .a4-card:hover {
    border-color: rgba(154, 93, 255, 0.36);
    background: #16131b;
  }
  .a4-head {
    max-width: 720px;
    margin: 0 auto 48px;
    text-align: center;
  }
  .a4-eyebrow {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--vsl-p);
    margin-bottom: 16px;
  }
  .a4-head h2 {
    font-size: clamp(26px, 4vw, 38px);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.16;
    margin: 0;
    color: var(--vsl-ink);
  }
  .a4-todo {
    display: inline-block;
    padding: 6px 10px;
    border: 1.5px dashed #f5c542;
    border-radius: 8px;
    color: #f5c542;
    font-size: 12px;
    font-weight: 600;
    line-height: 1.4;
    text-align: center;
  }

  /* ---------- 2. Lily ---------- */
  .a4-lily {
    padding: 0 20px;
  }
  .a4-lily .a4-card {
    max-width: 856px;
    margin: 0 auto;
    padding: 26px 26px 24px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    text-align: left;
  }
  .a4-lily__title {
    font-size: clamp(19px, 2.2vw, 22px);
    font-weight: 700;
    letter-spacing: -0.015em;
    line-height: 1.28;
  }
  .a4-lily__stat {
    font-size: clamp(24px, 2.6vw, 28px);
    font-weight: 700;
    letter-spacing: -0.015em;
    line-height: 1.15;
    background: var(--vsl-accent-grad);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .a4-lily__story {
    font-size: 14.5px;
    line-height: 1.6;
    color: rgba(244, 241, 250, 0.8);
    margin: 0;
  }
  .a4-lily__shots {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
  }
  .a4-shot {
    aspect-ratio: 4 / 5;
    max-height: 320px;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 12px;
    border-radius: 12px;
    background: #0a0a0a;
    border: 1px solid var(--vsl-card-border);
  }

  /* ---------- 3. Form ---------- */
  /* Brief: black top, deep purple around the form, back to black. Same
     radial wash VslHowItWorks uses, a little stronger. */
  .a4-form {
    padding: 72px 20px 44px;
    background:
      radial-gradient(ellipse 900px 600px at 50% 45%, rgba(131, 49, 232, 0.22), transparent 70%),
      var(--vsl-black);
  }
  .a4-form__embed {
    width: 100%;
    max-width: 760px;
    margin: 0 auto;
  }
  .a4-legal {
    max-width: 620px;
    margin: 14px auto 0;
    text-align: center;
    font-size: 12px;
    line-height: 1.55;
    color: var(--vsl-ink-faint);
  }
  .a4-legal a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .a4-legal a:hover {
    color: var(--vsl-ink-dim);
  }

  /* ---------- 5. How it works ---------- */
  /* VslHowItWorks paints its radial wash inside its own 520px column, which
     reads as a small purple box on a full-width black page. Drop it here. */
  .a4-how :global(.vslhiw) {
    background: var(--vsl-black);
  }
  /* No subheadline here (mockup has none), so the title takes its gap. */
  .a4-how :global(.vslhiw__title) {
    margin-bottom: 52px;
  }

  /* ---------- 6. Quote ---------- */
  .a4-quote {
    max-width: 856px;
    margin: 18px auto 0;
    padding: 26px;
    text-align: center;
  }

  /* ---------- 7. FAQ ---------- */
  .a4-faq {
    padding: 56px 20px 24px;
    background: var(--vsl-black);
  }
  .a4-faq__list {
    max-width: 720px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .a4-faq__item {
    padding: 0 22px;
    text-align: left;
  }
  .a4-faq__item summary {
    cursor: pointer;
    list-style: none;
    position: relative;
    padding: 20px 32px 20px 0;
    font-size: 16px;
    font-weight: 700;
    line-height: 1.35;
    letter-spacing: -0.01em;
    color: var(--vsl-ink);
  }
  .a4-faq__item summary::-webkit-details-marker {
    display: none;
  }
  .a4-faq__item summary::after {
    content: "+";
    position: absolute;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
    font-size: 22px;
    font-weight: 400;
    color: var(--vsl-p);
  }
  .a4-faq__item[open] summary::after {
    content: "−";
  }
  .a4-faq__item p {
    margin: 0 0 20px;
    font-size: 14.5px;
    line-height: 1.6;
    color: rgba(244, 241, 250, 0.8);
  }

  /* ---------- Phone (VslHero / VslRealResults 600px breakpoint) ---------- */
  @media (max-width: 600px) {
    .a4h__wrap { padding: 40px 18px 36px; }
    .a4h__logo { width: 150px; margin-bottom: 28px; }
    .a4h__eyebrow { font-size: 10px; letter-spacing: 0.16em; margin-bottom: 14px; }
    .a4h__headline {
      font-size: clamp(28px, 8.6vw, 36px);
      max-width: 20ch;
      line-height: 1.2;
      margin-bottom: 22px;
    }
    .a4h__sub { font-size: 15.5px; margin-bottom: 28px; }
    .a4h--end .a4h__wrap { padding-bottom: 56px; }
    .a4h--end .a4h__headline { font-size: clamp(22px, 6.5vw, 28px); }
    .a4-lily { padding: 0 14px; }
    .a4-lily .a4-card { padding: 20px 18px; border-radius: 14px; }
    .a4-lily__stat { font-size: 22px; }
    .a4-lily__shots { gap: 10px; }
    .a4-form { padding: 52px 14px 32px; }
    .a4-head { margin-bottom: 28px; }
    .a4-head h2 { font-size: clamp(22px, 6.5vw, 28px); }
    .a4-faq { padding: 40px 14px 16px; }
    .a4-faq__item { padding: 0 18px; border-radius: 14px; }
    .a4-faq__item summary { font-size: 15px; }
    .a4-faq__item p { font-size: 13.5px; }
  }
</style>
