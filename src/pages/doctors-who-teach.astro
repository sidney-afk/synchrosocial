</Layout>

<script is:inline define:vars={{ ICLOSED_URL, PRICE_KEY, FIT_KEY, PAGE, OFFER }}>
  (function () {
    var form = document.querySelector(".dm .apply-form");
    if (!form) return;
    var card = form.closest(".form-card");
    var err = form.querySelector(".form-error");

    // iClosed skips its own form only when email/phone are valid, so send
    // phone in international format. Bare 10-digit numbers are assumed US.
    function normPhone(v) {
      var d = v.replace(/[^\d+]/g, "");
      if (d.charAt(0) === "+") return d;
      if (d.length === 10) return "+1" + d;
      if (d.length === 11 && d.charAt(0) === "1") return "+" + d;
      return d.length >= 8 ? "+" + d : "";
    }

    // Partial-lead capture. A doctor who has typed a valid email but leaves before
    // pressing Submit would otherwise be lost: nothing reaches iClosed until step 2.
    // As soon as the email is valid we send what they have to the
    // doctors-partial-capture edge function (shared with /doctors; "page" says which), which arms a recovery follow-up in n8n:
    // an email, plus a text when a phone number was typed (the step-1 form shows an
    // SMS consent line directly under the phone field, so sms_consent below records
    // that it was shown; n8n sends no text without it AND a valid phone).
    // It is sent again whenever anything on the form changes (phone, answers, ...), so n8n
    // updates the one saved row instead of adding a second, and moves the first follow-up
    // back: it is due 20 minutes after the LAST change. Answering "Not right now"
    // is sent too: n8n cancels any follow-up already armed and arms nothing.
    // Fires on "change" (a field committed or a radio picked), never on each
    // keystroke, so half-typed addresses are never sent. Sends go one at a time, in
    // order. No pixel events here (DoctorEmailEntered is sent separately, below).
    var PARTIAL_URL = "https://uzltbbrjidmjwwfakwve.supabase.co/functions/v1/doctors-partial-capture";
    var submitted = false;
    var partialSent = "";   // the form as last sent: an unchanged form is never re-sent
    var partialEmail = "";  // the email a follow-up was last armed for
    var partialQueue = Promise.resolve();
    var partialTimer = null;
    function maybeSendPartial(force) {
      if (submitted && !force) return;
      var f = new FormData(form);
      var email = String(f.get("email") || "").trim();
      var investment = String(f.get("investment") || "");
      var phone = normPhone(String(f.get("phone") || "").trim());
      if (phone.replace(/\D/g, "").length < 10) phone = ""; // a half-typed number is not a number: no text to it
      if (!/^[^\s@]+@[^\s@]+\.[A-Za-z]{2,}$/.test(email)) return;
      var qs = new URLSearchParams(location.search);
      var body = {
        name: String(f.get("name") || "").trim(),
        email: email,
        phone: phone,
        instagram: String(f.get("instagram") || "").trim().replace(/^@+/, ""),
        specialty: String(f.get("specialty") || ""),
        investment: investment,
        fit: String(f.get("fit") || ""),
        page: PAGE,
        website: String(f.get("website") || ""),
        referrer: document.referrer || "",
        sms_consent: document.querySelector(".sms-consent") ? "yes" : "",
      };
      try { body.timezone = Intl.DateTimeFormat().resolvedOptions().timeZone || ""; } catch (err2) {}
      ["utm_source", "utm_medium", "utm_campaign", "utm_content", "fbclid"].forEach(function (k) {
        if (qs.get(k)) body[k] = qs.get(k);
      });
      var sig = JSON.stringify(body);
      if (sig === partialSent) return;
      partialSent = sig;
      // The visitor changed the address (a typo fixed): cancel the follow-up armed for the old one.
      if (partialEmail && partialEmail !== email.toLowerCase()) {
        var gone = { email: partialEmail, investment: "Not right now" };
        if (qs.get("utm_source")) gone.utm_source = qs.get("utm_source");
        partialQueue = partialQueue.then(function () {
          return fetch(PARTIAL_URL, { method: "POST", keepalive: true, headers: { "Content-Type": "application/json" }, body: JSON.stringify(gone) }).catch(function () {});
        });
      }
      partialEmail = email.toLowerCase();
      partialQueue = partialQueue.then(function () {
        return fetch(PARTIAL_URL, {
          method: "POST",
          keepalive: true,
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(body),
        }).then(function (res) { if (!res.ok && partialSent === sig) partialSent = ""; })
          .catch(function () { if (partialSent === sig) partialSent = ""; });
      });
    }
    form.addEventListener("change", function () {
      clearTimeout(partialTimer);
      partialTimer = setTimeout(maybeSendPartial, 800);
      maybeSendEmailEvent();
    });

    // Meta DoctorEmailEntered: the visitor has typed a valid email, before Submit.
    // An earlier signal than Lead (which only fires on Submit, the same moment as the
    // booking), so Meta has more to learn from. Once per browser session, never for
    // test traffic (a test visit has a do-nothing fbq; a test email is skipped here).
    // Only content_name is sent: never the email itself.
    var emailEventSent = false;
    try { emailEventSent = sessionStorage.getItem("mp_educator_email") === "1"; } catch (e1) {}
    function maybeSendEmailEvent() {
      if (emailEventSent || submitted) return;
      var email = String(new FormData(form).get("email") || "").trim();
      if (!/^[^\s@]+@[^\s@]+\.[A-Za-z]{2,}$/.test(email)) return;
      if (typeof window.__metaIsTestEmail === "function" && window.__metaIsTestEmail(email)) return;
      if (typeof window.__metaTrack !== "function") return;
      emailEventSent = true;
      try { sessionStorage.setItem("mp_educator_email", "1"); } catch (e2) {}
      window.__metaTrack("DoctorEmailEntered", { content_name: OFFER }, { custom: true });
    }

    form.addEventListener("submit", function (e) {
      e.preventDefault();
      var f = new FormData(form);
      var v = {};
      ["name", "email", "phone", "instagram", "specialty", "investment", "fit"].forEach(function (k) {
        v[k] = String(f.get(k) || "").trim();
      });
      v.instagram = v.instagram.replace(/^@+/, "");
      v.phone = normPhone(v.phone);
      var missing = Object.keys(v).filter(function (k) { return !v[k]; });
      var emailOk = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v.email);
      if (missing.length || !emailOk) {
        var labels = { name: "your name", email: "your email", phone: "your phone number", instagram: "your Instagram handle", specialty: "your specialty", investment: "whether $3,000 a month is within reach", fit: "where you are today" };
        err.textContent = !emailOk && v.email
          ? "Please enter a valid email."
          : missing.indexOf("phone") > -1 && f.get("phone")
            ? "Please enter your phone number with country code, e.g. +1 555 123 4567."
            : "Please fill in: " + missing.map(function (k) { return labels[k]; }).join(", ") + ".";
        err.hidden = false;
        // On a phone the message sits under the button, off screen: bring the first thing to fix into view.
        if (window.matchMedia("(max-width: 560px)").matches) {
          var firstBad = missing.length ? missing[0] : "email";
          var bad = form.querySelector('[name="' + firstBad + '"]');
          var spot = bad && (bad.closest(".field") || bad);
          if (spot) spot.scrollIntoView({ behavior: "auto", block: "center" });
        }
        return;
      }
      err.hidden = true;
      submitted = true; // a real submit: stop the partial-lead capture above

      // Not right now: a neutral thank-you, no calendar, never reaches iClosed.
      if (v.investment === "Not right now") {
        clearTimeout(partialTimer);
        maybeSendPartial(true); // cancels any follow-up already armed (a no-op if already sent)
        if (typeof window.clarity === "function") clarity("event", "form_not_right_now");
        form.hidden = true;
        card.querySelector("h2").hidden = true;
        card.querySelector(".step-dq").hidden = false;
        return;
      }

      // Meta Lead fires only for people who are NOT "Not right now", and never for test
      // traffic: a ?utm_source=test visit already has a do-nothing fbq (MetaPixel.astro),
      // and a sidney.laruel+anything@gmail.com email is skipped here.
      var isTestEmail = typeof window.__metaIsTestEmail === "function" && window.__metaIsTestEmail(v.email);
      if (!isTestEmail) {
        if (typeof window.__metaTrack === "function") window.__metaTrack("Lead", { content_name: OFFER });
        else if (typeof window.fbq === "function") fbq("track", "Lead", { content_name: OFFER });
      }
      if (typeof window.clarity === "function") clarity("event", "form_qualified_submit");

      // Tell n8n they pressed Submit: it sends the booking link by email (and by text
      // with consent, 08:00-18:00 their time) right away and moves the recovery nudge
      // to 30 minutes out. Same relay as the partial capture; submitted=yes routes it.
      try {
        var sub = {
          name: v.name, email: v.email, phone: v.phone, instagram: v.instagram,
          specialty: v.specialty, investment: v.investment, fit: v.fit, page: PAGE,
          website: String(f.get("website") || ""),
          referrer: document.referrer || "",
          sms_consent: document.querySelector(".sms-consent") ? "yes" : "",
          submitted: "yes",
        };
        try { sub.timezone = Intl.DateTimeFormat().resolvedOptions().timeZone || ""; } catch (err4) {}
        var sq = new URLSearchParams(location.search);
        ["utm_source", "utm_medium", "utm_campaign", "utm_content", "fbclid"].forEach(function (k) {
          if (sq.get(k)) sub[k] = sq.get(k);
        });
        fetch(PARTIAL_URL, {
          method: "POST",
          keepalive: true,
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(sub),
        }).catch(function () {});
      } catch (err5) {}

      // iClosed expects %20 for spaces (encodeURIComponent), not "+".
      var q = [
        ["iclosedName", v.name],
        ["iclosedEmail", v.email],
        ["iclosedPhone", v.phone],
        // The iClosed questions' own Identifiers (auto-generated; shared with
        // the "For The Apply Page" event, so do not rename them in iClosed).
        ["specialty", v.specialty],
        ["instagram-handle-eg-yourhandle", v.instagram],
        [PRICE_KEY, v.investment],
        [FIT_KEY, v.fit],
      ];
      // Carry ad attribution through, as IClosedCapture does on other pages.
      new URLSearchParams(location.search).forEach(function (val, key) {
        if (/^utm_|^fbclid$|^test-pixel$/.test(key)) q.push([key, val]);
      });
      var url = ICLOSED_URL + "?" + q.map(function (kv) {
        return encodeURIComponent(kv[0]) + "=" + encodeURIComponent(kv[1]);
      }).join("&");

      var slot = card.querySelector(".form-embed");
      var w = document.createElement("div");
      w.className = "iclosed-widget";
      w.setAttribute("data-url", url);
      w.setAttribute("title", "Educator Strategy Call");
      w.style.cssText = "width:100%;height:680px;";
      slot.appendChild(w);
      var sc = document.createElement("script");
      sc.src = "https://app.iclosed.io/assets/widget.js";
      sc.async = true;
      slot.appendChild(sc);

      form.hidden = true;
      card.querySelector("h2").textContent = "Pick a Time";
      var first = String(v.name || "").trim().split(/\s+/)[0];
      var calNote = document.getElementById("cal-note");
      if (calNote && first) calNote.textContent = "Thanks, " + first + ". Last step: pick a time for our call.";
      card.querySelector(".step-cal").hidden = false;
      card.scrollIntoView({ behavior: "auto", block: "start" });

      // iClosed scrolls the page down by itself about 5 seconds after it loads, which hides the
      // "Pick a Time" heading. For 10 seconds, until the person touches, scrolls or types, keep
      // the top of the card in view.
      if (window.matchMedia("(max-width: 560px)").matches) {
        var touched = false;
        var mark = function () { touched = true; };
        ["touchstart", "wheel", "keydown", "mousedown"].forEach(function (n) { window.addEventListener(n, mark, { passive: true, once: true }); });
        var guard = setInterval(function () {
          if (touched) { clearInterval(guard); return; }
          if (card.getBoundingClientRect().top < -2) card.scrollIntoView({ behavior: "auto", block: "start" });
        }, 120);
        setTimeout(function () { clearInterval(guard); }, 10000);
      }
    });
  })();

  // "#apply" buttons: jump to the form at once (no slow smooth scroll: it read as "nothing
  // happened" in Clarity), without adding "#apply" to the URL.
  document.querySelectorAll('.dm a[href="#apply"]').forEach(function (a) {
    a.addEventListener("click", function (e) {
      var t = document.getElementById("apply");
      if (!t) return;
      e.preventDefault();
      t.scrollIntoView({ behavior: "auto", block: "start" });
    });
  });

  // Proof line and cards under the form: jump down to "Clients we've grown". The href
  // is a real in-page link, so it still works if this script has not run.
  document.querySelectorAll('.dm a[href="#results"]').forEach(function (a) {
    a.addEventListener("click", function (e) {
      var t = document.getElementById("results");
      if (!t || !t.scrollIntoView) return;
      e.preventDefault();
      t.scrollIntoView({ behavior: "auto", block: "start" });
    });
  });

  // Answer buttons: a tap on one that is already selected used to change nothing and was
  // counted as a dead click. Give every tap a visible pulse, selected or not.
  document.querySelectorAll(".dm .chips label").forEach(function (l) {
    l.addEventListener("click", function () {
      l.classList.remove("tapped");
      void l.offsetWidth;
      l.classList.add("tapped");
    });
  });
  // An (empty) touch listener makes iOS apply :active styles at once.
  document.addEventListener("touchstart", function () {}, { passive: true });

  // Videos: connect to Wistia just before the videos scroll into view, and on tap
  // load the player on top of the thumbnail inside the same 16:9 box, so nothing
  // shifts and the thumbnail stays until the player is ready.
  (function () {
    var warmed = false;
    function warm() {
      if (warmed) return;
      warmed = true;
      ["https://fast.wistia.net", "https://fast.wistia.com", "https://embed-ssl.wistia.com"].forEach(function (h) {
        var l = document.createElement("link");
        l.rel = "preconnect";
        l.href = h;
        l.crossOrigin = "anonymous";
        document.head.appendChild(l);
      });
    }
    var vids = document.querySelector(".dm .floatvids");
    if (vids && "IntersectionObserver" in window) {
      new IntersectionObserver(function (e, o) { if (e[0].isIntersecting) { warm(); o.disconnect(); } }, { rootMargin: "1200px 0px" }).observe(vids);
    }
    document.querySelectorAll(".dm .video-btn").forEach(function (btn) {
      btn.addEventListener("pointerenter", warm, { once: true });
      btn.addEventListener("touchstart", warm, { once: true, passive: true });
      btn.addEventListener("click", function () {
        warm();
        var f = document.createElement("iframe");
        f.src = "https://fast.wistia.net/embed/iframe/" + btn.dataset.wistia + "?autoPlay=true&seo=false&playerColor=178af6";
        f.allow = "autoplay; fullscreen";
        f.allowFullscreen = true;
        f.title = btn.getAttribute("aria-label");
        f.className = "video-overlay";
        f.addEventListener("load", function () { btn.classList.add("is-playing"); });
        btn.appendChild(f);
        btn.setAttribute("aria-disabled", "true");
      }, { once: true });
    });
  })();
</script>

<script is:inline>
  // Phone: note when a form field has the keyboard open, so the top menu bar can get out of the way (CSS only acts at phone widths).
  (function () {
    var f = document.querySelector(".apply-form");
    if (!f) return;
    var root = document.documentElement;
    f.addEventListener("focusin", function (e) { if (e.target.matches("input")) root.classList.add("kb-open"); });
    f.addEventListener("focusout", function () { root.classList.remove("kb-open"); });
  })();
</script>

<script is:inline define:vars={{ CLARITY_ID }}>
  // Microsoft Clarity (free): scroll depth, clicks and where visitors leave.
  // Does nothing until CLARITY_ID (top of this file) is filled in. Loads after
  // the page has finished loading so it never competes with the first paint.
  // The form is masked (data-clarity-mask on the <form>), so nothing typed or
  // picked in it is recorded. The events below carry no personal details.
  (function () {
    if (!CLARITY_ID) return;
    // Queue and listeners are set up at once so an early tap is not lost;
    // only the download of Clarity's own script waits for the load event.
    window.clarity = window.clarity || function () { (window.clarity.q = window.clarity.q || []).push(arguments); };
    window.addEventListener("load", function () {
      var t = document.createElement("script");
      t.async = true;
      t.src = "https://www.clarity.ms/tag/" + CLARITY_ID;
      document.head.appendChild(t);
    });

    var form = document.querySelector(".dm .apply-form");
    if (form) {
      var started = false;
      form.addEventListener("focusin", function () {
        if (started) return;
        started = true;
        clarity("event", "form_started");
      });
    }
    // The videos play inside Wistia's frame, which Clarity cannot see into,
    // so count the tap on our play button instead.
    document.querySelectorAll(".dm .video-btn").forEach(function (btn) {
      btn.addEventListener("click", function () { clarity("event", "video_play"); });
    });
  })();
</script>

<style is:global>
