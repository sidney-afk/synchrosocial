---
/* ===========================================================================
   /educators: test landing page for the new "doctors who teach" ads (21 Oct 2026).

   A copy of /doctors with its own data, so the two pages can be compared. Built
   from the same script, so the form, the "Not right now" rule, the unfinished-form
   save, the DoctorEmailEntered event, click ids and Clarity events behave the same.
   What is different, all deliberate:
     - Hidden from search (Layout noindex).
     - Own calendar (educator-strategy-call) and own Meta content_name
       (educator_offer), so Meta and Clarity can tell the pages apart.
     - The unfinished-form save and the submit tell n8n which page they came from
       (page = "educators"); n8n picks the calendar and the recovery link from it.
     - "When can you start?" is replaced by "Which fits you?" (iClosed identifier
       which-fits-you, sent as "fit" to the save).
     - Form first, right under the headline, with a "proof is below" line (only 25%
       of mobile visits reached the form on /doctors).
     - Taps react in the frame they happen: bigger answer buttons, a loud selected
       state, no slow scroll (Clarity dead clicks on /doctors were slow or silent
       reactions, not broken buttons).
   The wording is still the /doctors wording: Sidney writes the educator copy after
   seeing this layout. Every class lives under .dm so nothing leaks into shared styles.
=========================================================================== */
import Layout from "../layouts/Layout.astro";

// Microsoft Clarity project ID (the short code in Clarity > Settings > Setup).
// Empty = Clarity is not loaded. See docs/meta-ads/README.md, 2026-10-07.
const CLARITY_ID = "yu1mplpp22";

// iClosed "Educator Strategy Call" event (a copy of the doctor event; its own rule disqualifies "Not right now").
// PUBLIC_EDUCATORS_ICLOSED_URL exists only so a test build can point at a copy of the event;
// the production build never sets it.
const ICLOSED_URL = import.meta.env.PUBLIC_EDUCATORS_ICLOSED_URL || "https://app.iclosed.io/e/synchrosocial/educator-strategy-call";
// Which page this is: sent with every unfinished-form save so n8n picks the right calendar.
const PAGE = "educators";
// Meta content_name for every event this page sends.
const OFFER = "educator_offer";
// The Identifier of the "Which fits you?" question in iClosed (URL parameter that pre-fills it).
const FIT_KEY = "which-fits-you";
// The Identifier of the doctor event's price question in iClosed (Settings > Objects & Fields).
// It is the URL parameter name that pre-fills the answer. Must match iClosed exactly.
const PRICE_KEY = "within-reach";
const PRICE_QUESTION = "Our service starts at $3,000 a month. Is that within reach for you right now?";

// Answer text must match the iClosed event's options EXACTLY: they are passed
// to iClosed as URL parameters and matched as strings.
const specialties = ["Physician", "Dentist", "Chiropractor", "Surgeon", "Other"];
const investments = ["Yes", "Not right now"];
const fits = ["My own practice + a course or program", "My own practice", "I work for someone else", "Other"];

const guaranteeLead = "If we don't hit the monthly follower target we set for you in your first 3 months,";
const guaranteeBold = "we keep working for free until we do.";

const faqs = [
  {
    q: "What do you do?",
    a: "We film a month of short videos with you in one shoot, show different versions to people who don't follow you yet, and post across your platforms, making more of what brings in new followers.",
  },
  { q: "What do I need to do?", a: "One filming day a month. We tell you exactly what to say." },
  {
    q: "How much of my time does this take?",
    a: "About 20 minutes a week to give feedback on your filming plans, and one filming day a month, more or less. We handle the rest.",
  },
  {
    q: "How does the guarantee work?",
    a: "On your strategy call we set your monthly follower target based on your account. If we don't hit it in your first 3 months, we keep working for free until we do.",
  },
  {
    q: "Does this work for my specialty?",
    a: "Yes. The same system works across specialties. No skits or trends you're not comfortable with.",
  },
  {
    q: "Will it sound like me?",
    a: "That is the point. We study how you talk first, and nothing is filmed until you approve it.",
  },
  {
    q: "What about patient privacy?",
    a: "We follow platform health-content guidelines and never show patients or patient information. You approve every post before it goes live.",
  },
  {
    q: "When will I see results?",
    a: "Your first post goes live 2 to 3 weeks after you start. Month one tests a wide range of angles. From month two, we double down on what's working.",
  },
  {
    // Owner: no price on the page. The mockup left this answer open.
    q: "What does it cost?",
    a: "We go over pricing on your strategy call, once we've set your target.",
  },
];
---

<Layout
  title="Doctors Who Sell a Course, Program or Membership: 3,000 to 5,000 Followers a Month | Synchro Social"
  description="One filming day a month. We plan, script, edit and post, and bring you followers who want what you've built. Guaranteed."
  bodyClass="dm-body"
  metaEvent={{ name: "ViewContent", params: { content_name: OFFER } }}
  lightFonts
  noindex
>
  <div class="dm">
    <div class="brand"><img src="/images/apply4/logo-dark.png" alt="Synchro Social" width="170" height="36" /></div>


    <!-- Sticky navigation: appears once the form has scrolled out of view -->
    <nav class="stickybar" id="stickybar" aria-label="Jump to a section" hidden>
      <div class="sb-in">
        <a href="#results">Results</a>
        <a href="#who">Who we are</a>
        <a href="#how">How it works</a>
        <a href="#faq">Questions</a>
        <a class="sb-btn" href="#apply"><span class="sb-long">Book my call with Kasper</span><span class="sb-short">Book my call</span></a>
      </div>
    </nav>

    <!-- 1. TOP: headline, then the form straight away -->
