---
import Layout from "../../layouts/Layout.astro";
import SiteNav from "../../components/SiteNav.astro";
import VideoEmbed from "../../components/VideoEmbed.astro";
import ApplyButton from "../../components/ApplyButton.astro";

// This is deliberately a dedicated iClosed event, separate from the Client
// Success & Content Manager application. Do not point hiring traffic at the
// production sales calendars used by /apply. The matching event and its
// questions must exist in the iClosed dashboard before this route ships.
const applicationUrl = "https://app.iclosed.io/e/synchrosocial/video-editor-application";

const hiringVideoId = "gqs65bj4eo";
---

<Layout
  title="Video Editor — Synchro Social"
  description="Join Synchro Social as a Video Editor. Help turn raw footage into content that actually stops the scroll."
  bodyClass="v2"
  metaEvent={{ name: "ViewContent", params: { content_name: "hiring_video_editor" } }}
>
  <SiteNav minimal logoClickable={false} />

  <main>
    <section class="relative isolate overflow-hidden bg-black px-4 py-16 sm:px-6 sm:py-20 lg:py-24">
      <div
        class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(75%_52%_at_50%_100%,rgba(131,49,232,0.95)_0%,rgba(53,17,112,0.54)_42%,rgba(0,0,0,0)_78%)]"
        aria-hidden="true"
      ></div>

      <div class="mx-auto flex w-full max-w-[940px] flex-col items-center text-center">
        <p class="font-script text-2xl font-normal leading-5 text-[#b794ff] max-md:text-[20px]">
          Join The Synchro Social Team
        </p>

        <h1 class="font-tight mt-5 max-w-[860px] text-[clamp(2.75rem,7vw,5.25rem)] font-bold capitalize leading-[0.98] text-white">
          Video Editor
        </h1>

        <p class="mt-6 max-w-[720px] text-lg leading-[1.58] text-[#d6d2df] sm:text-xl lg:max-w-[840px]">
          We’re looking for an editor who can take raw footage and shape it into something people actually stop for — sharp cuts, tight pacing, and an eye for what makes a hook land.
        </p>

        <p class="mt-3 max-w-[720px] text-base leading-[1.58] text-[#b794ff] lg:max-w-[840px]">
          Short-form video editing for social media (Reels, TikTok, YouTube Shorts).
        </p>

        <div class="mt-11 w-full max-w-[900px]">
          {
            hiringVideoId ? (
              <VideoEmbed
                provider="wistia"
                id={hiringVideoId}
                title="Video Editor role at Synchro Social"
                tone="brand"
              />
            ) : (
              <VideoEmbed provider="placeholder" title="Video Editor role at Synchro Social" tone="brand" />
            )
          }
        </div>

        <div class="mt-10 flex w-full max-w-[457px] flex-col items-center gap-4">
          <ApplyButton href={applicationUrl} label="Apply For The Role" class="hiring-apply-cta w-full" />
          <p class="text-sm leading-6 text-white/60">
            A focused application. Real work. No fluff.
          </p>
        </div>
      </div>
    </section>

  </main>

  <footer class="border-t border-white/10 bg-black px-4 py-8 sm:px-6">
    <div class="mx-auto flex w-full max-w-[1040px] flex-col items-center justify-between gap-5 text-center text-sm text-white/55 sm:flex-row sm:text-left">
      <a href="/" aria-label="Synchro Social">
        <img src="/images/logo-updated.png" alt="Synchro Social" class="h-auto w-[164px]" />
      </a>
      <div class="flex items-center gap-5">
        <a href="/privacypolicy" class="transition hover:text-white">Privacy Policy</a>
        <a href="/terms-conditions" class="transition hover:text-white">Terms</a>
        <a href="mailto:hello@synchrosocial.com" class="transition hover:text-white">Contact</a>
      </div>
    </div>
  </footer>
</Layout>
