---
import Studio from "../../layouts/Studio.astro";
import HomeArt from "../../components/studio/HomeArt.astro";
const how = [
  { t: "Start with the script", b: "We study your audience first: what they care about, what they fear, what makes them stop scrolling. Every hook comes from that." },
  { t: "Scripts, filming plans, editing and posting", b: "We handle all of it every week, as one team that learns your voice. You review content about 20 minutes a week and film one day a month, around 2 hours." },
  { t: "Turn views into business", b: "Content and simple systems that turn viewers into followers, email subscribers, program members and clients." },
];
const beliefs = [
  ["We don't fake growth", "No paid ads to fake momentum, no bots, no bought followers, no shortcuts that look smart and hurt the account. We find what makes your content spread on its own. Followers gained per post is our earliest signal, because it shows real people chose to stay.", "Followers per post, that's my number one tracking metric."],
  ["Your genius is the content", "We don't hand you a template. We pull out what you know and what makes you, you, and build the videos around that.", "Our work is around how we can extract your genius and what makes you, you."],
  ["Honest over hyped", "We don't promise viral videos on a sales call. If something isn't working, we look at the content and tell you straight why.", "It's a content issue. Let's look at the content."],
  ["The camera is a muscle", "Nobody is great on camera in month one. You get better by showing up, and we coach you through it.", "I want you to feel a little embarrassed when you look at your month one videos when you're on month six."],
  ["Growth has to pay for itself", "Views are nice. Clients, members and sales are the point. We build the path from a video to your calendar.", "When people come to us, they need to make a return on what they invest."],
  ["Long-term, not one-off", "We don't do one-time projects. The same team stays with you and gets better every month.", "What we want is long-term clients that we can work with."],
];
---
<Studio title="About | Synchro Social" description="A social media agency founded in 2022, based in Miami, with a fully remote team." page="about">
  <section class="wrap hero">
    <h1>We help people with something to say get heard.</h1>
    <div class="hb"><p class="lede">Synchro Social is a social media agency founded in 2022. We're based in Miami, with a fully remote team.</p></div>
  </section>
  <section class="wrap sec tight split">
    <img class="portrait" src="/images/apply4/kasper-founder.webp" alt="Kasper, founder of Synchro Social" />
    <div>
      <h2 class="sh">Why I started Synchro</h2>
      <div class="prose">
        <p>I started as a videographer. Then I met Danny Morel, a life coach with a big message, and we clicked right away.</p>
        <p class="lead">So I quit a steady job to bet everything on him. No plan B, just a gut feeling that this was it. Most people would have waited. I don't really do waiting.</p>
        <p>It went both ways. Danny helped shape how I think. I gave him the content: we took him from about 100K to over 2 million Instagram followers, more than 500 million views, number one on Apple Podcasts and a million followers on TikTok.</p>
        <p>Other experts started asking who was behind his videos. That's how Synchro Social started in 2022: doing for them what I did for Danny. One team that learns how you talk, does the research, makes the content and tells you straight what's working. No bots, no bought followers, no numbers that look good and mean nothing.</p>
        <p>We're a bigger team now, but that's still the whole job.</p>
        <p>That is why every video starts with the script, not the footage.</p>
        <p class="sig">Kasper, founder</p>
      </div>
      <div class="facts" style="margin-top:40px">
        <div><b>2022</b><span>founded</span></div>
        <div><b>Miami</b><span>home base</span></div>
        <div><b>Fully remote</b><span>team</span></div>
        <div><b>People first</b><span>for clients and team</span></div>
      </div>
    </div>
  </section>
  <section class="band"><div class="wrap sec">
    <div class="sh"><h2>What we believe</h2><p>In Kasper's own words, taken from his calls with clients.</p></div>
    <div class="bl">{beliefs.map(([t, p, q]) => <div><h3>{t}</h3><p>{p}</p><div class="bub"><img src="/images/kasper.jpg" alt="Kasper, founder of Synchro Social" /><q>{q}</q></div></div>)}</div>
  </div></section>
  <section class="wrap sec">
    <div class="sh stack"><h2>How we work</h2><p>I write every script myself. Filming, editing and posting all start from that script.</p></div>
    <ol class="sg">{how.map((s, i) => <li><h3>{s.t}</h3><HomeArt i={i} /><p>{s.b}</p></li>)}</ol>
  </section>
  <section class="wrap stats" aria-label="Recognition" style="margin-bottom:48px">
    <div><b>1.2B+</b><span>views across every client since 2022</span></div>
    <div><b>8M+</b><span>followers grown across platforms</span></div>
    <div class="award"><a href="https://europeanagencyawards.com/2026-shortlist/" target="_blank" rel="noopener"><img src="/images/awards/european-agency-awards-2026-nominated-white.png" alt="Shortlisted, Social Media Agency of the Year, European Agency Awards 2026" /></a><span>Shortlisted, Social Media Agency of the Year</span></div>
  </section>
  <section class="wrap" style="text-align:center;margin:0 auto 96px"><a class="btn" href="/apply">Apply to work with us</a></section>
</Studio>
<style is:global>
.prose .sig{font-weight:600;color:var(--fg)}
.bl{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:var(--s5) var(--s6);border-top:1px solid var(--line);padding-top:var(--s4)}
.bub{display:flex;gap:10px;align-items:end;margin-top:16px}.bub img{width:30px;height:30px;border-radius:50%;object-fit:cover;flex:none}.bl q{display:block;position:relative;font-size:15px;line-height:1.45;color:var(--fg);background:var(--bg2);border-radius:20px 20px 20px 6px;padding:10px 14px;max-width:44ch;quotes:none}.band .bl q{background:var(--bg)}html[data-theme=dark] .bl q{background:#2b2140}
.bl h3{font-size:26px;margin-bottom:8px}.bl p{color:var(--mute);max-width:46ch}
@media (max-width:820px){
.bl{grid-template-columns:none;grid-auto-flow:column;grid-auto-columns:82%;gap:14px;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none;border-top:0;padding-top:0;margin-right:calc(-1*var(--s3));padding-right:var(--s3);padding-bottom:36px;margin-bottom:-24px}
.bl::-webkit-scrollbar{display:none}
.bl>div{scroll-snap-align:start;display:flex;flex-direction:column;background:var(--card,#fff);border-radius:16px;box-shadow:0 1px 2px #0000000d,0 14px 34px -14px #2b1a4a33;padding:20px}
html[data-theme=dark] .bl>div{--card:#1f1730;box-shadow:inset 0 0 0 1px var(--line)}
.bl .bub{order:-1;margin:0 0 18px}.bl h3{font-size:21px;margin-bottom:6px}
.bl q,.band .bl q{background:var(--bg2)}html[data-theme=dark] .bl q{background:#2e2441}
}
</style>
