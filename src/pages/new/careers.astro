---
import Studio from "../../layouts/Studio.astro";
import { team, GLASSDOOR_EN, LINKEDIN } from "../../data/studio.js";
const look = [
  ["You live in AI tools", "You use Claude every day, ChatGPT too, and you keep up with what is new. We expect you to find faster ways to do the work."],
  ["You build relationships", "For social media managers: clients trust you because you listen, you follow up, and you care how their account is doing."],
  ["You are proactive and independent", "You spot the problem and fix it before anyone asks. Nobody here is waiting to be told what to do next."],
  ["You care about the details", "For editors and designers: the hook, the pacing, the captions, the last frame. Small things are what make a video work."],
];
const how = [
  ["Fully remote", "Work from anywhere. The team is spread across the US and LATAM, with our home base in Miami."],
  ["9am to 5pm US Eastern", "We all work the same hours, Eastern time, so clients get answers the same day. That is 11am to 7pm in Argentina for most of the year."],
  ["People first", "We look after the people on the team and the clients we work for. Everything else comes after that."],
  ["Real clients, real work", "You'll work on accounts that reach millions of people, not practice projects."],
];
const faqs = [
  ["Is it remote?", "Yes, fully. You work from home, wherever that is."],
  ["What hours do you work?", "9am to 5pm US Eastern time. Editors can be more flexible when the work allows it."],
  ["What does the hiring process look like?", "You apply to an open role, we review every application, and the people we shortlist meet the team on a call."],
];
---
<Studio title="Careers at Synchro Social | Remote jobs" description="Remote jobs in social media, editing, design and operations at Synchro Social, a Miami social media studio with a team across the US and LATAM." page="careers">
  <section class="wrap hero">
    <h1>Do the best work of your career, from anywhere.</h1>
    <div class="hb"><p class="lede">We're a social media studio based in Miami, with video editors, social media managers and designers across the US and LATAM.</p><div class="cta"><a class="btn" href="#roles">Open roles</a></div></div>
  </section>
  <section class="wrap stats" aria-label="About us">
    <div><b>2022</b><span>in business since</span></div>
    <div><b>1.2B</b><span>views generated for our clients</span></div>
    <div class="award"><img src="/images/awards/european-agency-awards-2026-finalist-white.png" alt="European Agency Awards 2026" /><span>Finalist, Social Media Agency of the Year</span></div>
  </section>
  <section class="wrap sec">
    <div class="sh"><h2>The people you'd work with</h2><p>Fully remote, with people in the US and LATAM.</p></div>
    <ul class="tm">{team.map(m => <li><img src={m.img} alt="" loading="lazy" /><b>{m.name}</b><small>{m.role}</small></li>)}</ul>
  </section>
  <section class="wrap sec">
    <h2 class="sh">Who we look for</h2>
    <div class="bl">{look.map(([t, p]) => <div><h3>{t}</h3><p>{p}</p></div>)}</div>
  </section>
  <section class="band"><div class="wrap sec">
    <h2 class="sh">How we work</h2>
    <div class="bl">{how.map(([t, p]) => <div><h3>{t}</h3><p>{p}</p></div>)}</div>
  </div></section>
  <section class="wrap sec" id="roles">
    <h2 class="sh">Open roles</h2>
    <div class="roles"><div class="role"><h3>No open roles right now</h3><p>We post every new role on LinkedIn first. Follow us there and you'll see it the day it opens.</p><a class="go link" href={LINKEDIN} target="_blank" rel="noopener">Follow on LinkedIn</a></div></div>
  </section>
  <section class="band" id="reviews"><div class="wrap sec end">
    <h2>Hear it from the team</h2>
    <p>Read what people who work here say about us on Glassdoor.</p>
    <div class="cta"><a class="btn ghost" href={GLASSDOOR_EN} target="_blank" rel="noopener">Read our Glassdoor reviews</a></div>
  </div></section>
  <section class="wrap sec split">
    <h2>Questions</h2>
    <div class="faq">{faqs.map(([q, a]) => <details><summary>{q}</summary><p>{a}</p></details>)}</div>
  </section>
</Studio>
<style is:global>
.bl{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:var(--s5) var(--s6);border-top:1px solid var(--line);padding-top:var(--s4)}
.bl h3{font-size:26px;margin-bottom:8px}.bl p{color:var(--mute);max-width:46ch}
@media (max-width:820px){.bl{grid-template-columns:1fr;gap:var(--s4)}}
</style>
