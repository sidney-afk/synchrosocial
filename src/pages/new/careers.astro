<style is:global>
.bl{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:var(--s5) var(--s6);border-top:1px solid var(--line);padding-top:var(--s4)}
.wdg{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:var(--s3);margin-bottom:var(--s5)}.wd{background:var(--bg);border-radius:28px;padding:22px;display:flex;flex-direction:column;justify-content:end;aspect-ratio:16/10;box-shadow:0 1px 2px #0000000d,0 14px 34px -14px #2b1a4a33;position:relative;overflow:hidden}.wd b{font:800 34px/1 var(--disp);letter-spacing:-.03em}.wd small{color:var(--mute);font-size:14px;margin-top:4px}.wd svg{position:absolute;right:20px;top:20px;width:42%}.usd span{position:absolute;right:18px;top:6px;font:800 120px/1 var(--disp);color:#9fe870;-webkit-text-stroke:0}.usd{background:#163300!important;color:#9fe870}.usd small{color:#9fe870cc}.geo svg{width:78%;right:14px;top:18px}@media (max-width:820px){.wdg{grid-template-columns:1fr}}
.bl h3{font-size:26px;margin-bottom:8px}.bl p{color:var(--mute);max-width:46ch}
@media (max-width:820px){.bl{grid-template-columns:1fr;gap:var(--s4)}}
</style>
