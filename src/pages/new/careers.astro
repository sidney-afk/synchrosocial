---
import Studio from "../../layouts/Studio.astro";
import { GLASSDOOR_EN, LINKEDIN } from "../../data/studio.js";
const I = d => `<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">${d}</svg>`;
const ico = {
  ai: I('<path d="M12 3l1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8z"/><path d="M19 16l.7 2 2 .7-2 .7-.7 2-.7-2-2-.7 2-.7z"/>'),
  people: I('<path d="M4 6.5A2.5 2.5 0 0 1 6.5 4h11A2.5 2.5 0 0 1 20 6.5v7a2.5 2.5 0 0 1-2.5 2.5H11l-4 3.5V16H6.5A2.5 2.5 0 0 1 4 13.5z"/>'),
  go: I('<path d="M5 12h14M13 6l6 6-6 6"/>'),
  eye: I('<circle cx="11" cy="11" r="6"/><path d="M20 20l-4.5-4.5"/>'),
  globe: I('<circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c3 3 3 15 0 18M12 3c-3 3-3 15 0 18"/>'),
  clock: I('<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>'),
  heart: I('<path d="M12 20s-7-4.5-7-10a4 4 0 0 1 7-2.5A4 4 0 0 1 19 10c0 5.5-7 10-7 10z"/>'),
  dollar: I('<path d="M12 3v18M16 7.5C15 6.4 13.7 6 12 6c-2.2 0-4 1-4 3s1.8 2.6 4 3 4 1 4 3-1.8 3-4 3c-1.7 0-3.2-.5-4.2-1.7"/>'),
  work: I('<rect x="4" y="7" width="16" height="12" rx="2"/><path d="M9 7V5.5A1.5 1.5 0 0 1 10.5 4h3A1.5 1.5 0 0 1 15 5.5V7"/>'),
};
const look = [
  ["You live in AI tools", "You use Claude every day, ChatGPT too, and you keep up with what is new. We expect you to find faster ways to do the work.", "ai"],
  ["You build relationships", "For social media managers: clients trust you because you listen, you follow up, and you care how their account is doing.", "people"],
  ["You are proactive and independent", "You spot the problem and fix it before anyone asks. Nobody here is waiting to be told what to do next.", "go"],
  ["You care about the details", "For editors and designers: the hook, the pacing, the captions, the last frame. Small things are what make a video work.", "eye"],
];
const how = [
  ["Fully remote", "Work from anywhere. The team is spread across the US and LATAM, with our home base in Miami.", "globe"],
  ["9am to 5pm US Eastern", "We all work the same hours, Eastern time, so clients get answers the same day. That is 11am to 7pm in Argentina for most of the year.", "clock"],
  ["People first", "We look after the people on the team and the clients we work for. Everything else comes after that.", "heart"],
  ["Paid in US dollars", "Every salary is set and paid in USD, wherever you live.", "dollar"],
  ["Real clients, real work", "You'll work on accounts that reach millions of people, not practice projects.", "work"],
];
const faqs = [
  ["Is it remote?", "Yes, fully. You work from home, wherever that is."],
  ["What currency is the pay in?", "US dollars. All salaries are in USD."],
  ["What hours do you work?", "9am to 5pm US Eastern time. Editors can be more flexible when the work allows it."],
  ["What does the hiring process look like?", "You apply to an open role, we review every application, and the people we shortlist meet the team on a call."],
];
---
<Studio title="Careers at Synchro Social | Remote jobs" description="Remote jobs in social media, editing, design and operations at Synchro Social, a Miami social media agency with a team across the US and LATAM." page="careers">
  <section class="wrap hero">
    <h1>Do the best work of your career, from anywhere.</h1>
    <div class="hb"><p class="lede">We're a social media agency based in Miami, with video editors, social media managers and designers across the US and LATAM.</p><div class="cta"><a class="btn" href="#roles">Open roles</a></div></div>
  </section>
  <section class="wrap stats" aria-label="About us">
    <div><b>2022</b><span>in business since</span></div>
    <div><b>1.2B</b><span>views generated for our clients</span></div>
    <div class="award"><a href="https://europeanagencyawards.com/2026-shortlist/" target="_blank" rel="noopener"><img src="/images/awards/european-agency-awards-2026-nominated-white.png" alt="European Agency Awards 2026, nominated" /></a><span>Nominated, Best Social Media Agency of the Year</span></div>
  </section>
  <section class="wrap sec">
    <h2 class="sh">Who we look for</h2>
    <div class="bl">{look.map(([t, p, k]) => <div class="bi"><span class="ai" aria-hidden="true" set:html={ico[k]}></span><div><h3>{t}</h3><p>{p}</p></div></div>)}</div>
  </section>
  <section class="band"><div class="wrap sec">
    <h2 class="sh">How we work</h2>
    <div class="wdg" aria-hidden="true">
      <div class="wd clk"><svg viewBox="0 0 100 100"><circle cx="50" cy="50" r="44" fill="none" stroke="currentColor" stroke-opacity=".15" stroke-width="2"/><path d="M50 50 L50 22" stroke="currentColor" stroke-width="5" stroke-linecap="round"/><path d="M50 50 L72 50" stroke="currentColor" stroke-width="4" stroke-linecap="round"/><path d="M50 6 A44 44 0 1 1 6 50" fill="none" stroke="#8331e8" stroke-width="6" stroke-linecap="round"/><circle cx="50" cy="50" r="4" fill="#8331e8"/></svg><b>9 to 5</b><small>US Eastern</small></div>
      <div class="wd usd"><span>$</span><b>USD</b><small>every salary</small></div>
      <div class="wd geo"><svg viewBox="0 0 290 80"><g fill="currentColor" fill-opacity=".22"><circle cx="38" cy="8" r="1.7"/><circle cx="43" cy="8" r="1.7"/><circle cx="48" cy="8" r="1.7"/><circle cx="53" cy="8" r="1.7"/><circle cx="58" cy="8" r="1.7"/><circle cx="63" cy="8" r="1.7"/><circle cx="93" cy="8" r="1.7"/><circle cx="98" cy="8" r="1.7"/><circle cx="103" cy="8" r="1.7"/><circle cx="108" cy="8" r="1.7"/><circle cx="173" cy="8" r="1.7"/><circle cx="178" cy="8" r="1.7"/><circle cx="183" cy="8" r="1.7"/><circle cx="188" cy="8" r="1.7"/><circle cx="193" cy="8" r="1.7"/><circle cx="198" cy="8" r="1.7"/><circle cx="203" cy="8" r="1.7"/><circle cx="208" cy="8" r="1.7"/><circle cx="213" cy="8" r="1.7"/><circle cx="23" cy="13" r="1.7"/><circle cx="28" cy="13" r="1.7"/><circle cx="33" cy="13" r="1.7"/><circle cx="38" cy="13" r="1.7"/><circle cx="43" cy="13" r="1.7"/><circle cx="48" cy="13" r="1.7"/><circle cx="53" cy="13" r="1.7"/><circle cx="58" cy="13" r="1.7"/><circle cx="63" cy="13" r="1.7"/><circle cx="68" cy="13" r="1.7"/><circle cx="73" cy="13" r="1.7"/><circle cx="88" cy="13" r="1.7"/><circle cx="93" cy="13" r="1.7"/><circle cx="98" cy="13" r="1.7"/><circle cx="148" cy="13" r="1.7"/><circle cx="153" cy="13" r="1.7"/><circle cx="163" cy="13" r="1.7"/><circle cx="168" cy="13" r="1.7"/><circle cx="173" cy="13" r="1.7"/><circle cx="178" cy="13" r="1.7"/><circle cx="183" cy="13" r="1.7"/><circle cx="188" cy="13" r="1.7"/><circle cx="193" cy="13" r="1.7"/><circle cx="198" cy="13" r="1.7"/><circle cx="203" cy="13" r="1.7"/><circle cx="208" cy="13" r="1.7"/><circle cx="213" cy="13" r="1.7"/><circle cx="218" cy="13" r="1.7"/><circle cx="223" cy="13" r="1.7"/><circle cx="228" cy="13" r="1.7"/><circle cx="238" cy="13" r="1.7"/><circle cx="243" cy="13" r="1.7"/><circle cx="248" cy="13" r="1.7"/><circle cx="253" cy="13" r="1.7"/><circle cx="258" cy="13" r="1.7"/><circle cx="13" cy="18" r="1.7"/><circle cx="18" cy="18" r="1.7"/><circle cx="23" cy="18" r="1.7"/><circle cx="