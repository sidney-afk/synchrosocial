---
import Studio from "../../layouts/Studio.astro";
import StepArt from "../../components/studio/StepArt.astro";
import { campaignProof } from "../../data/campaignProof.js";
import { testimonials } from "../../data/testimonials.js";
import { steps as baseSteps } from "../../data/studio.js";
const steps = baseSteps.map((s, i) => i === 0 ? { ...s, title: "Start with the script" } : s);
const diff = [
  ["Followers", "Bots, bought followers and ghost views", "Real people who watch, comment and buy"],
  ["Reach", "Pay for every view with ad spend", "Organic reach that keeps working after the post"],
  ["Ideas", "Copy whatever is trending this week", "Angles built from research on your audience"],
  ["Content", "One template for every client", "Scripts written in your voice, by a team that knows it"],
  ["Reporting", "A monthly PDF nobody reads", "Clear numbers you can read in two minutes"],
  ["Team", "A new account manager every quarter", "The same people, every month, getting better"],
];
const faqs = [
  ["How do I know if I'm a fit?", "We work best with established experts, founders and educators who are ready to invest in a real growth system, not a quick fix. If you have an offer and want consistent content and leads without doing it all yourself, you're likely a fit."],
  ["What kinds of businesses does this work for?", "Coaches, doctors, authors, course creators, programs, founders, podcasters and educators who want to grow their impact and revenue on social media."],
  ["What results can I expect?", "Consistent, on-brand content, real follower growth and qualified leads. Results depend on your starting point, your niche and your offer, and we'll tell you honestly on the first call."],
  ["Which platforms do you work on?", "Mostly Instagram, with plans for TikTok, YouTube and Facebook depending on where your audience lives."],
  ["Will it work with my type of content?", "Yes. We study your brand and audience first and build content and angles specific to you, in your voice."],
  ["How long until I see results?", "Most clients build real momentum within the first 90 days."],
];
---
<Studio title="Work with Synchro Social" description="Strategy, scripts, filming plans, editing and posting for experts, founders and educators. 1.2B views generated, 8M followers grown." page="clients">
  <section class="wrap hero">
    <h1>Grow an audience that turns into business.</h1>
    <div class="hb">
      <p class="lede">Stop worrying about where the next client will come from. We run your social media end to end, so you can stay focused on your work.</p>
      <div class="cta"><a class="btn" href="/apply">Apply to work with us</a><a class="btn ghost" href="#results">See results</a></div>
    </div>
  </section>
  <section class="wrap stats" aria-label="In numbers">
    <div><b>1.2B</b><span>views generated for our clients</span></div>
    <div><b>8M</b><span>followers grown across platforms</span></div>
    <div class="award"><a href="https://europeanagencyawards.com/2026-shortlist/" target="_blank" rel="noopener"><img src="/images/awards/european-agency-awards-2026-nominated-white.png" alt="European Agency Awards 2026, nominated" /></a><span>Nominated, Best Social Media Agency of the Year</span></div>
  </section>
  <section class="wrap sec" id="results">
    <div class="sh"><h2>Real campaigns, real growth</h2><p>From views to leads to revenue. Press play to hear it from them.</p></div>
    <div class="vg">{campaignProof.map(c => (
      <div class="vi">
        <button class="vid wide" data-wistia={c.wistia} aria-label={`Play ${c.name}'s story`}><img src={c.poster} alt="" loading="lazy" /><span class="play"><svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 4v16l13-8z"/></svg>Watch</span></button>
        <h3>{c.name}</h3><small>{c.label.split(" - ")[1]}</small>
        <ul>{c.results.map(r => <li>{r === "1,000s of qualified leads" ? "One video, 1,000 qualified leads" : r}</li>).filter((_, i) => c.name !== "Dr. Sonia Chopra" || i !== 1)}</ul>
      </div>))}</div>
  </section>
  <section class="band"><div class="wrap sec">
    <h2 class="sh">How we work</h2>
    <p class="mute method"><b>The Script-First Method.</b> I write every script myself, built on what is trending, which formats work and who your audience follows. Filming, editing and posting all start from that script.</p>
    <ol class="sg">{steps.map((s, i) => <li><StepArt i={i} /><h3>{s.title}</h3><p>{s.body}</p></li>)}</ol>
  </div></section>
  <section class="wrap sec">
    <h2 class="sh">What working with us feels like</h2>
    <div class="sg hw">
      <div><div class="art"><div class="note"><div class="t">Getting to know you</div>
        <div class="r"><span class="ck"><svg viewBox="0 0 12 12"><path d="M2.5 6.5l2.3 2.2L9.5 3.8" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round"/></svg></span>Who you help: <span class="hl">your ideal client</span></div>
        <div class="r"><span class="ck"><svg viewBox="0 0 12 12"><path d="M2.5 6.5l2.3 2.2L9.5 3.8" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round"/></svg></span>What they fear most</div>
        <div class="r"><span class="ck"><svg viewBox="0 0 12 12"><path d="M2.5 6.5l2.3 2.2L9.5 3.8" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round"/></svg></span>Words you'd never say</div>
        <div class="r"><span class="ck open"></span>Your story, in your words</div></div></div>
        <h3>We learn you before we film you</h3><p>Your audience, your story, your voice. Every script starts from what makes you, you.</p></div>
      <div><div class="art"><div class="cal"><div class="mo">November</div><span>M</span><span>T</span><span>W</span><span>T</span><span>F</span><span>S</span><span>S</span><b>3</b><b>4</b><b>5</b><b>6</b><b>7</b><b>8</b><b>9</b><b>10</b><b>11</b><b>12</b><b class=on>13</b><b>14</b><b>15</b><b>16</b><b>17</b><b>18</b><b>19</b><b>20</b><b>21</b><b>22</b><b>23</b></div></div>
        <h3>You show up, we handle the rest</h3><p>One filming day a month. Ideas, scripts, editing and posting are on us.</p></div>
      <div><div class="art"><div class="dm"><div class="h"><i></i>sophie.k</div><div class="in">Your video about burnout was exactly what I needed.</div><div class="in">How do I work with you?</div><div class="out">Here's the link to book a call</div></div></div>
        <h3>An audience that turns into clients</h3><p>We grow the people who want what you offer, so your calendar fills, not just your follower count.</p></div>
      <div><div class="art"><div class="vd"><div class="clip"><span>Draft v2 · 0:42</span></div><div class="fb"><img src="/images/kasper.jpg" alt="" /><div>Strong hook. Cut the first 3 seconds.</div></div></div></div>
        <h3>Honest feedback, not yes-men</h3><p>Kasper tells you straight what's working and what isn't, and why.</p></div>
      <div><div class="art"><div class="gr"><div class="m1"><i></i>Month 1</div><span class="ar">→</span><div class="m6"><i><span>1.2M</span></i>Month 6</div></div></div>
        <h3>You get better on camera</h3><p>Nobody is great in month one. It's a muscle, and we coach you through it.</p></div>
      <div><div class="art"><div class="tmk"><div class="av"><img src="/images/team-photos/analia.webp" alt="" /><img src="/images/team-photos/laura.webp" alt="" /><img src="/images/team-photos/juani.webp" alt="" /><img src="/images/team-photos/ludmila.webp" alt="" /></div><b>Your team</b><small>Same faces since day one</small></div></div>
        <h3>The same team, every month</h3><p>No new account manager every quarter. The people who learn your voice stay.</p></div>
    </div>
  </section>
  <section class="band"><div class="wrap sec">
    <div class="sh"><h2>In their own words</h2><p>Unscripted, on camera, from people who have been through the whole process.</p></div>
    <div class="vg">{testimonials.map(t => (
      <div class="vi"><button class="vid" data-wistia={t.wistia} aria-label={`Play ${t.name}'s testimonial`}><img src={`/images/wistia/${t.wistia}.webp`} alt="" loading="lazy" /><span class="play"><svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 4v16l13-8z"/></svg>Watch</span></button>
      <h3>{t.name}</h3><small>{t.shortRole}</small></div>))}</div>
  </div></section>
  <section class="wrap sec split">
    <h2>Questions</h2>
    <div class="faq">{faqs.map(([q, a]) => <details><summary>{q}</summary><p>{a}</p></details>)}</div>
  </section>
  <section class="band" id="talk"><div class="wrap sec end">
    <h2>Want this for your brand?</h2>
    <p>Apply and we'll tell you honestly whether our process fits what you're building.</p>
    <div class="cta"><a class="btn" href="/apply">Apply to work with us</a></div>
  </div></section>
</Studio>
