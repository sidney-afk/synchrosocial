---
import Studio from "../../layouts/Studio.astro";
import HomeArt from "../../components/studio/HomeArt.astro";
import HomeCta from "../../components/studio/HomeCta.astro";
import { people, homePeople, reels } from "../../data/studio.js";
import { testimonials } from "../../data/testimonials.js";
const shown = homePeople.map(n => people.find(p => p.name === n));
const aud = [["Authors", "/images/clients/amber-rae.jpg"], ["Doctors", "/images/apply4/lily-baker-avatar.webp"], ["Coaches", "/images/danny-morel.jpg"], ["Thought leaders", "/images/kute.jpg"]];
const vs = ["Strategy", "Hooks", "Scripts", "Editing", "Posting", "Testing"];
const how = [
  { t: "Start with the script", b: "We study your audience first: what they care about, what they fear, what makes them stop scrolling. Every hook comes from that." },
  { t: "Scripts, filming plans, editing and posting", b: "We handle all of it every week, as one team that learns your voice. You review content about 20 minutes a week and film one day a month, around 2 hours." },
  { t: "Turn views into business", b: "Content and simple systems that turn viewers into followers, email subscribers, program members and clients." },
];
---
<Studio title="Synchro Social | Done-For-You Social Media Agency" description="Synchro Social is a done-for-you social media and content strategy agency for coaches, doctors, authors and thought leaders. Based in Miami since 2022." page="home">
  <section class="wrap hero hb2">
    <h1><span class="s1"><i class="phn">Someone with half your credentials is getting your audience.</i></span><span class="s2"><i class="phn">You spent years becoming the expert. We handle the rest.</i></span></h1>
    <div class="hb2-m"><p class="lede">Synchro Social is a done-for-you social media and content strategy agency for coaches, doctors, authors and thought leaders.</p><p class="lede out"><i class="phn">We turn your expertise into clients.</i></p><div class="cta2"><a class="btn" href="/apply">Apply to work with us</a></div></div>
    <ol class="hb2-s">{[["Plan","Ideas built around what you know, in your voice."],["Film","We direct the shoot, or guide you while you film."],["Edit","Hooks, cuts and captions that hold attention."],["Grow","Posting and testing until the audience builds."],["Earn","Followers turn into members, clients and sales."]].map(([a, b], i) => <li><span class="n">0{i + 1}</span><b>{a}</b><span class="d">{b}</span></li>)}</ol>
  </section>
  <section class="wrap stats" aria-label="In numbers">
    <div><b>1.2B</b><span>views across every client since 2022</span></div>
    <div><b>8M</b><span>followers grown across platforms</span></div>
    <div class="award"><a href="https://europeanagencyawards.com/2026-shortlist/" target="_blank" rel="noopener"><img src="/images/awards/european-agency-awards-2026-nominated-white.png" alt="European Agency Awards 2026, nominated" /></a><span>Nominated, Best Social Media Agency of the Year</span></div>
  </section>
  <ol class="hb2-s only-m wrap">{[["Plan","Ideas built around what you know, in your voice."],["Film","We direct the shoot, or guide you while you film."],["Edit","Hooks, cuts and captions that hold attention."],["Grow","Posting and testing until the audience builds."],["Earn","Followers turn into members, clients and sales."]].map(([a, b], i) => <li><span class="n">0{i + 1}</span><b>{a}</b><span class="d">{b}</span></li>)}</ol>
  <section class="band"><div class="wrap sec">
    <div class="sh"><h2>People we've worked with</h2><a class="link" href="/new/results">See every result</a></div>
    <ul class="pg">{shown.map(c => <li><img src={c.img} alt={c.name} loading="lazy" /><div><b><a href={`https://www.instagram.com/${c.ig}/`} target="_blank" rel="noopener">{c.name}</a></b><small>{c.who}</small><em>{c.result}</em></div></li>)}</ul>
  </div></section>
  <section class="wrap sec tight">
    <div class="sh"><h2>Videos we made</h2><p>Reels from client accounts, with the views they got. Tap one to watch.</p></div>
    <div class="rg">{reels.map((r, i) => <figure class={i >= 12 ? "reel x" : "reel"}><button class="vid" data-wistia={r.w} data-ig={r.ig} aria-label={`Play ${r.handle} video, ${r.views} views`}><img src={r.src || (r.ig ? `/images/ig/${r.ig}.webp` : `/images/wistia/${r.w}.webp`)} alt="" loading="lazy" /></button><figcaption><b>{r.views} views</b>{r.handle}</figcaption></figure>)}</div>
    <p class="rm"><button class="btn ghost" id="more-reels" type="button">Show more videos</button></p>
  </section>
  <section class="wrap sec hv">
    <h2 class="sh">In their own words</h2>
    <div class="vg">{testimonials.map(t => (
      <div class="vi"><button class="vid" data-wistia={t.wistia} aria-label={`Play ${t.name}'s testimonial`}><img src={`/images/wistia/${t.wistia}.webp`} alt={`${t.name}, ${t.shortRole}`} loading="lazy" /><span class="play"><svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 4v16l13-8z"/></svg>Watch</span></button>
      <h3>{t.name}</h3><small>{t.shortRole}</small></div>))}</div>
  </section>
  <section class="band"><div class="wrap sec endc">
    <h2>The expertise is already there.<br />The audience just hasn't found it yet.</h2>
    <div class="cta"><a class="btn" href="/apply">Apply to work with us</a></div>
  </div></section>
  <section class="wrap sec">
    <div class="sh stack"><h2>How we work</h2><p>I write every script myself, built on what is trending, which formats work and who your audience follows. Filming, editing and posting all start from that script. The same system that grew our clients over 8 million followers.</p></div>
    <ol class="sg">{how.map((s, i) => <li><h3>{s.t}</h3><HomeArt i={i} /><p>{s.b}</p></li>)}</ol>
  </section>
  <section class="band"><div class="wrap sec split2">
    <div>
      <h2>Who this is for</h2>
      <p class="big">You're a coach, author, doctor or expert people already trust.</p>
      <div class="bd"><div class="stories"><ul>{aud.map(([t, img]) => <li><span class="ring"><img src={img} alt="" loading="lazy" /></span>{t}</li>)}</ul></div>
      <div class="tx"><p class="mute">Your content doesn't show how good you are, while less experienced people get the views. You want a team to run your social media, so you can focus on your work.</p></div></div>
    </div>
    <div>
      <h2>Why not an editor or an intern?</h2>
      <p class="big">Editing is one piece.</p>
      <div class="bd"><div class="rem" role="group" aria-label="What each option covers">
        <div><h3>Editor or intern</h3><ul>{vs.map(t => <li><i class={t === "Editing" ? "on" : ""}>{t === "Editing" && <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7"/></svg>}</i>{t}<span class="sr">{t === "Editing" ? ", included" : ", not included"}</span></li>)}</ul></div>
        <div class="me"><h3>Synchro Social</h3><ul>{vs.map(t => <li><i class="on"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7"/></svg></i>{t}<span class="sr">, included</span></li>)}</ul></div>
      </div>
      <div class="tx"><p class="mute">An editor starts with footage. We start with the script.</p>
      <p class="mute">Hiring a scriptwriter, editor, social media manager and videographer separately runs $7,000 to $12,000+ a month, and you manage all of them.</p></div></div>
    </div>
  </div></section>
  <section class="band"><div class="wrap sec"><HomeCta kind="close" v="a" /></div></section>
<script is:inline>(function(){var b=document.getElementById("more-reels");if(!b)return;b.addEventListener("click",function(){var g=document.querySelector(".rg");g.classList.add("open");b.parentNode.remove()})})();</script>
</Studio>
