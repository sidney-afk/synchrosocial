---
import Studio from "../../layouts/Studio.astro";
import { caseStudies } from "../../data/caseStudies.js";
const avatar = { "Baya Voce": "baya-voce", "Danny Morel": "danny-morel", "Morgan Burch": "morgan-burch", "Jessica Winterstern": "jessica-winterstern", "Garrain Jones": "garrain-jones", "Lucas Salame": "lucas-salame" };
const pairs = [["Baya Voce", "baya"], ["Danny Morel", "danny", "-feed"], ["Lucas Salame", "lucas"], ["Oliver Nino", "oliver"], ["Dr. Lily Baker", "lily", "-s"], ["Dr. Sonia Chopra", "sonia", "-s"]];
const viral = [
  ["Dr. Amanda Hanson", "Psychologist, @midlife.muse", [["Dde-z33h-da","24.1M"],["Ddz2Vh5hfVY","17.5M"],["DbLM2v_RLDQ","1.8M"]]],
  ["Luke Cutting", "AI founder, @lukebuildsai", [["DdRp2rqpwHI","3.8M"],["DefDCtfJqLG","2.1M"],["DboZHeqJwYC","1.5M"]]],
  ["Edward Mannix", "Spiritual teacher, @edwardmannix", [["DURDgR2jp33","3.4M"],["DUs169ejlhE","1.7M"],["DUjGQ3xDvN8","1.2M"]]],
  ["Jenna Phillips Ballard", "Coach and mom, @jennaphillipsballard", [["DfDrLWyIP6k","5.1M"],["DevOdqeo9WU","1.3M"]]],
  ["Nathan Hirschaut", "Somatic dance teacher, @nathanhirschaut", [["DXZhh1mDiuM","3.1M"],["Dax0OrhgvuR","746K"],["DX7BMH-lMch","614K"]]],
];
const receipts = [
  ["/images/apply4/lily-baker-insights.webp", "Dr. Lily Baker: 10.6M views in under three months"],
  ["danny-podcast-chart.webp", "Danny Morel at number one on Apple Podcasts"],
  ["danny-morel-tiktok.webp", "Danny Morel's TikTok at one million followers"],
  ["jessica-growth-chart.webp", "Jessica Winterstern's follower growth"],
  ["organic-30-day-follower-growth.webp", "78,749 followers, 105% growth in 30 days"],
  ["amber-rae-bestseller.webp", "Amber Rae on the USA Today bestseller list"],
  ["sabrina-client-message.webp", "A client's message about her edits"],
];
---
<Studio title="Results | Synchro Social" description="Case studies, before and after accounts and the receipts behind 1.2B views and 8M followers." page="results">
  <section class="wrap hero">
    <h1>The receipts behind<br />1.2 billion views.</h1>
    <div class="hb"><p class="lede">Case studies, the videos behind them, and screenshots straight from client accounts.</p><div class="cta"><a class="btn" href="/apply" data-vsl-book>Book a call</a></div></div>
  </section>
  {caseStudies.map((c, i) => (
    <section class={i % 2 ? "band" : ""}><div class="wrap sec tight cs">
      <div class="sh"><div><h2>{c.name}</h2><p class="who"><img src={`/images/clients/${avatar[c.name]}.jpg`} alt="" /><span>{c.credit}<br /><small>{c.period.toLowerCase()} with us, on {c.platforms.join(", ").replace(/, ([^,]*)$/, " and $1")}</small></span></p></div>
      <div class="kpis">{c.stats.map(s => <p><b>{s.value}</b><span>{s.label.toLowerCase()}</span></p>)}</div></div>
      <div class="vg">{c.videos.map(v => <div class="vi"><button class="vid" data-wistia={v.wistia} aria-label={`Play ${c.name} video, ${v.views} views`}><img src={v.poster || `/images/wistia/${v.wistia}.webp`} alt="" loading="lazy" /><span class="play"><svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 4v16l13-8z"/></svg>{v.views} views</span></button></div>)}</div>
    </div></section>))}
  <section class="wrap sec">
    <div class="sh"><h2>More clients, more million-view videos</h2><p>Their best videos, all made by our team. Press play to watch on Instagram.</p></div>
    {viral.map(([n, who, vids]) => <div class="vr"><div><h3>{n}</h3><small>{who}</small></div><div class="vg">{vids.map(([c, v]) => <div class="vi"><button class="vid" data-ig={`https://www.instagram.com/reel/${c}/embed/`} aria-label={`Play ${n} video, ${v} views`}><img src={`/images/ig/${c}.webp`} alt="" loading="lazy" /><span class="play"><svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 4v16l13-8z"/></svg>{v} views</span></button></div>)}</div></div>)}
  </section>
  <section class="band"><div class="wrap sec">
    <div class="sh"><h2>Before and after</h2><p>The same accounts, before we started and after the work had been running.</p></div>
    <div class="ba">{pairs.map(([n, k, x = ""]) => <figure><div><img src={`/images/audience-skyrocket/${k}-before${x}.webp`} alt={`${n} account before`} loading="lazy" /><img src={`/images/audience-skyrocket/${k}-after${x}.webp`} alt={`${n} account after`} loading="lazy" /></div><figcaption>{n}, before and after</figcaption></figure>)}</div>
  </div></section>
  <section class="wrap sec">
    <h2 class="sh">More proof</h2>
    <div class="rc">{receipts.map(([f, t]) => <figure><img src={f.startsWith("/") ? f : `/images/audience-skyrocket/${f}`} alt={t} loading="lazy" /><figcaption>{t}</figcaption></figure>)}</div>
  </section>
  <section class="band"><div class="wrap sec endc">
    <h2>Want results like these?</h2>
    <p>See how we work with clients, and what a first month looks like.</p>
    <div class="cta"><a class="btn" href="/new/clients">See how we work with clients</a></div>
  </div></section>
</Studio>
<style is:global>
.vr{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,2fr);gap:var(--s5);align-items:start;padding:var(--s4) 0;border-top:1px solid var(--line)}.vr h3{margin:0 0 6px}.vr small{color:var(--mute);font-size:14px}.vr .vg{grid-template-columns:repeat(3,minmax(0,1fr));gap:var(--s3)}@media (max-width:820px){.vr{grid-template-columns:1fr;gap:var(--s3)}.vr .vg{gap:8px}}
.endc{text-align:center}.endc p{color:var(--mute);margin:12px 0 var(--s3)}.endc .cta{justify-content:center}
.dr{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:var(--s4);align-items:start}.dr img{width:100%;border-radius:var(--r);border:1px solid var(--line)}.dr figcaption{margin-top:12px;color:var(--mute);font-size:15px}.dr b{display:block;color:var(--fg);font-weight:600}@media (max-width:820px){.dr{grid-template-columns:1fr}}
.who{display:flex;align-items:center;gap:12px;margin-top:10px;color:var(--mute);line-height:1.35}.who img{width:48px;height:48px;border-radius:50%;object-fit:cover}.who small{font-size:14px}
.kpis{display:flex;gap:var(--s5)}.kpis b{display:block;font:800 40px/1 var(--disp);letter-spacing:-.03em}.kpis span{color:var(--mute);font-size:14px}
.cs .vg{grid-template-columns:repeat(3,minmax(0,1fr));max-width:820px;margin-left:auto;gap:var(--s3)}.cs .sh{margin-bottom:0}.cs{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,2fr);gap:var(--s5);align-items:start}.cs .sh{flex-direction:column;align-items:start}.cs .who{display:flex;align-items:center;gap:12px;margin-top:10px;color:var(--mute);line-height:1.35}.who img{width:48px;height:48px;border-radius:50%;object-fit:cover}.who small{font-size:14px}
.kpis{flex-direction:column;gap:var(--s3)}@media (max-width:820px){.cs{grid-template-columns:1fr;gap:var(--s3)}.cs .who{display:flex;align-items:center;gap:12px;margin-top:10px;color:var(--mute);line-height:1.35}.who img{width:48px;height:48px;border-radius:50%;object-fit:cover}.who small{font-size:14px}
.kpis{flex-direction:row}.cs .vg{grid-template-columns:repeat(3,minmax(0,1fr));gap:8px}}
.ba{display:grid;grid-template-columns:1fr;gap:var(--s5) var(--s4)}
.ba figure>div{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}.ba img{border-radius:var(--r);width:100%;border:1px solid var(--line)}
.ba figcaption,.rc figcaption{margin-top:10px;color:var(--mute);font-size:14px}
.rc{columns:3;column-gap:var(--s4)}.rc figure{break-inside:avoid;margin-bottom:var(--s4)}.rc img{border-radius:var(--r);width:100%;border:1px solid var(--line)}
@media (max-width:820px){.who{display:flex;align-items:center;gap:12px;margin-top:10px;color:var(--mute);line-height:1.35}.who img{width:48px;height:48px;border-radius:50%;object-fit:cover}.who small{font-size:14px}
.kpis{gap:var(--s4)}.ba{grid-template-columns:1fr}.rc{columns:1}}
</style>
