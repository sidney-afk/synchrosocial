---
import Layout from "../layouts/Layout.astro";
import IClosedLiftWidget from "../components/IClosedLiftWidget.astro";
import ApplyButton from "../components/ApplyButton.astro";
import ApplyHeroProofBar from "../components/ApplyHeroProofBar.astro";
import AudienceSkyrocket from "../components/AudienceSkyrocket.astro";
import ApplyFaq from "../components/ApplyFaq.astro";
import ApplyLegalFooter from "../components/ApplyLegalFooter.astro";

/* ===========================================================================
   GROWTH BOTTLENECK QUIZ — free lead-magnet funnel, landing page.
   Source: "Growth Bottleneck Quiz Funnel — V2" (Google Doc). Headline A/B
   test via ?hl=<variant> — see the inline script below; only "control" is
   wired until real challenger copy exists (decision log, 2026-08-24).

   Rebuilt 2026-08-26 per owner feedback: the quiz itself now lives on its
   own page (/quiz/take, opens in a new tab) — this page is pure marketing,
   no header, single CTA "Book A Consultation Call" everywhere.
=========================================================================== */

const ctaLabel = "Book A Consultation Call";
const quizHref = "/quiz/take";
const steps = [
  { n: 1, title: "Answer 8 questions", body: "Tell us how you currently create and distribute content." },
  { n: 2, title: "Get your growth diagnosis", body: "Find the specific bottleneck preventing more people from discovering and following you." },
  { n: 3, title: "Get your next action", body: "Receive the one area to fix first to increase follower growth." },
];

const quizFaqs = [
  {
    question: "Is the quiz actually free?",
    answer: "Yes — no cost, no credit card. Answer 8 questions and get your result immediately.",
  },
  {
    question: "What happens after I finish the quiz?",
    answer:
      "You'll see your specific growth bottleneck and the one action to fix first. From there you can book a free consultation call if you want help implementing it.",
  },
  {
    question: "How long does the call take?",
    answer:
      "About 20-30 minutes. We'll walk through your result, ask a few questions about your content and goals, and tell you honestly whether we're a fit.",
  },
  {
    question: "Will I be pressured to buy anything?",
    answer:
      "No. The call is a diagnostic conversation, not a sales pitch. If we're not a fit, we'll tell you and point you in a useful direction anyway.",
  },
  {
    question: "Is this quiz accurate for my niche or industry?",
    answer:
      "The four bottlenecks — reach, positioning, profile conversion, consistency — apply to any coach or expert publishing content, regardless of niche. Your specific numbers are unique to you.",
  },
  {
    question: "What if I don't like my result?",
    answer:
      "Every result comes with a concrete next action, not just a diagnosis. Whatever your biggest constraint is, there's a specific first step to fix it.",
  },
];
---

<Layout
  title="Growth Bottleneck Quiz — Synchro Social"
  description="Take the 3-minute quiz to uncover the specific bottleneck limiting your reach and follower growth, then get the one action to fix first."
  bodyClass="v2"
  metaEvent={{ name: "ViewContent", params: { content_name: "quiz" } }}
>
  <IClosedLiftWidget />

  <!-- ===================== HERO ===================== -->
  <section class="relative overflow-hidden pb-20 pt-24 max-lg:pt-16 max-md:pb-12 max-md:pt-12">
    <div class="quiz-hero-fade pointer-events-none absolute inset-0" aria-hidden="true"></div>

    <div class="relative z-[3] mx-auto flex w-[95%] max-w-[1100px] flex-col items-center gap-7 text-center max-md:gap-5">
      <p class="font-tight text-sm font-semibold uppercase leading-none tracking-[0.2em] text-[#d8c4ff] max-md:text-[11px] max-md:tracking-[0.16em]">
        For Coaches and Experts
      </p>

      <!-- Two explicit line-broken headlines (same technique as apply.astro's
           hero h1s) rather than relying on natural reflow: desktop locked to
           2 lines, mobile locked to 3 — both centered by the shared column
           below, not by their own width. -->
      <h1
        data-quiz-headline="control"
        class="hidden font-tight text-[clamp(2.25rem,1.6rem+2.2vw,3.5rem)] font-bold leading-[1.1] text-white md:block"
      >
        <span class="inline-block whitespace-nowrap">Posting Consistently But Not Growing?</span>
        <br />
        <span class="inline-block whitespace-nowrap">Find Out Why in 3 Minutes</span>
      </h1>
      <h1
        data-quiz-headline="control"
        class="font-tight text-[clamp(2.25rem,1.6rem+2.2vw,3.5rem)] font-bold leading-[1.1] text-white md:hidden"
      >
        <span class="inline-block whitespace-nowrap">Posting Consistently</span>
        <br />
        <span class="inline-block whitespace-nowrap">But Not Growing? Find</span>
        <br />
        <span class="inline-block whitespace-nowrap">Out Why in 3 Minutes</span>
      </h1>

      <p class="max-w-[620px] text-xl leading-[157%] text-[#d9d0ea] max-md:text-base md:max-w-[900px]">
        Take the 3-minute quiz to uncover the specific bottleneck limiting your reach and follower
        growth, then get the one action to fix first.
      </p>

      <div class="mt-1 flex w-full max-w-[420px] flex-col max-md:w-[calc(100%-16px)]">
        <ApplyButton
          href={quizHref}
          label={ctaLabel}
          arrowDir="down"
          class="w-full quiz-hero-cta"
          target="_blank"
          rel="noopener noreferrer"
        />
      </div>

      <div class="mt-4 w-full">
        <ApplyHeroProofBar />
      </div>
    </div>
  </section>

  <!-- ===================== SOCIAL PROOF ===================== -->
  <!-- Reused from /apply (before/after comparison grid + proof tiles), with
     the "purple" theme swapping /apply's navy/blue palette for black +
     brand purple. Per owner feedback 2026-08-26 the qualification line and
     the featured-result/proof-strip/CTA should all read as ONE box, not
     just one section — so both are now passed as slot content that renders
     INSIDE the same bordered panel as the before/after comparison, not
     just inside the same outer section. hideCta drops this component's own
     built-in CTA since the slotted content supplies the one CTA instead. -->
  <AudienceSkyrocket title="How We Grow Our Clients" theme="purple" hideCta>
    <Fragment slot="before-title">
      <p class="font-tight mx-auto mb-10 w-[90%] max-w-[680px] text-center text-2xl font-bold leading-snug text-white max-md:mb-8 max-md:text-xl">
        Built for coaches, experts, and personal brands who publish content but aren't converting
        views into followers.
      </p>
    </Fragment>

    <div class="mx-auto flex w-[95%] max-w-[1040px] flex-col items-center gap-8 pt-8 max-md:gap-6 max-md:pt-6">
      <!-- Featured proof callout — pulled out of the strip, own visual
         treatment, per the spec doc. -->
      <div class="relative w-full max-w-[820px] overflow-hidden rounded-2xl bg-brand-gradient p-10 text-center shadow-soft-band max-md:p-7">
        <span
          class="font-tight pointer-events-none absolute -top-6 left-6 text-[130px] leading-none text-white/10 max-md:-top-3 max-md:left-3 max-md:text-[90px]"
          aria-hidden="true"
        >
          &rdquo;
        </span>
        <p class="font-tight relative text-xs font-bold uppercase leading-none tracking-[0.2em] text-white/70">
          Featured Result
        </p>
        <p class="font-tight relative mt-4 text-2xl font-bold leading-snug text-white max-md:text-xl">
          Alexi Panos added 30K followers in 2 months — with zero filming required.
        </p>
      </div>

      <!-- Proof strip. The doc's second name (Daniel Raphael) already
         appears in the case-study roster above, so this uses Danny Morel
         instead to avoid featuring the same client twice. -->
      <p class="max-w-[760px] text-center text-base leading-[157%] text-[#c4c4c4]">
        Other results: Luke MacNaughton added 10K followers in one month. Danny Morel grew to
        3.5M+ followers with 500M+ views generated.
      </p>

      <div class="mt-2 flex w-full max-w-[420px] flex-col max-md:w-[calc(100%-32px)]">
        <ApplyButton href={quizHref} label={ctaLabel} arrowDir="down" class="w-full" target="_blank" rel="noopener noreferrer" />
      </div>
    </div>
  </AudienceSkyrocket>

  <!-- ===================== HOW IT WORKS ===================== -->
  <section class="w-full bg-black pb-10 pt-12 max-md:pb-6 max-md:pt-8">
    <div class="mx-auto flex w-[95%] max-w-[1040px] flex-col items-center gap-14 max-md:gap-8">
      <h2 class="font-tight text-5xl font-bold capitalize leading-none text-white max-md:text-[28px]">
        How it works
      </h2>

      <div class="grid w-full grid-cols-3 gap-8 max-md:grid-cols-1 max-md:gap-8">
        {
          steps.map((s) => (
            <div class="flex flex-col items-center gap-4 text-center">
              <span class="step-pill step-pill--dark">
                <span class="step-dot">{s.n}</span>
                STEP {s.n}
              </span>
              <p class="font-tight text-xl font-bold text-white">{s.title}</p>
              <p class="text-base leading-[157%] text-[#c4c4c4]">{s.body}</p>
            </div>
          ))
        }
      </div>

      <div class="flex w-full max-w-[420px] flex-col max-md:w-[calc(100%-32px)]">
        <ApplyButton href={quizHref} label={ctaLabel} arrowDir="down" class="w-full" target="_blank" rel="noopener noreferrer" />
      </div>
    </div>
  </section>

  <!-- ===================== FAQ ===================== -->
  <ApplyFaq heading="Got Questions?<br />We've Got Answers" items={quizFaqs} />

  <ApplyLegalFooter />
</Layout>

<style>
  .quiz-hero-fade {
    background-image: linear-gradient(rgba(0, 0, 0, 0), var(--g-purple-deep));
  }

  /* Animated glow + hover treatment on the hero CTA only — see chat summary
     for why it's scoped to just this one button. :global() because the
     class lands on the <a> ApplyButton renders in its own component scope,
     not an element written directly in this file. */
  :global(.quiz-hero-cta) {
    animation: quiz-cta-glow 2.4s ease-in-out infinite;
    transition:
      background-color 200ms ease,
      transform 150ms ease,
      box-shadow 200ms ease;
  }

  /* Hover — deliberately more drastic than the site-wide .btn-g hover:
     bigger lift + scale, a hard color jump, and a much stronger burst
     shadow, per owner feedback 2026-08-26 that the original was too subtle.
     `animation: none` (not just paused) — a *paused* CSS animation still
     wins the cascade for any property it animates, so the idle glow's own
     frozen box-shadow was silently overriding this rule's box-shadow. Fully
     removing the animation on hover lets this box-shadow actually apply. */
  :global(.quiz-hero-cta:hover) {
    animation: none;
    background: var(--g-purple-deep);
    transform: translateY(-5px) scale(1.045);
    box-shadow:
      0 14px 36px rgba(131, 49, 232, 0.8),
      0 0 0 4px rgba(131, 49, 232, 0.4);
  }

  :global(.quiz-hero-cta:active) {
    transform: translateY(-2px) scale(1.01);
  }

  @keyframes quiz-cta-glow {
    0%,
    100% {
      box-shadow:
        0 0 0 0 rgba(131, 49, 232, 0.55),
        0 4px 18px rgba(131, 49, 232, 0.35);
    }
    50% {
      box-shadow:
        0 0 0 12px rgba(131, 49, 232, 0),
        0 4px 30px rgba(131, 49, 232, 0.6);
    }
  }
</style>

<script>
  /* Headline A/B — separate ad sets point at /quiz?hl=<variant>-style URLs
     (decision log, 2026-08-24). Only "control" exists until real challenger
     copy is supplied; add entries here as they're written. The default
     markup already renders control, so a missing/unknown ?hl value is a
     no-op — nothing to swap. There are two <h1> elements (desktop/mobile
     line-break variants, see the hero markup) sharing this data attribute;
     a plain-text challenger replaces both and loses their manual line
     breaks — a challenger that needs its own multi-line layout should set
     innerHTML per breakpoint instead of adding a plain string here. */
  const HEADLINE_VARIANTS: Record<string, string> = {
    // b: "Challenger headline goes here",
  };

  (function () {
    let variant = "control";
    try {
      variant = new URLSearchParams(window.location.search).get("hl") || "control";
    } catch (e) {}
    const copy = HEADLINE_VARIANTS[variant];
    if (copy) {
      document.querySelectorAll<HTMLElement>("[data-quiz-headline]").forEach((el) => {
        el.textContent = copy;
        el.setAttribute("data-quiz-headline", variant);
      });
    }
  })();

  /* Forward this page's querystring (utm_ params, fbclid, etc.) onto every
     /quiz/take link. The quiz now opens in a new tab — a new tab gets its own
     sessionStorage, not this page's — so IClosedCapture.astro's existing
     "read attribution from the current page's own URL if nothing is stored
     yet" fallback (see src/components/IClosedCapture.astro) needs /quiz/take
     to actually carry the params in ITS OWN url to self-populate ss_attr.
     No noopener-breaks-this concern either way since we still pass
     noopener/noreferrer — this doesn't rely on window.opener at all. */
  (function () {
    const search = window.location.search;
    if (!search) return;
    document.querySelectorAll<HTMLAnchorElement>('a[href^="/quiz/take"]').forEach((a) => {
      try {
        const url = new URL(a.getAttribute("href") || "", window.location.origin);
        const incoming = new URLSearchParams(search);
        incoming.forEach((v, k) => {
          if (!url.searchParams.has(k)) url.searchParams.set(k, v);
        });
        const qs = url.searchParams.toString();
        a.setAttribute("href", url.pathname + (qs ? `?${qs}` : ""));
      } catch (e) {}
    });
  })();
</script>
