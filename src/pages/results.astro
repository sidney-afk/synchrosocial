---
/* ===========================================================================
   /results: a copy of /success-stories with the SAME layout, components and
   section order (owner, 29 Oct 2026). Only the colours (the /doctors-who-teach
   look: white, blue, pink call button), the copy (Kasper's first person) and
   these additions differ:
     - Dr. Lily Baker: first before/after row, first proof tile, first case study
     - Jessica Winterstern's three newest videos; Chelsey Scaffidi's three videos
   Chelsey shows no stats on purpose: none could be checked.
=========================================================================== */
import Layout from "../layouts/Layout.astro";
import VslRealResults from "../components/VslRealResults.astro";
import VslButton from "../components/VslButton.astro";
import VslBookingModal from "../components/VslBookingModal.astro";
import CaseStudyVideo from "../components/CaseStudyVideo.astro";
import PlatformIcon from "../components/PlatformIcon.astro";
import { allVslCaseStudies } from "../data/vslCaseStudies.js";
import { caseStudies } from "../data/caseStudies.js";
import { testimonials } from "../data/testimonials.js";
import "../styles/vsl.css";

const imageBase = "/images/audience-skyrocket/";

// Mirrors AudienceSkyrocket.astro's comparisonRows.
const comparisons = [
  { key: "lily", label: "Dr. Lily Baker", before: "lily-before.webp", after: "lily-after.webp" },
  { key: "danny", label: "Danny Morel", before: "danny-before-feed.webp", after: "danny-after-feed.webp" },
  { key: "baya", label: "Baya Voce", before: "baya-before.webp", after: "baya-after.webp" },
  { key: "lucas", label: "Lucas Salame", before: "lucas-before.webp", after: "lucas-after.webp" },
  { key: "oliver", label: "Oliver Nino", before: "oliver-before.webp", after: "oliver-after.webp" },
];

// Mirrors AudienceSkyrocket.astro's proofTiles.
const proofTiles = [
  { src: "../apply4/lily-baker-insights.webp", alt: "Dr. Lily Baker Instagram insights, Jul 8 to Sep 27: 10,651,859 views, +60,944 net followers" },
  { src: "danny-morel-podcast-millions.webp", alt: "Podcast clips with millions of views" },
  { src: "danny-morel-2025-growth.webp", alt: "Danny Morel thirty day Instagram growth analytics" },
  { src: "danny-podcast-chart.webp", alt: "Apple Podcasts chart showing Danny Morel at number one" },
  { src: "danny-morel-tiktok.webp", alt: "Danny Morel TikTok profile at one million followers" },
  { src: "jessica-growth-chart.webp", alt: "Jessica Winterstern follower growth chart" },
  { src: "amber-rae-bestseller.webp", alt: "USA Today bestselling booklist proof for Amber Rae" },
  { src: "jessica-client-message.webp", alt: "Client message praising new content" },
  { src: "sabrina-client-message.webp", alt: "Client message praising edits and music" },
  { src: "organic-30-day-follower-growth.webp", alt: "Analytics showing 78,749 followers and 105 percent growth over thirty days" },
  { src: "open-posture-doc-profile.webp", alt: "The Open Posture Doc TikTok profile with 93,100 followers" },
  { src: "open-posture-doc-follower-growth.webp", alt: "The Open Posture Doc follower growth over five days" },
];

const ctaLabel = "Let's get on a call";

const lilyCard = {
  key: "lily",
  name: "Dr. Lily Baker | Chiropractor",
  stat: "+90,000 Followers",
  tag: "490 To 856 Members In Six Weeks",
  story:
    "Lily is a chiropractor who sells a membership. She gained 90,000 followers in under 90 days, 17,000 of them from one reel, and her membership grew from 490 to 856 members in six weeks.",
  wistia: "t7vak3h3m9",
  poster: "/images/doctors-videos/lily-baker.jpg",
};

const newVideos = (who) =>
  [1, 2, 3].map((n) => ({ mp4: `/videos/results/${who}-${n}.mp4`, mp4Poster: `/images/results/${who}-${n}.jpg` }));
const reelBlocks = [
  ...caseStudies.map((cs) => (cs.name === "Jessica Winterstern" ? { ...cs, videos: newVideos("jessica") } : cs)),
  // Views of her top seven Instagram videos since 25 Feb 2026, as read off her
  // profile by the owner (29 Oct): 647K, 513K, 340K, 304K, 242K, 180K, 108K.
  {
    name: "Chelsey Scaffidi",
    credit: "Matrescence educator and author",
    period: "Since Feb 2026",
    platforms: ["Instagram"],
    stats: [
      { value: "2.3M+", label: "Views On Her Top 7 Videos" },
      { value: "647K", label: "Views On Her Top Video" },
    ],
    videos: newVideos("chelsey"),
  },
];
---

<Layout
  title="Results | Synchro Social"
  description="Every case study, client testimonial and growth result my team and I have built: 1.2B views generated and 8M followers grown."
  bodyClass="vsl rs"
  tabIcon="/images/logo-tab.png"
  metaEvent={{ name: "ViewContent", params: { content_name: "results" } }}
>
  <!-- ===================== HERO ===================== -->
  <header class="ss-hero">
    <div class="ss-hero__brand">
      <img src="/images/apply4/logo-dark.png" alt="Synchro Social" width="170" height="36" />
    </div>
    <div class="ss-hero__eyebrow">Results</div>
    <h1 class="ss-hero__title">
      Every Result My Team Has Built,<br />
      <span class="vsl-accent">In One Place.</span>
    </h1>
    <p class="ss-hero__sub">
      I've generated 1.2 billion views and grown 8 million followers for coaches and experts.
      Here are the case studies, the testimonials and the receipts behind them.
    </p>
  </header>

  <!-- ===================== 1. TESTIMONIALS ===================== -->
  <section class="ss-section ss-testimonials">
    <div class="ss-head">
      <div class="ss-eyebrow">In Their Own Words</div>
      <h2>What My Clients Say</h2>
      <p>Unscripted, on camera, from people who have run the whole process with me.</p>
    </div>

    <div class="ss-testimonials__grid">
      {
        testimonials.map((t) => (
          <article class="ss-testimonial">
            <div class="ss-testimonial__video">
              <iframe
                src={`https://fast.wistia.net/embed/iframe/${t.wistia}?seo=false&videoFoam=true`}
                title={`${t.name} testimonial`}
                allow="autoplay; fullscreen"
                allowfullscreen
                loading="lazy"
              />
            </div>
            <h3>{t.name}</h3>
            <p class="ss-testimonial__role">{t.shortRole ?? t.role}</p>
            <p class="ss-testimonial__quote">{t.title}</p>
          </article>
        ))
      }
    </div>
  </section>

  <!-- ===================== 2. BEFORE & AFTER ===================== -->
  <section class="ss-section ss-compare">
    <div class="ss-head">
      <div class="ss-eyebrow">Before &amp; After</div>
      <h2>Watch The Audience Skyrocket</h2>
      <p>The same accounts, before my team started and after the system had been running.</p>
    </div>

    <div class="ss-compare__list">
      {
        comparisons.map((row) => (
          <div class="ss-compare__row">
            <figure class="ss-compare__card">
              <figcaption class="ss-compare__bar ss-compare__bar--before">Before</figcaption>
              <img src={`${imageBase}${row.before}`} alt={`${row.label} account before growth`} loading="lazy" decoding="async" />
            </figure>
            <figure class="ss-compare__card">
              <figcaption class="ss-compare__bar ss-compare__bar--after">After</figcaption>
              <img src={`${imageBase}${row.after}`} alt={`${row.label} account after growth`} loading="lazy" decoding="async" />
            </figure>
          </div>
        ))
      }
    </div>
  </section>

  <!-- ===================== 3. PROOF WALL ===================== -->
  <section class="ss-section ss-wall">
    <div class="ss-head">
      <div class="ss-eyebrow">Receipts</div>
      <h2>More Proof Behind The Growth</h2>
      <p>Analytics, charts, chart placements and the messages that came with them.</p>
    </div>

    <div class="ss-wall__grid">
      {
        proofTiles.map((tile) => (
          <figure class="ss-wall__tile">
            <img src={`${imageBase}${tile.src}`} alt={tile.alt} loading="lazy" decoding="async" />
          </figure>
        ))
      }
    </div>
  </section>

  <!-- ===================== 4. CASE STUDIES ===================== -->
  <VslRealResults
    eyebrow="Case Studies"
    heading="Just Some Of My Case Studies"
    intro="Ten clients, ten different starting points. Each one tells the story in their own words."
    cards={[lilyCard, ...allVslCaseStudies.filter((c) => c.key === "sonia"), ...allVslCaseStudies.filter((c) => c.key !== "sonia")]}
    columns={2}
  />

  <!-- ===================== 5. BEST PERFORMING VIDEOS ===================== -->
  <section class="ss-section ss-reels">
    <div class="ss-head">
      <div class="ss-eyebrow">Best Performing Videos</div>
      <h2>The Content That Did It</h2>
      <p>The individual videos my team made behind those numbers, and what each account generated overall.</p>
    </div>

    <div class="ss-reels__list">
      {
        reelBlocks.map((cs) => (
          <article class="ss-reel-block">
            <div class="ss-reel-block__head">
              <div>
                <h3>{cs.name}</h3>
                <p class="ss-reel-block__credit">{cs.credit}{cs.period && <> &middot; {cs.period}</>}</p>
              </div>
              <div class="ss-reel-block__platforms" aria-label="Platforms">
                {cs.platforms.map((p) => <PlatformIcon name={p} class="h-5 w-5" />)}
              </div>
            </div>

            <div class="ss-reel-block__stats">
              {cs.stats.map((s) => (
                <div class="ss-stat">
                  <div class="ss-stat__value vsl-accent">{s.value}</div>
                  <div class="ss-stat__label">{s.label}</div>
                </div>
              ))}
            </div>

            <div class="ss-reel-block__videos">
              {cs.videos.map((v) => (
                <div class="ss-reel">
                  <CaseStudyVideo
                    wistia={v.wistia}
                    poster={v.poster}
                    mp4={v.mp4}
                    mp4Poster={v.mp4Poster}
                    title={`${cs.name} reel — ${v.views} views`}
                    rounded
                  />
                  {v.views && <div class="ss-reel__views">{v.views} views</div>}
                </div>
              ))}
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <!-- ===================== CTA ===================== -->
  <section class="ss-cta">
    <h2>Want This For Your Brand?</h2>
    <p>Let's talk, and I'll tell you honestly whether my process fits what you're building.</p>
    <VslButton label={ctaLabel} book />
  </section>

  <VslBookingModal />
</Layout>

<style>
  /* ---------- hero ---------- */
  .ss-hero {
    max-width: 900px;
    margin: 0 auto;
    padding: 56px 24px 8px;
    text-align: center;
  }

  .ss-hero__brand {
    margin-bottom: 40px;
  }

  .ss-hero__brand img {
    width: 170px;
    height: auto;
    display: block;
    margin: 0 auto;
  }

  .ss-hero__eyebrow {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--vsl-p);
    margin-bottom: 18px;
  }

  .ss-hero__title {
    font-size: clamp(28px, 5vw, 46px);
    font-weight: 600;
    line-height: 1.14;
    letter-spacing: -0.022em;
    max-width: 24ch;
    margin: 0 auto 30px;
    color: var(--vsl-ink);
  }

  .ss-hero__sub {
    font-size: clamp(15.5px, 1.9vw, 19px);
    line-height: 1.55;
    color: var(--vsl-ink-dim);
    max-width: 62ch;
    margin: 0 auto;
  }

  /* ---------- shared section chrome ---------- */
  .ss-section {
    width: 100%;
    padding: 72px 20px 90px;
    background: var(--vsl-black);
  }

  .ss-head {
    max-width: 720px;
    margin: 0 auto 48px;
    text-align: center;
  }

  .ss-eyebrow {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--vsl-p);
    margin-bottom: 16px;
  }

  .ss-head h2 {
    font-size: clamp(26px, 4vw, 38px);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.16;
    margin-bottom: 16px;
    color: var(--vsl-ink);
  }

  .ss-head p {
    font-size: 16px;
    color: var(--vsl-ink-dim);
    line-height: 1.6;
    max-width: 52ch;
    margin: 0 auto;
  }

  /* ---------- reels ---------- */
  .ss-reels__list {
    max-width: 1000px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .ss-reel-block {
    background: var(--vsl-card);
    border: 1px solid var(--vsl-card-border);
    border-radius: 16px;
    padding: 26px;
    transition: border-color 0.22s ease;
  }

  .ss-reel-block:hover {
    border-color: rgba(23, 138, 246, 0.4);
  }

  .ss-reel-block__head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }

  .ss-reel-block__head h3 {
    font-size: clamp(19px, 2.2vw, 22px);
    font-weight: 700;
    letter-spacing: -0.015em;
    line-height: 1.28;
    color: var(--vsl-ink);
    margin: 0;
  }

  .ss-reel-block__credit {
    margin: 4px 0 0;
    font-size: 13px;
    font-weight: 600;
    color: var(--vsl-p);
  }

  .ss-reel-block__platforms {
    display: flex;
    gap: 8px;
    color: var(--vsl-ink-dim);
  }

  /* PlatformIcon ships each network's own brand colour. Full-saturation
     Instagram pink and YouTube red fight the monochrome purple palette, so
     they read as muted metadata here and only come up to colour on hover. */
  .ss-reel-block__platforms :global(svg) {
    filter: grayscale(1);
    opacity: 0.55;
    transition: filter 0.22s ease, opacity 0.22s ease;
  }

  .ss-reel-block:hover .ss-reel-block__platforms :global(svg) {
    filter: none;
    opacity: 0.9;
  }

  .ss-reel-block__stats {
    display: flex;
    gap: 32px;
    flex-wrap: wrap;
    margin: 20px 0 22px;
  }

  .ss-stat__value {
    font-size: clamp(24px, 2.6vw, 28px);
    font-weight: 700;
    letter-spacing: -0.015em;
    line-height: 1.15;
  }

  .ss-stat__label {
    font-size: 13px;
    color: var(--vsl-ink-dim);
    margin-top: 2px;
  }

  .ss-reel-block__videos {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }

  .ss-reel__views {
    margin-top: 8px;
    text-align: center;
    font-size: 13px;
    font-weight: 700;
    color: var(--vsl-ink-dim);
  }

  /* ---------- testimonials ---------- */
  .ss-testimonials__grid {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .ss-testimonial {
    background: var(--vsl-card);
    border: 1px solid var(--vsl-card-border);
    border-radius: 16px;
    padding: 18px 18px 22px;
    transition: border-color 0.22s ease;
  }

  .ss-testimonial:hover {
    border-color: rgba(23, 138, 246, 0.4);
  }

  .ss-testimonial__video {
    position: relative;
    width: 100%;
    /* These three testimonials are natively 9:16 (verified against Wistia's
       media API: 1080x1920, 1080x1920, 720x1280 — all aspectRatio 0.5625).
       A 16/9 box around portrait footage cropped the speakers' heads off.
       Matches ApplyTestimonials.astro, which renders the same three videos. */
    aspect-ratio: 9 / 16;
    border-radius: 12px;
    overflow: hidden;
    background: #000;
    border: 1px solid var(--vsl-card-border);
  }

  .ss-testimonial__video iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .ss-testimonial h3 {
    margin: 16px 0 2px;
    font-size: 18px;
    font-weight: 700;
    letter-spacing: -0.015em;
    color: var(--vsl-ink);
  }

  .ss-testimonial__role {
    margin: 0 0 12px;
    font-size: 13px;
    font-weight: 600;
    color: var(--vsl-p);
  }

  .ss-testimonial__quote {
    margin: 0;
    font-size: 14.5px;
    line-height: 1.6;
    color: rgba(244, 241, 250, 0.8);
  }

  /* ---------- before / after ---------- */
  .ss-compare__list {
    max-width: 1000px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .ss-compare__row {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
  }

  .ss-compare__card {
    margin: 0;
    background: var(--vsl-card);
    border: 1px solid var(--vsl-card-border);
    border-radius: 16px;
    overflow: hidden;
  }

  .ss-compare__bar {
    padding: 10px 16px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-align: center;
  }

  .ss-compare__bar--before {
    background: rgba(244, 241, 250, 0.07);
    color: var(--vsl-ink-dim);
  }

  .ss-compare__bar--after {
    background: linear-gradient(160deg, var(--vsl-p-light), #8331e8 55%, var(--vsl-p-deep));
    color: #fff;
  }

  .ss-compare__card img {
    display: block;
    width: 100%;
    height: auto;
  }

  /* ---------- proof wall ---------- */
  .ss-wall__grid {
    max-width: 1100px;
    margin: 0 auto;
    columns: 3;
    column-gap: 16px;
  }

  .ss-wall__tile {
    margin: 0 0 16px;
    break-inside: avoid;
    background: var(--vsl-card);
    border: 1px solid var(--vsl-card-border);
    border-radius: 14px;
    overflow: hidden;
    transition: border-color 0.22s ease;
  }

  .ss-wall__tile:hover {
    border-color: rgba(23, 138, 246, 0.4);
  }

  .ss-wall__tile img {
    display: block;
    width: 100%;
    height: auto;
  }

  /* ---------- cta ---------- */
  .ss-cta {
    width: 100%;
    padding: 0 20px 96px;
    text-align: center;
    background: var(--vsl-black);
  }

  .ss-cta h2 {
    font-size: clamp(26px, 4vw, 38px);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.16;
    color: var(--vsl-ink);
    margin: 0 0 14px;
  }

  .ss-cta p {
    font-size: 16px;
    line-height: 1.6;
    color: var(--vsl-ink-dim);
    max-width: 52ch;
    margin: 0 auto 32px;
  }

  /* ---------- responsive ---------- */
  @media (max-width: 900px) {
    .ss-testimonials__grid {
      grid-template-columns: 1fr;
      gap: 18px;
    }
    .ss-wall__grid {
      columns: 2;
    }
  }

  @media (max-width: 600px) {
    .ss-hero {
      padding: 40px 18px 4px;
    }
    .ss-hero__brand {
      margin-bottom: 28px;
    }
    .ss-hero__brand img {
      width: 150px;
      height: auto;
    }
    .ss-hero__title {
      font-size: clamp(28px, 8.6vw, 36px);
      margin-bottom: 22px;
    }
    .ss-hero__sub {
      font-size: 15.5px;
    }
    .ss-section {
      padding: 40px 14px 52px;
    }
    .ss-head {
      margin-bottom: 32px;
    }
    .ss-head h2 {
      font-size: clamp(22px, 6.5vw, 28px);
    }
    .ss-head p {
      font-size: 14.5px;
    }
    .ss-reel-block {
      padding: 18px;
      border-radius: 14px;
    }
    .ss-reel-block__stats {
      gap: 20px;
      margin: 16px 0 18px;
    }
    .ss-reel-block__videos {
      gap: 10px;
    }
    .ss-reel__views {
      font-size: 12px;
    }
    .ss-compare__row {
      gap: 10px;
    }
    .ss-wall__grid {
      columns: 1;
    }
    .ss-cta {
      padding: 0 14px 64px;
    }
  }
</style>

<style is:global>
  /* Colours only: the /doctors-who-teach look over the unchanged layout. */
  body.vsl.rs {
    --vsl-black: #ffffff;
    --vsl-card: #ffffff;
    --vsl-card-border: #e5e8ee;
    --vsl-border: #e5e8ee;
    --vsl-ink: #0a0a1a;
    --vsl-ink-dim: #5b6478;
    --vsl-ink-faint: #7b869a;
    --vsl-p-light: #8cc4fb;
    --vsl-p: #178af6;
    --vsl-p-deep: #0070e0;
    --vsl-shadow-md: 0 10px 30px rgba(10, 14, 31, 0.07), 0 2px 6px rgba(10, 14, 31, 0.04);
    --vsl-font: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    --vsl-accent-grad: linear-gradient(180deg, #178af6, #0070e0);
    --vsl-accent-grad-soft: linear-gradient(180deg, #178af6, #0070e0);
    background: #fff radial-gradient(1100px 520px at 50% 0, rgba(23, 138, 246, 0.1), rgba(255, 255, 255, 0)) no-repeat;
  }
  body.rs .vslrr__story, body.rs .ss-testimonial__quote { color: #3d4557; }
  body.rs .vslrr__card { transition: border-color 0.2s ease, box-shadow 0.2s ease; }
  body.rs .vslrr__card:hover { background: #fff; border-color: rgba(23, 138, 246, 0.4); box-shadow: 0 14px 36px rgba(10, 14, 31, 0.09); }
  body.rs .ss-compare__bar--before { background: #3d4557 !important; color: #fff !important; }
  body.rs .vslrr__card, body.rs .ss-testimonial, body.rs .ss-compare__card, body.rs .ss-wall__tile, body.rs .ss-reel-block { box-shadow: 0 10px 30px rgba(10, 14, 31, 0.06); }
  body.rs .vslbtn { background: #d6339a !important; color: #fff !important; box-shadow: 0 10px 26px rgba(214, 51, 154, 0.45) !important; }
  body.rs .ss-compare__bar--after { background: linear-gradient(135deg, #1e9bff, #0a5fd6) !important; color: #fff !important; }
  body.rs .vslrr__disclaimer { color: #7b869a !important; }
  body.rs .vslbtn:hover { background: #b52a82 !important; }
</style>
