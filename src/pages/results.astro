---
/* ===========================================================================
   /results: the success stories page people ask for after a call.

   Same sections, in the same order, as /success-stories (owner, 29 Oct 2026):
   testimonials, before and after, more proof, case studies, the content
   that did it, then the call button. What changed: the look of
   /doctors-who-teach (white and blue, Inter, navy results band, pink call
   button), the copy in Kasper's first person, and these additions:
     - Dr. Lily Baker in every proof section (numbers as on /doctors-who-teach)
     - Jessica Winterstern's three newest videos, and Chelsey's three videos

   Every number is one the site already shows. Chelsey has no growth numbers
   here on purpose: none could be checked.
=========================================================================== */
import Layout from "../layouts/Layout.astro";
import VslBookingModal from "../components/VslBookingModal.astro";
import CaseStudyVideo from "../components/CaseStudyVideo.astro";
import PlatformIcon from "../components/PlatformIcon.astro";
import { allVslCaseStudies } from "../data/vslCaseStudies.js";
import { caseStudies } from "../data/caseStudies.js";
import { testimonials } from "../data/testimonials.js";

const imageBase = "/images/audience-skyrocket/";

const lilyTestimonial = {
  name: "Dr. Lily Baker",
  role: "Chiropractor, @theopenposturedoc",
  quote: "90,000 new followers, and her membership grew from 490 to 856 members in six weeks.",
  wistia: "t7vak3h3m9",
};

const comparisons = [
  { key: "danny", label: "Danny Morel", before: "danny-before-feed.webp", after: "danny-after-feed.webp" },
  { key: "baya", label: "Baya Voce", before: "baya-before.webp", after: "baya-after.webp" },
  { key: "lucas", label: "Lucas Salame", before: "lucas-before.webp", after: "lucas-after.webp" },
  { key: "oliver", label: "Oliver Nino", before: "oliver-before.webp", after: "oliver-after.webp" },
];

const proofTiles = [
  { src: "/images/apply4/lily-baker-insights.webp", alt: "Dr. Lily Baker's Instagram insights, Jul 8 to Sep 27: 10,651,859 views, +60,944 net followers" },
  { src: `${imageBase}danny-morel-podcast-millions.webp`, alt: "Podcast clips with millions of views" },
  { src: `${imageBase}danny-morel-2025-growth.webp`, alt: "Danny Morel thirty day Instagram growth analytics" },
  { src: `${imageBase}danny-podcast-chart.webp`, alt: "Apple Podcasts chart showing Danny Morel at number one" },
  { src: `${imageBase}danny-morel-tiktok.webp`, alt: "Danny Morel TikTok profile at one million followers" },
  { src: `${imageBase}jessica-growth-chart.webp`, alt: "Jessica Winterstern follower growth chart" },
  { src: `${imageBase}amber-rae-bestseller.webp`, alt: "USA Today bestselling booklist proof for Amber Rae" },
  { src: `${imageBase}jessica-client-message.webp`, alt: "Client message praising new content" },
  { src: `${imageBase}sabrina-client-message.webp`, alt: "Client message praising edits and music" },
  { src: `${imageBase}organic-30-day-follower-growth.webp`, alt: "Analytics showing 78,749 followers and 105 percent growth over thirty days" },
  { src: `${imageBase}open-posture-doc-profile.webp`, alt: "The Open Posture Doc TikTok profile with 93,100 followers" },
  { src: `${imageBase}open-posture-doc-follower-growth.webp`, alt: "The Open Posture Doc follower growth over five days" },
];

const lilyCard = {
  name: "Dr. Lily Baker | Chiropractor",
  stat: "+90,000 Followers",
  tag: "490 To 856 Members In Six Weeks",
  story:
    "Lily is a chiropractor who sells a membership. My team and I took over her short videos. She gained 90,000 followers in under 90 days, 17,000 of them from one reel, and her membership grew from 490 to 856 members in six weeks.",
  wistia: "t7vak3h3m9",
  poster: "/images/doctors-videos/lily-baker.jpg",
};
const cards = [lilyCard, ...allVslCaseStudies];

// The content blocks. Jessica's newest three videos replace her older ones
// here; Chelsey is new. Neither new set has checked view counts, so none show.
const newVideos = (who: string) =>
  [1, 2, 3].map((n) => ({ mp4: `/videos/results/${who}-${n}.mp4`, mp4Poster: `/images/results/${who}-${n}.jpg` }));
const reelBlocks = [
  ...caseStudies.map((cs) => (cs.name === "Jessica Winterstern" ? { ...cs, videos: newVideos("jessica") } : cs)),
  {
    name: "Chelsey Scaffidi",
    credit: "Matrescence educator and author",
    period: "",
    platforms: ["Instagram"],
    stats: [],
    videos: newVideos("chelsey"),
  },
];

const cta = "Let's get on a call";
---

<Layout
  title="Results | Synchro Social"
  description="Every result my team and I have built: 1.2 billion views generated and 8 million followers grown, with the testimonials and the receipts behind them."
  bodyClass="rs-body"
  metaEvent={{ name: "ViewContent", params: { content_name: "results" } }}
  lightFonts
  tabIcon="/images/logo-tab.png"
>
  <div class="rs">
    <div class="brand"><a href="/"><img src="/images/apply4/logo-dark.png" alt="Synchro Social" width="170" height="36" /></a></div>

    <header class="hero wrap">
      <p class="kicker">Results</p>
      <h1>Every result we've built,<br /><span class="hl">in one place.</span></h1>
      <p class="sub">
        My team and I have generated 1.2 billion views and grown 8 million followers for experts who teach.
        Here are the stories, the testimonials and the receipts behind them.
      </p>
    </header>

    <!-- 1. TESTIMONIALS -->
    <section class="sec wrap">
      <p class="kicker">In their own words</p>
      <h2>What my clients say</h2>
      <p class="lead">Unscripted, on camera, from people who have run the whole process with me.</p>
      <div class="tgrid">
        <article class="tcard">
          <div class="tvid">
            <iframe src={`https://fast.wistia.net/embed/iframe/${lilyTestimonial.wistia}?seo=false&videoFoam=true`} title="Dr. Lily Baker testimonial" allow="autoplay; fullscreen" allowfullscreen loading="lazy"></iframe>
          </div>
          <h3>{lilyTestimonial.name}</h3>
          <p class="role">{lilyTestimonial.role}</p>
          <p class="quote">{lilyTestimonial.quote}</p>
        </article>
        {testimonials.map((t) => (
          <article class="tcard">
            <div class="tvid">
              <iframe src={`https://fast.wistia.net/embed/iframe/${t.wistia}?seo=false&videoFoam=true`} title={`${t.name} testimonial`} allow="autoplay; fullscreen" allowfullscreen loading="lazy"></iframe>
            </div>
            <h3>{t.name}</h3>
            <p class="role">{t.shortRole ?? t.role}</p>
            <p class="quote">{t.title}</p>
          </article>
        ))}
      </div>
    </section>

    <!-- 2 and 3. BEFORE AND AFTER, MORE PROOF: one navy band, like the results on /doctors-who-teach -->
    <div class="band">
      <section class="sec wrap">
        <p class="kicker">Before and after</p>
        <h2>Watch the audience skyrocket</h2>
        <p class="lead">The same accounts, before my team started and after the system had been running.</p>
        <figure class="lily-ba">
          <img src="/images/apply4/lily-baker-before-after.webp" alt="Dr. Lily Baker's Instagram profile in May 2026 (63.9K followers) and September 2026 (151K followers)" loading="lazy" decoding="async" />
          <figcaption>Dr. Lily Baker, May to September 2026: <b>90,000 new followers</b></figcaption>
        </figure>
        <div class="ba">
          {comparisons.map((row) => (
            <div class="ba-row">
              <figure><figcaption>Before</figcaption><img src={`${imageBase}${row.before}`} alt={`${row.label} account before growth`} loading="lazy" decoding="async" /></figure>
              <figure><figcaption class="after">After</figcaption><img src={`${imageBase}${row.after}`} alt={`${row.label} account after growth`} loading="lazy" decoding="async" /></figure>
            </div>
          ))}
        </div>
      </section>

      <section class="sec wrap">
        <p class="kicker">Receipts</p>
        <h2>More proof behind the growth</h2>
        <p class="lead">Analytics, charts, chart placements and the messages that came with them.</p>
        <div class="wall">
          {proofTiles.map((t) => (
            <figure><img src={t.src} alt={t.alt} loading="lazy" decoding="async" /></figure>
          ))}
        </div>
      </section>
    </div>

    <!-- 4. CASE STUDIES -->
    <section class="sec wrap">
      <p class="kicker">Case studies</p>
      <h2>Just some of my case studies</h2>
      <p class="lead">Ten clients, ten different starting points. Each one tells the story in their own words.</p>
      <div class="cases">
        {cards.map((c) => (
          <article class="case">
            <h3>{c.name}</h3>
            <div class="stat">{c.stat}</div>
            {c.tag && <div class="tag">{c.tag}</div>}
            <p>{c.story}</p>
            {c.wistia && (
              <button type="button" class="facade" data-player-src={`https://fast.wistia.net/embed/iframe/${c.wistia}?seo=false&videoFoam=false&autoPlay=true`} aria-label={`Play ${c.name} case study video`}>
                <img src={c.poster} alt="" loading="lazy" width="640" height="360" />
                <span class="play" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M7 5v14l12-7z" /></svg></span>
              </button>
            )}
          </article>
        ))}
      </div>
      <p class="disclaimer">These are outcomes from clients who followed our process as built. Growth depends on execution and platform algorithms, and results will vary.</p>
    </section>

    <!-- 5. THE CONTENT THAT DID IT -->
    <section class="sec wrap">
      <p class="kicker">Best performing videos</p>
      <h2>The content that did it</h2>
      <p class="lead">The videos my team and I made, and what each account generated overall.</p>
      <div class="reels">
        {reelBlocks.map((cs) => (
          <article class="reel-block">
            <div class="rb-head">
              <div>
                <h3>{cs.name}</h3>
                <p class="credit">{cs.credit}{cs.period && <> &middot; {cs.period}</>}</p>
              </div>
              <div class="platforms" aria-label="Platforms">
                {cs.platforms.map((p) => <PlatformIcon name={p} class="h-5 w-5" />)}
              </div>
            </div>
            {cs.stats.length > 0 && (
              <div class="rb-stats">
                {cs.stats.map((s) => (
                  <div><b>{s.value}</b><span>{s.label}</span></div>
                ))}
              </div>
            )}
            <div class="rb-videos">
              {cs.videos.map((v: any) => (
                <div>
                  <CaseStudyVideo wistia={v.wistia} poster={v.poster} mp4={v.mp4} mp4Poster={v.mp4Poster} title={`${cs.name} video`} rounded />
                  {v.views && <div class="views">{v.views} views</div>}
                </div>
              ))}
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- CALL -->
    <section class="sec final wrap">
      <h2>Want this for <span class="hl">your brand?</span></h2>
      <p class="lead">Let's talk, and I'll tell you honestly whether my process fits what you're building.</p>
      <button type="button" class="btn" data-vsl-book>{cta}</button>
    </section>
  </div>

  <VslBookingModal />
</Layout>

<script>
  document.querySelectorAll<HTMLButtonElement>(".rs .facade").forEach((el) => {
    el.addEventListener("click", () => {
      const src = el.dataset.playerSrc;
      if (!src || el.classList.contains("on")) return;
      const f = document.createElement("iframe");
      f.src = src;
      f.title = el.getAttribute("aria-label") || "Case study video";
      f.allow = "autoplay; fullscreen; picture-in-picture";
      f.setAttribute("allowfullscreen", "");
      el.appendChild(f);
      el.classList.add("on");
    });
  });
</script>

<style is:global>
  /* The look of /doctors-who-teach: white and blue, Inter, navy band, pink call button. */
  body.rs-body {
    margin: 0;
    background-color: #fff;
    background-image: radial-gradient(1100px 520px at 50% 0, rgba(23, 138, 246, 0.1), rgba(255, 255, 255, 0));
    background-repeat: no-repeat;
    /* booking popup colours, light to match */
    --vsl-card: #fff; --vsl-card-border: #e5e8ee; --vsl-border: #e5e8ee; --vsl-ink: #0a0a1a;
    --vsl-p: #d6339a; --vsl-radius: 4px; --vsl-shadow-md: 0 20px 60px rgba(10, 14, 31, 0.25);
  }
  .rs {
    color-scheme: light;
    --ink: #0a0a1a;
    --ink-2: #3d4557;
    --ink-dim: #5b6478;
    --line: #e5e8ee;
    --p: #178af6;
    --p-light: #8cc4fb;
    --p-deep: #0070e0;
    --navy: #0a2a52;
    --pink: #d6339a;
    --r: 3px;
    color: var(--ink);
    font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    font-size: 16px;
    line-height: 1.6;
    letter-spacing: -0.011em;
    text-align: center;
    -webkit-font-smoothing: antialiased;
  }
  .rs * { box-sizing: border-box; }
  .rs .wrap { max-width: 1040px; margin: 0 auto; padding-inline: 20px; }
  .rs .brand { padding-top: 28px; display: flex; justify-content: center; }
  .rs .brand img { width: 170px; height: auto; display: block; }
  .rs h1, .rs h2, .rs h3 { margin: 0; text-wrap: balance; font-weight: 700; }
  .rs h1 { font-size: clamp(34px, 6vw, 64px); line-height: 1.05; letter-spacing: -0.03em; }
  .rs h2 { font-size: clamp(26px, 4vw, 38px); line-height: 1.15; letter-spacing: -0.02em; }
  .rs h3 { font-size: 18px; letter-spacing: -0.01em; }
  .rs .hl { color: var(--p); text-decoration: underline 3px rgba(23, 138, 246, 0.35); text-underline-offset: 6px; }
  .rs .kicker { font-size: 12px; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: var(--p); margin: 0 0 16px; }
  .rs .sub { font-size: 18px; color: var(--ink-2); max-width: 640px; margin: 24px auto 0; text-wrap: pretty; }
  .rs .lead { font-size: 17px; color: var(--ink-dim); max-width: 600px; margin: 14px auto 0; text-wrap: pretty; }
  .rs .hero { padding-block: 56px 16px; }
  .rs .sec { padding-block: 72px; }
  @media (max-width: 720px) { .rs .sec { padding-block: 52px; } .rs .hero { padding-top: 40px; } }

  /* testimonials */
  .rs .tgrid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 40px 28px; margin-top: 40px; text-align: left; }
  .rs .tvid { position: relative; aspect-ratio: 16 / 9; background: #0a0a1a; border-radius: var(--r); overflow: hidden; box-shadow: 0 10px 30px rgba(10, 14, 31, 0.1); }
  .rs .tvid iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .rs .tcard h3 { margin-top: 16px; }
  .rs .tcard .role { margin: 2px 0 0; font-size: 14px; color: var(--p-deep); font-weight: 600; }
  .rs .tcard .quote { margin: 8px 0 0; color: var(--ink-2); }
  @media (max-width: 720px) { .rs .tgrid { grid-template-columns: 1fr; } }

  /* navy band */
  .rs .band { background: var(--navy); color: #fff; }
  .rs .band .kicker { color: var(--p-light); }
  .rs .band .lead { color: rgba(255, 255, 255, 0.75); }
  .rs .band .sec + .sec { padding-top: 0; }
  .rs .band img { display: block; width: 100%; height: auto; border-radius: var(--r); background: #fff; box-shadow: 0 14px 40px rgba(0, 0, 0, 0.4); }
  .rs .band figure { margin: 0; }
  .rs .lily-ba { max-width: 860px; margin: 40px auto 0; }
  .rs .lily-ba figcaption { margin-top: 14px; font-size: 15px; color: rgba(255, 255, 255, 0.8); }
  .rs .lily-ba b { color: #fff; }
  .rs .ba { display: grid; gap: 28px; margin-top: 40px; }
  .rs .ba-row { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
  .rs .ba figcaption { font-size: 12px; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: rgba(255, 255, 255, 0.6); margin-bottom: 10px; }
  .rs .ba figcaption.after { color: var(--p-light); }
  .rs .wall { columns: 3 260px; column-gap: 20px; margin-top: 40px; }
  .rs .wall figure { break-inside: avoid; margin-bottom: 20px; }
  @media (max-width: 560px) { .rs .ba-row { gap: 10px; } }

  /* case studies */
  .rs .cases { display: grid; grid-template-columns: 1fr 1fr; gap: 56px 32px; margin-top: 44px; text-align: left; }
  .rs .case .stat { margin-top: 10px; font-size: clamp(24px, 2.6vw, 28px); font-weight: 700; letter-spacing: -0.02em; color: var(--p); }
  .rs .case .tag { font-size: 13px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink-dim); margin-top: 2px; }
  .rs .case p { margin: 12px 0 18px; color: var(--ink-2); font-size: 15px; }
  .rs .facade { position: relative; display: block; width: 100%; aspect-ratio: 16 / 9; padding: 0; border: 0; border-radius: var(--r); overflow: hidden; background: #0a0a1a; cursor: pointer; box-shadow: 0 10px 30px rgba(10, 14, 31, 0.1); }
  .rs .facade img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.4s cubic-bezier(0.23, 1, 0.32, 1); }
  .rs .facade iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .rs .play { position: absolute; left: 50%; top: 50%; width: 62px; height: 62px; margin: -31px 0 0 -31px; border-radius: 50%; background: #fff; display: grid; place-items: center; box-shadow: 0 8px 22px rgba(0, 0, 0, 0.3); transition: transform 0.2s cubic-bezier(0.23, 1, 0.32, 1); }
  .rs .play svg { width: 24px; height: 24px; fill: var(--ink); margin-left: 3px; }
  @media (hover: hover) { .rs .facade:hover img { transform: scale(1.02); } .rs .facade:hover .play { transform: scale(1.06); } }
  .rs .facade:active .play { transform: scale(0.96); }
  .rs .facade.on .play, .rs .facade.on img { display: none; }
  .rs .disclaimer { max-width: 640px; margin: 44px auto 0; font-size: 13px; color: var(--ink-dim); }
  @media (max-width: 860px) { .rs .cases { grid-template-columns: 1fr; } }

  /* the content that did it */
  .rs .reels { display: grid; gap: 64px; margin-top: 44px; text-align: left; }
  .rs .rb-head { display: flex; justify-content: space-between; align-items: flex-end; gap: 16px; padding-bottom: 14px; border-bottom: 1px solid var(--line); }
  .rs .rb-head h3 { font-size: 22px; }
  .rs .credit { margin: 2px 0 0; font-size: 14px; color: var(--ink-dim); }
  .rs .platforms { display: flex; gap: 10px; color: var(--ink-dim); }
  .rs .rb-stats { display: flex; gap: 40px; margin-top: 18px; }
  .rs .rb-stats b { display: block; font-size: clamp(28px, 4vw, 40px); line-height: 1; letter-spacing: -0.03em; color: var(--p); }
  .rs .rb-stats span { display: block; margin-top: 6px; font-size: 14px; color: var(--ink-dim); }
  .rs .rb-videos { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-top: 22px; }
  .rs .views { margin-top: 8px; font-size: 14px; font-weight: 600; color: var(--ink-2); text-align: center; }
  @media (max-width: 640px) { .rs .rb-videos { grid-template-columns: repeat(3, 72%); overflow-x: auto; scroll-snap-type: x mandatory; padding-bottom: 6px; } .rs .rb-videos > div { scroll-snap-align: start; } }

  /* call */
  .rs .final { padding-bottom: 96px; }
  .rs .btn { margin-top: 32px; display: inline-block; background: var(--pink); color: #fff; font: inherit; font-weight: 600; font-size: 16px; letter-spacing: 0.08em; text-transform: uppercase; padding: 22px 44px; border: 0; border-radius: var(--r); cursor: pointer; box-shadow: 0 10px 26px rgba(214, 51, 154, 0.45); transition: background-color 0.2s ease, transform 0.16s cubic-bezier(0.23, 1, 0.32, 1); touch-action: manipulation; }
  .rs .btn:hover { background: #b52a82; }
  .rs .btn:active { transform: scale(0.97); }
  .rs .btn:focus-visible { outline: 3px solid var(--pink); outline-offset: 3px; }
  @media (max-width: 560px) { .rs .btn { font-size: 15px; padding: 20px 28px; } }
</style>
